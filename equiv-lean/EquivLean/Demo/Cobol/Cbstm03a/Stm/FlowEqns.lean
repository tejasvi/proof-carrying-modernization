/-
# Control flow by recorded rewrites

`runFrom_succ` and `execSentences_cons` in `cobol_eval` are `rfl` lemmas, and the paragraph lookup
`match some para with …` is reduced by `simp` definitionally.  Neither leaves a proof step, so the
kernel re-checks those unfoldings when it composes the proof: it unfolds both sides of the gap and
evaluates the paragraph body on the symbolic state.  With a `COMP-5` item in the body that
evaluation reaches `fitBin`'s range test `v < 2 ^ 32`, which the kernel reduces through `Nat.sub`
in unary ("deep recursion").

`stm_flow` replaces these steps by rewrites that `simp` records:
* `X.runFrom_k` (generated by `stm_runFrom_eqns X`): a run from paragraph `k` with fuel `n + 1`
  is the `match` on its body's result, the lookup already done (instance of `runFrom_succ_of`,
  whose definitional step is checked once, for a variable paragraph);
* `execSentences_cons'`, `execSentences_nil'`, `runFrom_zero'` (`EvalP.lean`).
Use: `cobol_sym [stm_flow, …]` (the `↓` lemmas apply before the `rfl` ones).
-/
import EquivLean.Demo.Cobol.Cbstm03a.Stm.StmAttr
import EquivLean.Demo.Cobol.Cbstm03a.Stm.EvalP

namespace Cobol.Stm

theorem runFrom_succ_of (P : Program) (env : Env) (st : State) (n k : Nat) (para : Paragraph)
    (h : P.paras[k]? = some para) :
    Sem.runFrom P env (n + 1) k st =
      match Sem.execSentences P env (Sem.runFrom P env n) n para.body st with
      | (.normal, st1) | (.exitPara, st1) => Sem.endOfPara (Sem.runFrom P env n) st1.slots k st1
      | (.exitSection, st1) =>
        Sem.endOfPara (Sem.runFrom P env n) st1.slots (P.sectionEnd k) st1
      | (.goto l, st1) => Sem.runFrom P env n l st1
      | (.exitPerform, st1) | (.exitCycle, st1) | (.nextSentence, st1) =>
        (.fault (.unsupported "EXIT PERFORM outside an inline PERFORM"), st1)
      | r => r := by
  rw [runFrom_succ, h]; rfl

theorem Program.run_eq' (P : Program) (env : Env) (fuel : Nat) (st : State) :
    Program.run P env fuel st =
      match Sem.runFrom P env fuel 0 st with
      | (.ret _, st') => (.fault (.unsupported "return into an abandoned PERFORM"), st')
      | r => r :=
  Eq.trans (Eq.refl _) (Eq.refl _)

theorem endOfPara_eq' (rec : Nat → State → Sem.Res) (slots : List (ExitPt × Nat)) (k : Nat)
    (st : State) :
    Sem.endOfPara rec slots k st =
      match slots.lookup (.para k) with
      | some s => (.ret s, st)
      | none =>
        match slots.lookup (.sect k) with
        | some s => (.ret s, st)
        | none => rec (k + 1) st :=
  Eq.trans (Eq.refl _) (Eq.refl _)

theorem performOnce_eq' (rec : Nat → State → Sem.Res) (st : State) (id first : Nat)
    (exit : ExitPt) :
    Sem.performOnce rec id first exit st =
      if st.active.contains id then (.fault (.unsupported "recursive PERFORM"), st) else
      match rec first { st with slots := Sem.setAssoc st.slots exit (some id),
                                saves := Sem.setAssoc st.saves id (st.slots.lookup exit),
                                active := id :: st.active } with
      | (.ret s, st2) =>
        if s = id then
          (.normal, { st2 with slots := Sem.setAssoc st2.slots exit (st2.saves.lookup id),
                               active := st.active })
        else (.ret s, { st2 with active := st.active })
      | (sig, st2) => (sig, { st2 with active := st.active }) :=
  Eq.trans (performOnce_eq (rec := rec) (st := st) (id := id) (first := first) (exit := exit))
    (Eq.refl _)

theorem loopTimes_succ' (st : State) (body : State → Sem.Res) (k : Nat) :
    Sem.loopTimes body (k + 1) st =
      match body st with
      | (.normal, st1) | (.exitCycle, st1) => Sem.loopTimes body k st1
      | (.exitPerform, st1) => (.normal, st1)
      | r => r :=
  Eq.trans (loopTimes_succ (st := st) (body := body) (k := k)) (Eq.refl _)

attribute [stm_flow ↓] execSentences_cons' execSentences_nil' runFrom_zero' Program.run_eq'
  endOfPara_eq' performOnce_eq' loopTimes_succ'

open Lean Meta Elab Command in
/-- `stm_runFrom_eqns X`: for each paragraph lemma `X.paras_k : X.paras[k]? = some p` of the
program `X`, the lemma `X.runFrom_k : Sem.runFrom X env (n + 1) k st = match … p.body …`, a `↓`
lemma of `stm_flow`. -/
elab "stm_runFrom_eqns " x:ident : command => liftTermElabM do
  let X ← realizeGlobalConstNoOverloadWithInfo x
  let some ext ← getSimpExtension? `stm_flow | throwError "stm_flow simp set missing"
  let mut k := 0
  repeat
    let pk := X ++ Name.mkSimple s!"paras_{k}"
    unless (← getEnv).contains pk do break
    let ty ← inferType (mkConst pk)
    let some (_, _, rhs) := ty.eq? | throwError "{pk}: not an equation"
    let pf ← withLocalDeclD `env (mkConst ``Env) fun e =>
      withLocalDeclD `st (mkConst ``State) fun s =>
      withLocalDeclD `n (mkConst ``Nat) fun n => do
        let body ← mkAppM ``runFrom_succ_of #[mkConst X, e, s, n, mkNatLit k, rhs.appArg!, mkConst pk]
        mkLambdaFVars #[e, s, n] body
    let nm := X ++ Name.mkSimple s!"runFrom_{k}"
    addDecl <| .thmDecl { name := nm, levelParams := [], type := ← inferType pf, value := pf }
    addSimpTheorem ext nm (post := true) (inv := false) .global (prio := eval_prio default)
    k := k + 1
  logInfo m!"stm_runFrom_eqns {X}: {k} paragraphs"

simproc_decl unrollRunFromStm (Sem.runFrom _ _ _ _ _) := fun e => do
  let_expr Sem.runFrom P env fuel k st := e | return .continue
  let .const pn _ := P | return .continue
  let some f ← Lean.Meta.getNatValue? fuel | return .continue
  if f == 0 then return .continue
  let some kv ← Lean.Meta.getNatValue? k | return .continue
  let nm := pn ++ Lean.Name.mkSimple s!"runFrom_{kv}"
  unless (← Lean.getEnv).contains nm do return .continue
  let pf := Lean.mkApp3 (Lean.mkConst nm) env st (Lean.mkNatLit (f - 1))
  let some (_, _, rhs) := (← Lean.Meta.inferType pf).eq? | return .continue
  let pf ← Lean.Meta.mkExpectedTypeHint pf (← Lean.Meta.mkEq e rhs)
  return .visit { expr := rhs, proof? := some pf }

attribute [stm_flow ↓] unrollRunFromStm

end Cobol.Stm
