import EquivLean.Bridge.Cir.Tactic
import EquivLean.Bridge.Cir.Corr
import EquivLean.Bridge.Aeneas.Behaves
import EquivLean.Core.Facts
import EquivLean.Demo.Gen.Cir.XPoint
import EquivLean.Demo.Gen.Aeneas.Point.Funs

/-!
# C → Rust migration with structs: `manhattan`

`examples/xlang/point.c` (clang -fclangir + cir2lean → `Gen.XPoint`) against
`examples/rust/point` (Charon + Aeneas → `EquivLean.Demo.Gen.Aeneas.Point`):

```c
struct Point { int x; int y; };                pub struct Point { pub x: i32, pub y: i32 }
int manhattan(const struct Point *p) {          pub fn manhattan(p: &Point) -> i32 {
  int ax = p->x < 0 ? -p->x : p->x;                 let ax = if p.x < 0 { -p.x } else { p.x };
  int ay = p->y < 0 ? -p->y : p->y;                 let ay = if p.y < 0 { -p.y } else { p.y };
  return ax + ay;                                   ax + ay
}                                               }
```

Representation: the C object is a block of the caller's memory holding the aggregate
`.agg [.int x, .int y]` (cirlean keeps classes structured, not as bytes); the Rust value is
the Lean structure `point.Point` generated by Aeneas.  The precondition `hp` couples them
field by field.

* `manhattan_rust_sim_c`: the Rust rewrite simulates the C function (the migration
  direction: C is the source).  Wherever C has no undefined behaviour, Rust does not panic and
  returns the same `int`.  The C function runs in a hypothesis (`cir_hrun`, from the Cir
  bridge): its paths become case splits, and the paths with signed overflow close
  themselves; the Rust function runs in the goal with the Aeneas bridge's exact `wp` lemmas
  (panics are outcomes, so they must be refuted from the C path conditions, which
  `scalar_tac` does).
* `manhattan_equiv`: conditional equivalence.  Off `Bad` (the inputs on which C overflows,
  `-INT_MIN` or a sum beyond `INT_MAX`), both are safe and equal.  On `Bad` the programs
  differ observably (C: undefined behaviour; Rust: a panic), which is exactly what a
  migration review needs to see.

Standard axioms only.
-/

open EquivLean CIR Aeneas Aeneas.Std

namespace EquivLean.Demo.XLang.Point

/-- The value of an `i32` built from an in-range integer is that integer. -/
@[simp] theorem ofIntCore_val_i32 (x : Int)
    (h : -2 ^ (IScalarTy.I32.numBits - 1) ≤ x ∧ x < 2 ^ (IScalarTy.I32.numBits - 1)) :
    (IScalar.ofIntCore x h : I32).val = x := by
  have hn : IScalarTy.I32.numBits = 32 := rfl
  have hbv : (IScalar.ofIntCore x h : I32).bv = BitVec.ofInt 32 x := by
    apply BitVec.eq_of_toNat_eq
    simp only [IScalar.ofIntCore, BitVec.toNat_ofInt]
    rfl
  show (IScalar.ofIntCore x h : I32).bv.toInt = x
  rw [hbv]
  rw [hn] at h
  exact BitVec.toInt_ofInt_eq_self (by decide) h.1 h.2

/-- Rust's outcome against C's: the same returned `int`; Rust does not panic. -/
def RetI32 : Except Error I32 → Exit × Mem → Prop
  | .ok r, (.ret (some (.int v)), _) => r.val = v
  | _, _ => False

set_option maxHeartbeats 1000000 in
theorem manhattan_rust_sim_c (p : point.Point) (m : Mem) (bp : Nat) (k : BlockKind)
    (hbp : bp < m.next)
    (hp : m.blocks bp = some ⟨k, true, .record "Point", .agg [.int p.x.val, .int p.y.val]⟩) :
    Sim RetI32 (point.manhattan p)
      (evalCall Gen.XPoint.ctx Gen.XPoint.fn_manhattan.sym [.ptr (.loc bp [])] m) := by
  -- the fields' `int` ranges: the C loads of `p->x`, `p->y` pass their type check (otherwise
  -- cirlean reads them through the unsigned counterpart)
  have hpx : -2147483648 ≤ p.x.val ∧ p.x.val ≤ 2147483647 := by
    have := p.x.hBounds; simp only [IScalarTy.I32_numBits_eq] at this; omega
  have hpy : -2147483648 ≤ p.y.val ∧ p.y.val ≤ 2147483647 := by
    have := p.y.hBounds; simp only [IScalarTy.I32_numBits_eq] at this; omega
  rw [Cir.sim_res_iff_holds]
  intro os hs
  cir_hrun hs
  all_goals (subst hs; simp [point.manhattan])
  all_goals (split_ifs <;> simp [RetI32] <;> scalar_tac)

/-- Inputs on which the C function has undefined behaviour (signed overflow of `-p->x`,
`-p->y` or of the sum); the Rust function panics on exactly those. -/
def Bad (p : point.Point) : Prop :=
  p.x.val = -2147483648 ∨ p.y.val = -2147483648 ∨ 2147483647 < |p.x.val| + |p.y.val|

set_option maxHeartbeats 1000000 in
/-- Off `Bad`, the C function is safe. -/
theorem manhattan_c_safe (p : point.Point) (m : Mem) (bp : Nat) (k : BlockKind)
    (hbp : bp < m.next)
    (hp : m.blocks bp = some ⟨k, true, .record "Point", .agg [.int p.x.val, .int p.y.val]⟩)
    (hgood : ¬ Bad p) :
    Safe (evalCall Gen.XPoint.ctx Gen.XPoint.fn_manhattan.sym [.ptr (.loc bp [])] m) := by
  have hx := p.x.hmin; have hx' := p.x.hmax; have hy := p.y.hmin; have hy' := p.y.hmax
  have hpx : -2147483648 ≤ p.x.val ∧ p.x.val ≤ 2147483647 := by
    have := p.x.hBounds; simp only [IScalarTy.I32_numBits_eq] at this; omega
  have hpy : -2147483648 ≤ p.y.val ∧ p.y.val ≤ 2147483647 := by
    have := p.y.hBounds; simp only [IScalarTy.I32_numBits_eq] at this; omega
  simp only [Bad, not_or] at hgood
  rw [Cir.safe_res_iff_holds]
  show Calls Gen.XPoint.ctx Gen.XPoint.fn_manhattan.sym [.ptr (.loc bp [])] m (fun _ _ => True)
  cir_start
  cir_vcg
  all_goals (simp only [abs] at hgood; omega)

/-- **C → Rust, conditional equivalence.**  On every point where the C code has no undefined
behaviour, the Rust rewrite is equivalent: both are safe and return the same `int`. -/
theorem manhattan_equiv (p : point.Point) (m : Mem) (bp : Nat) (k : BlockKind)
    (hbp : bp < m.next)
    (hp : m.blocks bp = some ⟨k, true, .record "Point", .agg [.int p.x.val, .int p.y.val]⟩)
    (hgood : ¬ Bad p) :
    Equiv RetI32 (point.manhattan p)
      (evalCall Gen.XPoint.ctx Gen.XPoint.fn_manhattan.sym [.ptr (.loc bp [])] m) :=
  Equiv.of_sim_of_safe (manhattan_rust_sim_c p m bp k hbp hp)
    (fun _ => manhattan_c_safe p m bp k hbp hp hgood)

end EquivLean.Demo.XLang.Point
