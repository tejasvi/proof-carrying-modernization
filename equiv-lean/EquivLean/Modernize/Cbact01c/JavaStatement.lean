/-- The entry point `Cbact01c.run`. -/
abbrev runRef : MethodRef := Gen.Cbact01c.«run(Cbact01c$AccountRecord[])».ref

/-- Input file ACCTFILE-FILE: a Java array of `Cbact01c$AccountRecord` objects holding the records (a JVM
array has fewer than 2^31 elements). -/
def AcctfileFileAt (σ : Jimple.State) (a : Addr) (vals : List (List EquivLean.Cobol.Rec.FVal)) : Prop :=
  ∃ et xs, σ.heap a = some (.array et xs) ∧ xs.length < 2147483648 ∧
    Forall2 (JRecAt AccountRecord "Cbact01c$AccountRecord" σ) xs vals

/-- The outcome relation: the Java `Result` holds the COBOL DISPLAY lines (CP037 text), the
records written / rewritten per file (each decoding to the Java object's field values), and
`abended` = 1 exactly when the COBOL run ends with `CALL 'CEE3ABD'`. -/
def Rel (ot : Out) (os : Signal × Cobol.State) : Prop :=
  ∃ σ' res fs l k xs mods, ot = .normal (some (.ref res)) σ' ∧
    σ'.heap res = some (.plain "Cbact01c$Result" fs) ∧
    Fields.get fs ("Cbact01c$Result", "displays") = some (.ref l) ∧ σ'.heap l = some (.list k xs mods) ∧
    Forall2 (JLineAt σ') xs (displays os.2) ∧
    (∃ lw kw ws mw, Fields.get fs ("Cbact01c$Result", "outFileWrites") = some (.ref lw) ∧
      σ'.heap lw = some (.list kw ws mw) ∧
      Forall2 (fun x rec => ∃ vals, JRecAt OutAcctRec "Cbact01c$OutAcctRec" σ' x vals ∧
        OutAcctRec.decode rec = some vals) ws (writes 2 os.2)) ∧
    (∃ lw kw ws mw, Fields.get fs ("Cbact01c$Result", "arryFileWrites") = some (.ref lw) ∧
      σ'.heap lw = some (.list kw ws mw) ∧
      Forall2 (fun x rec => ∃ vals, JRecOccAt ArrArrayRec "Cbact01c$ArrArrayRec" σ' x vals ∧
        ArrArrayRec.decode rec = some vals) ws (writes 3 os.2)) ∧
    (∃ lw kw ws mw, Fields.get fs ("Cbact01c$Result", "vbrcFileWrites") = some (.ref lw) ∧
      σ'.heap lw = some (.list kw ws mw) ∧
      Forall2 (JLineAt σ') ws (writes 4 os.2)) ∧
    Fields.get fs ("Cbact01c$Result", "abended") = some (.int (if abended os.1 then 1 else 0))

/-- **CBACT01C → Java, every input**: the statement. -/
def Statement : Prop :=
  ∀ (vals1 : List (List EquivLean.Cobol.Rec.FVal)),
    (∀ v ∈ vals1, AccountRecord.Valid v) →
    vals1.length < 2 ^ 27 →
    ∀ n : Nat, vals1.length < n →
    ∀ (σ : Jimple.State) (a1 : Addr),
    AcctfileFileAt σ a1 vals1 →
    σ.initOf "Cbact01c" = .done →
    σ.initOf "Cbact01c$Result" = .done →
    σ.initOf "Cbact01c$AccountRecord" = .done →
    σ.initOf "Cbact01c$ArrArrayRec" = .done →
    σ.initOf "Cbact01c$OutAcctRec" = .done →
    Sim Rel (Call.mk Gen.prog runRef [.ref a1] σ)
      (EquivLean.Cobol.run CardDemo.Cbact01c { call := Cobol.Ext.cardDemoCalls CardDemo.Cbact01c.cfg } (n + 40)
        (CardDemo.Cbact01c.initState initMem [(1, vals1.map AccountRecord.encode)]))

end EquivLean.Modernize.Cbact01c.Java
