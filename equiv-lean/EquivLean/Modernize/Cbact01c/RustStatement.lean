import EquivLean.Bridge.Cobol.Behaves
import EquivLean.Bridge.Aeneas.Behaves
import EquivLean.Bridge.Aeneas.CobolRec
import EquivLean.Demo.Cobol.Cbact01c.Prog
import EquivLean.Demo.Gen.Aeneas.ModCbact01c.Funs

/-!
# CBACT01C → Rust: the generated statement

Generated by `tools/modernize/genstmt.py` from veriforch's `mapping.json`, coblean's IR and the
harness's initial storage; do not edit.  The record schemas come from coblean's layout of the IR
(`cobol_schema`); the COBOL run is coblean's semantics of the unmodified program, with the fuel
form of coblean's theorem `cbact01c_extracts`.
-/

open Cobol EquivLean.Cobol.Rec
open Aeneas Aeneas.Std

namespace EquivLean.Modernize.Cbact01c.Rust

cobol_schema AccountRecord from "../../../examples/cobol/carddemo/cbact01c.ir.json" record "ACCOUNT-RECORD"
theorem accountRecord_contig : AccountRecord.Contig := by decide
rust_record_vals AccountRecord.vals : cbact01c.AccountRecord from "../../../examples/cobol/carddemo/cbact01c.ir.json" record "ACCOUNT-RECORD"
cobol_schema OutAcctRec from "../../../examples/cobol/carddemo/cbact01c.ir.json" record "OUT-ACCT-REC"
theorem outAcctRec_contig : OutAcctRec.Contig := by decide
rust_record_vals OutAcctRec.vals : cbact01c.OutAcctRec from "../../../examples/cobol/carddemo/cbact01c.ir.json" record "OUT-ACCT-REC"
cobol_schema ArrArrayRec from "../../../examples/cobol/carddemo/cbact01c.ir.json" record "ARR-ARRAY-REC"
theorem arrArrayRec_contig : ArrArrayRec.Contig := by decide
rust_record_vals ArrArrayRec.vals : cbact01c.ArrArrayRec from "../../../examples/cobol/carddemo/cbact01c.ir.json" record "ARR-ARRAY-REC"

cobol_mem_hex initMem from "init_mem.hex"
set_option maxRecDepth 10000 in
theorem initMem_size : initMem.size = Program.memSize CardDemo.Cbact01c := by
  rw [CardDemo.Cbact01c.memSize_eq]; rfl

/-- Input file ACCTFILE-FILE: a Rust slice of `AccountRecord` structs holding the records. -/
def AcctfileFileOf (s : Slice cbact01c.AccountRecord) (vals : List (List EquivLean.Cobol.Rec.FVal)) : Prop :=
  s.val.map AccountRecord.vals = vals

/-- The outcome relation: `Output.displays` holds the Latin-1 bytes of the CP037 text of the COBOL
DISPLAY lines; the records written / rewritten per file decode to the structs' field values;
`Output.abended` is true exactly when the COBOL run ends with `CALL 'CEE3ABD'`. -/
def Rel (o : Except Error cbact01c.Output) (os : Signal × Cobol.State) : Prop :=
  ∃ out, o = .ok out ∧
    out.displays.val.map (fun l => l.val.map (·.val)) = (displays os.2).map rustLine ∧
    (writes 2 os.2).map OutAcctRec.decode = out.out_file_writes.val.map (fun x => some (OutAcctRec.vals x)) ∧
    (writes 3 os.2).map ArrArrayRec.decode = out.arry_file_writes.val.map (fun x => some (ArrArrayRec.vals x)) ∧
    (writes 4 os.2).map rustLine = out.vbrc_file_writes.val.map (fun l => l.val.map (·.val)) ∧
    out.abended = abended os.1

/-- **CBACT01C → Rust, every input**: the statement. -/
def Statement : Prop :=
  ∀ (vals1 : List (List EquivLean.Cobol.Rec.FVal)),
    (∀ v ∈ vals1, AccountRecord.Valid v) →
    vals1.length < 2 ^ 28 →
    ∀ n : Nat, vals1.length < n →
    ∀ (s1 : Slice cbact01c.AccountRecord),
    AcctfileFileOf s1 vals1 →
    Equiv Rel (cbact01c.run s1)
      (EquivLean.Cobol.run CardDemo.Cbact01c { call := Cobol.Ext.cardDemoCalls CardDemo.Cbact01c.cfg } (n + 40)
        (CardDemo.Cbact01c.initState initMem [(1, vals1.map AccountRecord.encode)]))

end EquivLean.Modernize.Cbact01c.Rust
