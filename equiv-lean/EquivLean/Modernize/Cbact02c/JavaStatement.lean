/-!
# CBACT02C → Java: the generated statement

Generated by `tools/modernize/genstmt.py` from veriforch's `mapping.json`, coblean's IR and the
harness's initial storage; do not edit.  The record schemas come from coblean's layout of the IR
(`cobol_schema`); the COBOL run is coblean's semantics of the unmodified program, with the fuel
form of coblean's theorem `cbact02c_lists`.
-/

open Cobol EquivLean.Cobol.Rec
open Jimple EquivLean.Jimple

namespace EquivLean.Modernize.Cbact02c.Java

cobol_schema CardRecord from "../../../examples/cobol/carddemo/cbact02c.ir.json" record "CARD-RECORD"
theorem cardRecord_contig : CardRecord.Contig := by decide

cobol_mem_hex initMem from "init_mem.hex"
set_option maxRecDepth 10000 in
theorem initMem_size : initMem.size = Program.memSize CardDemo.Cbact02c := by
  rw [CardDemo.Cbact02c.memSize_eq]; rfl

/-- The entry point `Cbact02c.run`. -/
abbrev runRef : MethodRef := Gen.Cbact02c.«run(Cbact02c$CardRecord[])».ref

/-- Input file CARDFILE-FILE: a Java array of `Cbact02c$CardRecord` objects holding the records (a JVM
array has fewer than 2^31 elements). -/
def CardfileFileAt (σ : Jimple.State) (a : Addr) (vals : List (List EquivLean.Cobol.Rec.FVal)) : Prop :=
  ∃ et xs, σ.heap a = some (.array et xs) ∧ xs.length < 2147483648 ∧
    Forall2 (JRecAt CardRecord "Cbact02c$CardRecord" σ) xs vals

/-- The outcome relation: `Result.displays` holds the COBOL DISPLAY lines (CP037 text), in order;
`Result.abended` is 1 exactly when the COBOL run ends with `CALL 'CEE3ABD'`. -/
def Rel (ot : Out) (os : Signal × Cobol.State) : Prop :=
  ∃ σ' res fs l k xs mods, ot = .normal (some (.ref res)) σ' ∧
    σ'.heap res = some (.plain "Cbact02c$Result" fs) ∧
    Fields.get fs ("Cbact02c$Result", "displays") = some (.ref l) ∧ σ'.heap l = some (.list k xs mods) ∧
    Forall2 (JLineAt σ') xs (displays os.2) ∧
    Fields.get fs ("Cbact02c$Result", "abended") = some (.int (if abended os.1 then 1 else 0))

/-- **CBACT02C → Java, every input**: the statement. -/
def Statement : Prop :=
  ∀ (vals1 : List (List EquivLean.Cobol.Rec.FVal)),
    (∀ v ∈ vals1, CardRecord.Valid v) →
    vals1.length < 2 ^ 27 →
    ∀ n : Nat, vals1.length < n →
    ∀ (σ : Jimple.State) (a1 : Addr),
    CardfileFileAt σ a1 vals1 →
    σ.initOf "Cbact02c" = .done →
    σ.initOf "Cbact02c$Result" = .done →
    σ.initOf "Cbact02c$CardRecord" = .done →
    Sim Rel (Call.mk Gen.prog runRef [.ref a1] σ)
      (EquivLean.Cobol.run CardDemo.Cbact02c {} (n + 20)
        (CardDemo.Cbact02c.initState initMem [(1, vals1.map CardRecord.encode)]))

end EquivLean.Modernize.Cbact02c.Java
