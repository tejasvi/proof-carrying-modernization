import EquivLean.Bridge.Cobol.Behaves
import EquivLean.Bridge.Aeneas.Behaves
import EquivLean.Bridge.Aeneas.CobolRec
import EquivLean.Demo.Cobol.Cbact02c.Prog
import EquivLean.Demo.Gen.Aeneas.ModCbact02c.Funs

/-!
# CBACT02C → Rust: the generated statement

Generated by `tools/modernize/genstmt.py` from veriforch's `mapping.json`, coblean's IR and the
harness's initial storage; do not edit.  The record schemas come from coblean's layout of the IR
(`cobol_schema`); the COBOL run is coblean's semantics of the unmodified program, with the fuel
form of coblean's theorem `cbact02c_lists`.
-/

open Cobol EquivLean.Cobol.Rec
open Aeneas Aeneas.Std

namespace EquivLean.Modernize.Cbact02c.Rust

cobol_schema CardRecord from "../../../examples/cobol/carddemo/cbact02c.ir.json" record "CARD-RECORD"
theorem cardRecord_contig : CardRecord.Contig := by decide
rust_record_vals CardRecord.vals : cbact02c.CardRecord from "../../../examples/cobol/carddemo/cbact02c.ir.json" record "CARD-RECORD"

cobol_mem_hex initMem from "init_mem.hex"
set_option maxRecDepth 10000 in
theorem initMem_size : initMem.size = Program.memSize CardDemo.Cbact02c := by
  rw [CardDemo.Cbact02c.memSize_eq]; rfl

/-- Input file CARDFILE-FILE: a Rust slice of `CardRecord` structs holding the records. -/
def CardfileFileOf (s : Slice cbact02c.CardRecord) (vals : List (List EquivLean.Cobol.Rec.FVal)) : Prop :=
  s.val.map CardRecord.vals = vals

/-- The outcome relation: `Output.displays` holds the Latin-1 bytes of the CP037 text of the COBOL
DISPLAY lines, in order; `Output.abended` is true exactly when the COBOL run ends with
`CALL 'CEE3ABD'`. -/
def Rel (o : Except Error cbact02c.Output) (os : Signal × Cobol.State) : Prop :=
  ∃ out, o = .ok out ∧
    out.displays.val.map (fun l => l.val.map (·.val)) = (displays os.2).map rustLine ∧
    out.abended = abended os.1

/-- **CBACT02C → Rust, every input**: the statement. -/
def Statement : Prop :=
  ∀ (vals1 : List (List EquivLean.Cobol.Rec.FVal)),
    (∀ v ∈ vals1, CardRecord.Valid v) →
    vals1.length < 2 ^ 28 →
    ∀ n : Nat, vals1.length < n →
    ∀ (s1 : Slice cbact02c.CardRecord),
    CardfileFileOf s1 vals1 →
    Equiv Rel (cbact02c.run s1)
      (EquivLean.Cobol.run CardDemo.Cbact02c {} (n + 20)
        (CardDemo.Cbact02c.initState initMem [(1, vals1.map CardRecord.encode)]))

end EquivLean.Modernize.Cbact02c.Rust
