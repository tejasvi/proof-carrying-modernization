import EquivLean.Bridge.Cobol.Behaves
import EquivLean.Bridge.Aeneas.Behaves
import EquivLean.Bridge.Aeneas.CobolRec
import EquivLean.Demo.Cobol.Cbact03c.Prog
import EquivLean.Demo.Gen.Aeneas.ModCbact03c.Funs

/-!
# CBACT03C → Rust: the generated statement

Generated by `tools/modernize/genstmt.py` from veriforch's `mapping.json`, coblean's IR and the
harness's initial storage; do not edit.  The record schemas come from coblean's layout of the IR
(`cobol_schema`); the COBOL run is coblean's semantics of the unmodified program, with the fuel
form of coblean's theorem `cbact03c_lists`.
-/

open Cobol EquivLean.Cobol.Rec
open Aeneas Aeneas.Std

namespace EquivLean.Modernize.Cbact03c.Rust

cobol_schema CardXrefRecord from "../../../examples/cobol/carddemo/cbact03c.ir.json" record "CARD-XREF-RECORD"
theorem cardXrefRecord_contig : CardXrefRecord.Contig := by decide
rust_record_vals CardXrefRecord.vals : cbact03c.CardXrefRecord from "../../../examples/cobol/carddemo/cbact03c.ir.json" record "CARD-XREF-RECORD"

cobol_mem_hex initMem from "init_mem.hex"
set_option maxRecDepth 10000 in
theorem initMem_size : initMem.size = Program.memSize CardDemo.Cbact03c := by
  rw [CardDemo.Cbact03c.memSize_eq]; rfl

/-- Input file XREFFILE-FILE: a Rust slice of `CardXrefRecord` structs holding the records. -/
def XreffileFileOf (s : Slice cbact03c.CardXrefRecord) (vals : List (List EquivLean.Cobol.Rec.FVal)) : Prop :=
  s.val.map CardXrefRecord.vals = vals

/-- The outcome relation: `Output.displays` holds the Latin-1 bytes of the CP037 text of the COBOL
DISPLAY lines, in order; `Output.abended` is true exactly when the COBOL run ends with
`CALL 'CEE3ABD'`. -/
def Rel (o : Except Error cbact03c.Output) (os : Signal × Cobol.State) : Prop :=
  ∃ out, o = .ok out ∧
    out.displays.val.map (fun l => l.val.map (·.val)) = (displays os.2).map rustLine ∧
    out.abended = abended os.1

/-- **CBACT03C → Rust, every input**: the statement. -/
def Statement : Prop :=
  ∀ (vals1 : List (List EquivLean.Cobol.Rec.FVal)),
    (∀ v ∈ vals1, CardXrefRecord.Valid v) →
    vals1.length < 2 ^ 28 →
    ∀ n : Nat, vals1.length < n →
    ∀ (s1 : Slice cbact03c.CardXrefRecord),
    XreffileFileOf s1 vals1 →
    Equiv Rel (cbact03c.run s1)
      (EquivLean.Cobol.run CardDemo.Cbact03c {} (n + 20)
        (CardDemo.Cbact03c.initState initMem [(1, vals1.map CardXrefRecord.encode)]))

end EquivLean.Modernize.Cbact03c.Rust
