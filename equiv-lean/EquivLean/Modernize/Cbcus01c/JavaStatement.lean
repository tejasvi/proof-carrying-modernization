/-- The entry point `Cbcus01c.run`. -/
abbrev runRef : MethodRef := Gen.Cbcus01c.«run(Cbcus01c$CustomerRecord[])».ref

/-- Input file CUSTFILE-FILE: a Java array of `Cbcus01c$CustomerRecord` objects holding the records (a JVM
array has fewer than 2^31 elements). -/
def CustfileFileAt (σ : Jimple.State) (a : Addr) (vals : List (List EquivLean.Cobol.Rec.FVal)) : Prop :=
  ∃ et xs, σ.heap a = some (.array et xs) ∧ xs.length < 2147483648 ∧
    Forall2 (JRecAt CustomerRecord "Cbcus01c$CustomerRecord" σ) xs vals

/-- The outcome relation: `Result.displays` holds the COBOL DISPLAY lines (CP037 text), in order;
`Result.abended` is 1 exactly when the COBOL run ends with `CALL 'CEE3ABD'`. -/
def Rel (ot : Out) (os : Signal × Cobol.State) : Prop :=
  ∃ σ' res fs l k xs mods, ot = .normal (some (.ref res)) σ' ∧
    σ'.heap res = some (.plain "Cbcus01c$Result" fs) ∧
    Fields.get fs ("Cbcus01c$Result", "displays") = some (.ref l) ∧ σ'.heap l = some (.list k xs mods) ∧
    Forall2 (JLineAt σ') xs (displays os.2) ∧
    Fields.get fs ("Cbcus01c$Result", "abended") = some (.int (if abended os.1 then 1 else 0))

/-- **CBCUS01C → Java, every input**: the statement. -/
def Statement : Prop :=
  ∀ (vals1 : List (List EquivLean.Cobol.Rec.FVal)),
    (∀ v ∈ vals1, CustomerRecord.Valid v) →
    vals1.length < 2 ^ 27 →
    ∀ n : Nat, vals1.length < n →
    ∀ (σ : Jimple.State) (a1 : Addr),
    CustfileFileAt σ a1 vals1 →
    σ.initOf "Cbcus01c" = .done →
    σ.initOf "Cbcus01c$Result" = .done →
    σ.initOf "Cbcus01c$CustomerRecord" = .done →
    Sim Rel (Call.mk Gen.prog runRef [.ref a1] σ)
      (EquivLean.Cobol.run CardDemo.Cbcus01c {} (n + 20)
        (CardDemo.Cbcus01c.initState initMem [(1, vals1.map CustomerRecord.encode)]))

