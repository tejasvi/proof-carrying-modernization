open Cobol EquivLean.Cobol.Rec
open Jimple EquivLean.Jimple

namespace EquivLean.Modernize.Cbcus01c.Java

cobol_schema CustomerRecord from "../../../examples/cobol/carddemo/cbcus01c.ir.json" record "CUSTOMER-RECORD"
