import EquivLean.Bridge.Cobol.Behaves
import EquivLean.Bridge.Aeneas.Behaves
import EquivLean.Bridge.Aeneas.CobolRec
import EquivLean.Demo.Cobol.Cbcus01c.Prog
import EquivLean.Demo.Gen.Aeneas.ModCbcus01c.Funs

/-!
# CBCUS01C → Rust: the generated statement

Generated by `tools/modernize/genstmt.py` from veriforch's `mapping.json`, coblean's IR and the
harness's initial storage; do not edit.  The record schemas come from coblean's layout of the IR
(`cobol_schema`); the COBOL run is coblean's semantics of the unmodified program, with the fuel
form of coblean's theorem `cbcus01c_lists`.
-/

open Cobol EquivLean.Cobol.Rec
open Aeneas Aeneas.Std

namespace EquivLean.Modernize.Cbcus01c.Rust

cobol_schema CustomerRecord from "../../../examples/cobol/carddemo/cbcus01c.ir.json" record "CUSTOMER-RECORD"
theorem customerRecord_contig : CustomerRecord.Contig := by decide
rust_record_vals CustomerRecord.vals : cbcus01c.CustomerRecord from "../../../examples/cobol/carddemo/cbcus01c.ir.json" record "CUSTOMER-RECORD"

cobol_mem_hex initMem from "init_mem.hex"
set_option maxRecDepth 10000 in
theorem initMem_size : initMem.size = Program.memSize CardDemo.Cbcus01c := by
  rw [CardDemo.Cbcus01c.memSize_eq]; rfl

/-- Input file CUSTFILE-FILE: a Rust slice of `CustomerRecord` structs holding the records. -/
def CustfileFileOf (s : Slice cbcus01c.CustomerRecord) (vals : List (List EquivLean.Cobol.Rec.FVal)) : Prop :=
  s.val.map CustomerRecord.vals = vals

/-- The outcome relation: `Output.displays` holds the Latin-1 bytes of the CP037 text of the COBOL
DISPLAY lines, in order; `Output.abended` is true exactly when the COBOL run ends with
`CALL 'CEE3ABD'`. -/
def Rel (o : Except Error cbcus01c.Output) (os : Signal × Cobol.State) : Prop :=
  ∃ out, o = .ok out ∧
    out.displays.val.map (fun l => l.val.map (·.val)) = (displays os.2).map rustLine ∧
    out.abended = abended os.1

/-- **CBCUS01C → Rust, every input**: the statement. -/
def Statement : Prop :=
  ∀ (vals1 : List (List EquivLean.Cobol.Rec.FVal)),
    (∀ v ∈ vals1, CustomerRecord.Valid v) →
    vals1.length < 2 ^ 28 →
    ∀ n : Nat, vals1.length < n →
    ∀ (s1 : Slice cbcus01c.CustomerRecord),
    CustfileFileOf s1 vals1 →
    Equiv Rel (cbcus01c.run s1)
      (EquivLean.Cobol.run CardDemo.Cbcus01c {} (n + 20)
        (CardDemo.Cbcus01c.initState initMem [(1, vals1.map CustomerRecord.encode)]))

end EquivLean.Modernize.Cbcus01c.Rust
