/-- The outcome relation: `Output.displays` holds the Latin-1 bytes of the CP037 text of the COBOL
DISPLAY lines; the records written / rewritten per file decode to the structs' field values;
`Output.abended` is true exactly when the COBOL run ends with `CALL 'CEE3ABD'`. -/
def Rel (o : Except Error cbstm03a.Output) (os : Signal × Cobol.State) : Prop :=
  ∃ out, o = .ok out ∧
    out.displays.val.map (fun l => l.val.map (·.val)) = ((displays os.2).drop 11).map rustLine ∧
    (writes 1 os.2).map rustLine = out.stmt_file_writes.val.map (fun l => l.val.map (·.val)) ∧
    (writes 2 os.2).map rustLine = out.html_file_writes.val.map (fun l => l.val.map (·.val)) ∧
    out.abended = abended os.1

