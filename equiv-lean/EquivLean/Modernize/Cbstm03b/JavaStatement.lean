/-- File TRNX-FILE (file 1): the open flag, the records, the read position and the
end-of-file flag of coblean's file state; the records are a Java array of record objects (a JVM
array has fewer than 2^31 elements). -/
def TrnxFileAt (σ : Jimple.State) (x : Jimple.Value) (s : FileSt) : Prop :=
  ∃ o fs b l et xs, x = .ref o ∧ σ.heap o = some (.plain "Cbstm03b$TrnxFile" fs) ∧
    Fields.get fs ("Cbstm03b$TrnxFile", "open") = some (.ofBool b) ∧ s.mode = (if b then some .input else none) ∧
    Fields.get fs ("Cbstm03b$TrnxFile", "recs") = some (.ref l) ∧ σ.heap l = some (.array et xs) ∧
    xs.length < 2147483648 ∧
    Forall2 (fun x r => ∃ vals, JRecAt FdTrnxfileRec "Cbstm03b$FdTrnxfileRec" σ x vals ∧ FdTrnxfileRec.Valid vals ∧
      r = FdTrnxfileRec.encode vals) xs s.recs ∧
    s.pos < 2147483648 ∧ Fields.get fs ("Cbstm03b$TrnxFile", "pos") = some (.int (BitVec.ofNat 32 s.pos)) ∧
    Fields.get fs ("Cbstm03b$TrnxFile", "eof") = some (.ofBool s.eof)

