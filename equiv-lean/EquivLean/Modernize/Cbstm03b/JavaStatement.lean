/-- The record object `x` is not one of the record objects of the file object `y` (of class `k`). -/
def NotRecOf (σ : Jimple.State) (k : ClassName) (x y : Jimple.Value) : Prop :=
  ∀ o fs l et xs, y = .ref o → σ.heap o = some (.plain k fs) → Fields.get fs (k, "recs") = some (.ref l) →
    σ.heap l = some (.array et xs) → x ∉ xs

/-- The state the translation keeps between calls, against the callee's COBOL state: the files,
the FD record areas (field values at their storage offsets) and the FILE STATUS items.  The FD
record areas of the files read by key (CUST-FILE, ACCT-FILE) are not shared with the file's record
objects (a keyed READ first stores the key in the record area); the translation keeps this, since a
read stores a fresh copy. -/
def StateAt (σ : Jimple.State) (st : Addr) (cs : Cobol.State) : Prop :=
  ∃ fs, σ.heap st = some (.plain "Cbstm03b$State" fs) ∧
    (∃ x s, Fields.get fs ("Cbstm03b$State", "trnxFile") = some x ∧ cs.files.lookup 1 = some s ∧ TrnxFileAt σ x s) ∧
    (∃ x s, Fields.get fs ("Cbstm03b$State", "xrefFile") = some x ∧ cs.files.lookup 2 = some s ∧ XrefFileAt σ x s) ∧
    (∃ x s, Fields.get fs ("Cbstm03b$State", "custFile") = some x ∧ cs.files.lookup 3 = some s ∧ CustFileAt σ x s) ∧
    (∃ x s, Fields.get fs ("Cbstm03b$State", "acctFile") = some x ∧ cs.files.lookup 4 = some s ∧ AcctFileAt σ x s) ∧
    (∃ x vals, Fields.get fs ("Cbstm03b$State", "fdTrnxfileRec") = some x ∧ JRecAt FdTrnxfileRec "Cbstm03b$FdTrnxfileRec" σ x vals ∧
      FdTrnxfileRec.Valid vals ∧ FdTrnxfileRec.At cs.mem vals) ∧
    (∃ x vals, Fields.get fs ("Cbstm03b$State", "fdXreffileRec") = some x ∧ JRecAt FdXreffileRec "Cbstm03b$FdXreffileRec" σ x vals ∧
      FdXreffileRec.Valid vals ∧ FdXreffileRec.At cs.mem vals) ∧
    (∃ x vals, Fields.get fs ("Cbstm03b$State", "fdCustfileRec") = some x ∧ JRecAt FdCustfileRec "Cbstm03b$FdCustfileRec" σ x vals ∧
      FdCustfileRec.Valid vals ∧ FdCustfileRec.At cs.mem vals) ∧
    (∃ x vals, Fields.get fs ("Cbstm03b$State", "fdAcctfileRec") = some x ∧ JRecAt FdAcctfileRec "Cbstm03b$FdAcctfileRec" σ x vals ∧
      FdAcctfileRec.Valid vals ∧ FdAcctfileRec.At cs.mem vals) ∧
    (∃ x bs, Fields.get fs ("Cbstm03b$State", "trnxfileStatus") = some x ∧ JStrAt σ x (cp037Str bs) ∧ TrnxfileStatus.BytesAt cs.mem bs) ∧
    (∃ x bs, Fields.get fs ("Cbstm03b$State", "xreffileStatus") = some x ∧ JStrAt σ x (cp037Str bs) ∧ XreffileStatus.BytesAt cs.mem bs) ∧
    (∃ x bs, Fields.get fs ("Cbstm03b$State", "custfileStatus") = some x ∧ JStrAt σ x (cp037Str bs) ∧ CustfileStatus.BytesAt cs.mem bs) ∧
    (∃ x bs, Fields.get fs ("Cbstm03b$State", "acctfileStatus") = some x ∧ JStrAt σ x (cp037Str bs) ∧ AcctfileStatus.BytesAt cs.mem bs) ∧
    (∀ x y, Fields.get fs ("Cbstm03b$State", "fdCustfileRec") = some x → Fields.get fs ("Cbstm03b$State", "custFile") = some y →
      NotRecOf σ "Cbstm03b$CustFile" x y) ∧
    (∀ x y, Fields.get fs ("Cbstm03b$State", "fdAcctfileRec") = some x → Fields.get fs ("Cbstm03b$State", "acctFile") = some y →
      NotRecOf σ "Cbstm03b$AcctFile" x y)

/-- The parameter area LK-M03B-AREA: its field values at their storage offsets. -/
def LkM03bAreaAt (σ : Jimple.State) (p : Addr) (m : Mem) : Prop :=
  ∃ vals, JRecAt LkM03bArea "Cbstm03b$LkM03bArea" σ (.ref p) vals ∧ LkM03bArea.Valid vals ∧ LkM03bArea.At m vals

/-- The OPEN outcomes: element `i` is the status of a failed `OPEN INPUT` of file `i + 1`, or
null when the OPEN succeeds (`Env.openError`).  A failure is a FILE STATUS, which is
two decimal digits (IBM statuses are 00–99): every failure the environment reports is below 100. -/
def EnvAt (σ : Jimple.State) (oe : Addr) (env : Env) : Prop :=
  ∃ et xs, σ.heap oe = some (.array et xs) ∧ xs.length = 4 ∧ ∀ i, i < 4 →
    (xs.getD i .null = .null ∧ env.openError (i + 1) .input = none) ∨
    (∃ o c, xs.getD i .null = .ref o ∧ σ.heap o = some (.boxed "java.lang.Integer" (.int (BitVec.ofNat 32 c))) ∧
      c < 100 ∧ env.openError (i + 1) .input = some c)

/-- The outcome relation: the call returns normally, the COBOL run ends with GOBACK, and the state
object and the parameter areas hold the COBOL state at the end of the call. -/
def Rel (st q1 : Addr) (ot : Out) (os : Signal × Cobol.State) : Prop :=
  ∃ σ', ot = .normal none σ' ∧ os.1 = .stop .goback ∧ StateAt σ' st os.2 ∧ LkM03bAreaAt σ' q1 os.2.mem

open CardDemo.Cbstm03b in
/-- **CBSTM03B → Java, one call, every input**: the statement. -/
def Statement : Prop :=
  ∀ (env : Env)
    (m : Mem)
    (_ : m.size = 2248)
    (fs : Files)
    (k v : Int)
    (_ : ∀ r ∈ fs.trnx.recs, r.length = 350)
    (_ : ∀ r ∈ fs.xref.recs, r.length = 50)
    (_ : ∀ r ∈ fs.cust.recs, r.length = 500)
    (_ : ∀ r ∈ fs.acct.recs, r.length = 300)
    (_ : m.read 1216 1 = [opReadK] → (m.read 1208 8 = ddCust ∨ m.read 1208 8 = ddAcct) → decodeNum {} LK_M03B_KEY_LN.fmt (m.read 1244 4) = some k ∧ 1 ≤ k ∧ k ≤ 25)
    (_ : m.read 1216 1 = [opReadK] → m.read 1208 8 = ddAcct → decodeNum {} { digits := k.toNat } (m.read 1219 k.toNat) = some v)
    (_ : EquivLean.Modernize.Cbstm03b.Domain env m fs k v),
  ∀ (σ : Jimple.State) (oe st q1 : Addr),
    EnvAt σ oe env → StateAt σ st (st0 m fs) →
    LkM03bAreaAt σ q1 (st0 m fs).mem →
    σ.initOf "Cbstm03b" = .done →
    σ.initOf "Cbstm03b$State" = .done →
    σ.initOf "Cbstm03b$TrnxFile" = .done →
    σ.initOf "Cbstm03b$XrefFile" = .done →
    σ.initOf "Cbstm03b$CustFile" = .done →
    σ.initOf "Cbstm03b$AcctFile" = .done →
    σ.initOf "Cbstm03b$FdAcctfileRec" = .done →
    σ.initOf "Cbstm03b$FdCustfileRec" = .done →
    σ.initOf "Cbstm03b$FdTrnxfileRec" = .done →
    σ.initOf "Cbstm03b$FdXreffileRec" = .done →
    σ.initOf "Cbstm03b$LkM03bArea" = .done →
    Sim (Rel st q1) (Call.mk Gen.prog Gen.Cbstm03b.«call(java.lang.Integer[],Cbstm03b$State,Cbstm03b$LkM03bArea)».ref [.ref oe, .ref st, .ref q1] σ)
      (EquivLean.Cobol.run CardDemo.Cbstm03b env 50 (st0 m fs))

end EquivLean.Modernize.Cbstm03b.Java
