/-- File ACCT-FILE (file 4): the open flag, the records, the read position and the
end-of-file flag of coblean's file state. -/
def AcctFileRel (f : cbstm03b.AcctFile) (s : FileSt) : Prop :=
  s.mode = (if f.«open» then some .input else none) ∧
    (∀ r ∈ f.recs.val, FdAcctfileRec.Valid (FdAcctfileRec.vals r)) ∧
    s.recs = f.recs.val.map (fun r => FdAcctfileRec.encode (FdAcctfileRec.vals r)) ∧
    s.pos = f.pos.val ∧ s.eof = f.eof

/-- The state the translation keeps between calls, against the callee's COBOL state: the files,
the FD record areas (field values at their storage offsets) and the FILE STATUS items. -/
def StateRel (st : cbstm03b.State) (cs : Cobol.State) : Prop :=
  (∃ s, cs.files.lookup 1 = some s ∧ TrnxFileRel st.trnx_file s) ∧
    (∃ s, cs.files.lookup 2 = some s ∧ XrefFileRel st.xref_file s) ∧
    (∃ s, cs.files.lookup 3 = some s ∧ CustFileRel st.cust_file s) ∧
    (∃ s, cs.files.lookup 4 = some s ∧ AcctFileRel st.acct_file s) ∧
    FdTrnxfileRec.Valid (FdTrnxfileRec.vals st.fd_trnxfile_rec) ∧ FdTrnxfileRec.At cs.mem (FdTrnxfileRec.vals st.fd_trnxfile_rec) ∧
    FdXreffileRec.Valid (FdXreffileRec.vals st.fd_xreffile_rec) ∧ FdXreffileRec.At cs.mem (FdXreffileRec.vals st.fd_xreffile_rec) ∧
    FdCustfileRec.Valid (FdCustfileRec.vals st.fd_custfile_rec) ∧ FdCustfileRec.At cs.mem (FdCustfileRec.vals st.fd_custfile_rec) ∧
    FdAcctfileRec.Valid (FdAcctfileRec.vals st.fd_acctfile_rec) ∧ FdAcctfileRec.At cs.mem (FdAcctfileRec.vals st.fd_acctfile_rec) ∧
    TrnxfileStatus.BytesAt cs.mem (st.trnxfile_status.val.map (fun u => ebcdicOfLatin1 u.val)) ∧
    XreffileStatus.BytesAt cs.mem (st.xreffile_status.val.map (fun u => ebcdicOfLatin1 u.val)) ∧
    CustfileStatus.BytesAt cs.mem (st.custfile_status.val.map (fun u => ebcdicOfLatin1 u.val)) ∧
    AcctfileStatus.BytesAt cs.mem (st.acctfile_status.val.map (fun u => ebcdicOfLatin1 u.val))

/-- The parameter area LK-M03B-AREA: its field values at their storage offsets. -/
def LkM03bAreaRel (q : cbstm03b.LkM03bArea) (m : Mem) : Prop :=
  LkM03bArea.Valid (LkM03bArea.vals q) ∧ LkM03bArea.At m (LkM03bArea.vals q)

/-- The OPEN outcomes: element `i` is the status of a failed `OPEN INPUT` of file `i + 1`, or
`None` when the OPEN succeeds (`Env.openError`).  A failure is a FILE STATUS, which is
two decimal digits (IBM statuses are 00–99): every failure the environment reports is below 100. -/
def EnvRel (oe : Std.Array (Option Std.U8) 4#usize) (env : Env) : Prop :=
  ∀ i, i < 4 → (oe.val.getD i none).map (fun c => c.val) = env.openError (i + 1) .input ∧
    ∀ c, env.openError (i + 1) .input = some c → c < 100

/-- The outcome relation: the call returns (no panic) the new state and parameter areas, the COBOL
run ends with GOBACK, and the results are related as before the call. -/
def Rel (o : Except Error (cbstm03b.State × cbstm03b.LkM03bArea)) (os : Signal × Cobol.State) : Prop :=
  ∃ st q1, o = .ok (st, q1) ∧ os.1 = .stop .goback ∧ StateRel st os.2 ∧ LkM03bAreaRel q1 os.2.mem

open CardDemo.Cbstm03b in
/-- **CBSTM03B → Rust, one call, every input**: the statement. -/
def Statement : Prop :=
  ∀ (env : Env)
    (m : Mem)
    (_ : m.size = 2248)
    (fs : Files)
    (k v : Int)
    (_ : ∀ r ∈ fs.trnx.recs, r.length = 350)
    (_ : ∀ r ∈ fs.xref.recs, r.length = 50)
    (_ : ∀ r ∈ fs.cust.recs, r.length = 500)
    (_ : ∀ r ∈ fs.acct.recs, r.length = 300)
    (_ : m.read 1216 1 = [opReadK] → (m.read 1208 8 = ddCust ∨ m.read 1208 8 = ddAcct) → decodeNum {} LK_M03B_KEY_LN.fmt (m.read 1244 4) = some k ∧ 1 ≤ k ∧ k ≤ 25)
    (_ : m.read 1216 1 = [opReadK] → m.read 1208 8 = ddAcct → decodeNum {} { digits := k.toNat } (m.read 1219 k.toNat) = some v)
    (_ : EquivLean.Modernize.Cbstm03b.Domain env m fs k v),
  ∀ (oe : Std.Array (Option Std.U8) 4#usize) (st : cbstm03b.State) (q1 : cbstm03b.LkM03bArea),
    EnvRel oe env → StateRel st (st0 m fs) →
    LkM03bAreaRel q1 (st0 m fs).mem →
    Equiv Rel (cbstm03b.call oe st q1)
      (EquivLean.Cobol.run CardDemo.Cbstm03b env 50 (st0 m fs))

end EquivLean.Modernize.Cbstm03b.Rust
