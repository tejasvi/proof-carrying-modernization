/-- File TRNX-FILE (file 1): the open flag, the records, the read position and the
end-of-file flag of coblean's file state. -/
def TrnxFileRel (f : cbstm03b.TrnxFile) (s : FileSt) : Prop :=
  s.mode = (if f.«open» then some .input else none) ∧
    (∀ r ∈ f.recs.val, FdTrnxfileRec.Valid (FdTrnxfileRec.vals r)) ∧
    s.recs = f.recs.val.map (fun r => FdTrnxfileRec.encode (FdTrnxfileRec.vals r)) ∧
    s.pos = f.pos.val ∧ s.eof = f.eof

/-- File XREF-FILE (file 2): the open flag, the records, the read position and the
end-of-file flag of coblean's file state. -/
def XrefFileRel (f : cbstm03b.XrefFile) (s : FileSt) : Prop :=
  s.mode = (if f.«open» then some .input else none) ∧
    (∀ r ∈ f.recs.val, FdXreffileRec.Valid (FdXreffileRec.vals r)) ∧
    s.recs = f.recs.val.map (fun r => FdXreffileRec.encode (FdXreffileRec.vals r)) ∧
    s.pos = f.pos.val ∧ s.eof = f.eof

/-- File CUST-FILE (file 3): the open flag, the records, the read position and the
end-of-file flag of coblean's file state. -/
def CustFileRel (f : cbstm03b.CustFile) (s : FileSt) : Prop :=
  s.mode = (if f.«open» then some .input else none) ∧
    (∀ r ∈ f.recs.val, FdCustfileRec.Valid (FdCustfileRec.vals r)) ∧
    s.recs = f.recs.val.map (fun r => FdCustfileRec.encode (FdCustfileRec.vals r)) ∧
