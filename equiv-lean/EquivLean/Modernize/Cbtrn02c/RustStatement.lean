/-- The outcome relation: `Output.displays` holds the Latin-1 bytes of the CP037 text of the COBOL
DISPLAY lines; the records written / rewritten per file decode to the structs' field values;
`Output.abended` is true exactly when the COBOL run ends with `CALL 'CEE3ABD'`. -/
def Rel (o : Except Error cbtrn02c.Output) (os : Signal × Cobol.State) : Prop :=
  ∃ out, o = .ok out ∧
    out.displays.val.map (fun l => l.val.map (·.val)) = (displays os.2).map rustLine ∧
    (writes 2 os.2).map TranRecord.decode = out.transact_file_writes.val.map (fun x => some (TranRecord.vals x)) ∧
    (writes 4 os.2).map RejectRecord.decode = out.dalyrejs_file_writes.val.map (fun x => some (RejectRecord.vals x)) ∧
    (writes 6 os.2).map TranCatBalRecord.decode = out.tcatbal_file_writes.val.map (fun x => some (TranCatBalRecord.vals x)) ∧
    (rewrites 5 os.2).map AccountRecord.decode = out.account_file_rewrites.val.map (fun x => some (AccountRecord.vals x)) ∧
    (rewrites 6 os.2).map TranCatBalRecord.decode = out.tcatbal_file_rewrites.val.map (fun x => some (TranCatBalRecord.vals x)) ∧
    out.return_code.val = (itemValue CardDemo.Cbtrn02c.RETURN_CODE CardDemo.Cbtrn02c.RETURN_CODE.fmt os.2) ∧
    out.abended = abended os.1

/-- **CBTRN02C → Rust, every input**: the statement. -/
def Statement : Prop :=
  ∀ (vals1 : List (List EquivLean.Cobol.Rec.FVal)) (vals2 : List (List EquivLean.Cobol.Rec.FVal)) (vals3 : List (List EquivLean.Cobol.Rec.FVal)) (vals4 : List (List EquivLean.Cobol.Rec.FVal)),
    (∀ v ∈ vals1, DalytranRecord.Valid v) →
    (∀ v ∈ vals2, CardXrefRecord.Valid v) →
    (∀ v ∈ vals3, AccountRecord.Valid v) →
    (∀ v ∈ vals4, TranCatBalRecord.Valid v) →
    ∀ (clk : List UInt8), CurrentDate clk →
    EquivLean.Modernize.Cbtrn02c.Domain vals1 vals2 vals3 vals4 →
    vals1.length + vals2.length + vals3.length + vals4.length < 2 ^ 28 →
    ∀ n : Nat, vals1.length + vals2.length + vals3.length + vals4.length < n →
    ∀ (s1 : Slice cbtrn02c.DalytranRecord) (s2 : Slice cbtrn02c.CardXrefRecord) (s3 : Slice cbtrn02c.AccountRecord) (s4 : Slice cbtrn02c.TranCatBalRecord) (rclk : Std.Array Std.U8 21#usize),
    DalytranFileOf s1 vals1 →
    XrefFileOf s2 vals2 →
    AccountFileOf s3 vals3 →
    TcatbalFileOf s4 vals4 →
    rclk.val.map (·.val) = rustLine clk →
    Equiv Rel (cbtrn02c.run s1 s2 s3 s4 rclk)
      (EquivLean.Cobol.run CardDemo.Cbtrn02c { clock := fun _ => clk } (n + 60)
        (CardDemo.Cbtrn02c.initState initMem [(1, vals1.map DalytranRecord.encode), (3, vals2.map CardXrefRecord.encode), (5, vals3.map AccountRecord.encode), (6, vals4.map TranCatBalRecord.encode)]))

