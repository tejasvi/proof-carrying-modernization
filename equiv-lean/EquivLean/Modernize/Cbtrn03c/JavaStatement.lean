    Forall2 (JLineAt σ') xs (displays os.2) ∧
    (∃ lw kw ws mw, Fields.get fs ("Cbtrn03c$Result", "reportFileWrites") = some (.ref lw) ∧
      σ'.heap lw = some (.list kw ws mw) ∧
      Forall2 (fun x rec => ∃ vals, JRecAt FdReptfileRec "Cbtrn03c$FdReptfileRec" σ' x vals ∧
        FdReptfileRec.decode rec = some vals) ws (writes 5 os.2)) ∧
    Fields.get fs ("Cbtrn03c$Result", "abended") = some (.int (if abended os.1 then 1 else 0))

