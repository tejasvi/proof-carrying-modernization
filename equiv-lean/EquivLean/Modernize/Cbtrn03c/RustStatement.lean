    out.displays.val.map (fun l => l.val.map (·.val)) = (displays os.2).map rustLine ∧
    (writes 5 os.2).map FdReptfileRec.decode = out.report_file_writes.val.map (fun x => some (FdReptfileRec.vals x)) ∧
    out.abended = abended os.1

