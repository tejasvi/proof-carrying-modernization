{"charon_version":"0.1.293","translated":{"crate_name":"adler32_rs","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"adler32_rs","contents":"//! zlib 1.3.1's Adler-32 (`adler32.c`, tag commit 51b7f2a) in safe Rust.\n//!\n//! Written by equiv-lean's agents in an Aeneas-friendly form: no `unsafe`, `while` loops with no\n//! `return` inside, `u64` for `uLong`, `usize` for `z_size_t`, `u32` for `uInt`, `i64` for\n//! `z_off_t`/`z_off64_t` (x86_64 LP64), `Option<&[u8]>` for `buf` (`None` is `Z_NULL`).\n//! The default configuration (no `NO_DIVIDE`): `MOD`, `MOD28` and `MOD63` are `% BASE`.\n//! The unrolled `DO1`..`DO16` sums are the helper `do_bytes`, which adds the same bytes in the\n//! same order; the paths and the reductions (the single subtraction of `BASE` on the `len == 1`\n//! and `len < 16` paths, `% BASE` after each `NMAX` block and after the tail) are those of the C.\n\n/// Largest prime smaller than 65536.\npub const BASE: u64 = 65521;\n\n/// The largest n such that 255n(n+1)/2 + (n+1)(BASE-1) <= 2^32-1.\npub const NMAX: usize = 5552;\n\n/// `DO1` for `n` bytes: adds `buf[i]`, ..., `buf[i + n - 1]` to `adler` and each new `adler` to\n/// `sum2`; returns the two sums.\npub fn do_bytes(buf: &[u8], i: usize, n: usize, adler: u64, sum2: u64) -> (u64, u64) {\n    let mut a = adler;\n    let mut s = sum2;\n    let mut k = 0;\n    while k < n {\n        a += buf[i + k] as u64;\n        s += a;\n        k += 1;\n    }\n    (a, s)\n}\n\n/// `adler32_z(adler, buf, len)`.  With `buf == Z_NULL` and `len == 1` the C reads `buf[0]`\n/// (undefined behaviour); this translation returns 1 there.\npub fn adler32_z(adler: u64, buf: Option<&[u8]>, len: usize) -> u64 {\n    // split Adler-32 into component sums\n    let sum2 = (adler >> 16) & 0xffff;\n    let a = adler & 0xffff;\n    if len == 1 {\n        // in case user likes doing a byte at a time, keep it fast\n        match buf {\n            Some(b) => {\n                let mut a1 = a + b[0] as u64;\n                if a1 >= BASE {\n                    a1 -= BASE;\n                }\n                let mut s1 = sum2 + a1;\n                if s1 >= BASE {\n                    s1 -= BASE;\n                }\n                a1 | (s1 << 16)\n            }\n            None => 1,\n        }\n    } else {\n        match buf {\n            // initial Adler-32 value (deferred check for len == 1 speed)\n            None => 1,\n            Some(b) => {\n                if len < 16 {\n                    // in case short lengths are provided, keep it somewhat fast\n                    let (a1, s1) = do_bytes(b, 0, len, a, sum2);\n                    let mut a2 = a1;\n                    if a2 >= BASE {\n                        a2 -= BASE;\n                    }\n                    let s2 = s1 % BASE; // MOD28: only added so many BASE's\n                    a2 | (s2 << 16)\n                } else {\n                    let mut aa = a;\n                    let mut ss = sum2;\n                    let mut i = 0;\n                    let mut rest = len;\n                    // do length NMAX blocks -- requires just one modulo operation\n                    while rest >= NMAX {\n                        rest -= NMAX;\n                        let (a1, s1) = do_bytes(b, i, NMAX, aa, ss);\n                        i += NMAX;\n                        aa = a1 % BASE;\n                        ss = s1 % BASE;\n                    }\n                    // do remaining bytes (less than NMAX, still just one modulo)\n                    if rest != 0 {\n                        // avoid modulos if none remaining\n                        let (a1, s1) = do_bytes(b, i, rest, aa, ss);\n                        aa = a1 % BASE;\n                        ss = s1 % BASE;\n                    }\n                    // return recombined sums\n                    aa | (ss << 16)\n                }\n            }\n        }\n    }\n}\n\n/// `adler32(adler, buf, len)`: the `uInt` wrapper.\npub fn adler32(adler: u64, buf: Option<&[u8]>, len: u32) -> u64 {\n    adler32_z(adler, buf, len as usize)\n}\n\n/// `adler32_combine_(adler1, adler2, len2)`.\nfn adler32_combine_(adler1: u64, adler2: u64, len2: i64) -> u64 {\n    // for negative len, return invalid adler32 as a clue for debugging\n    if len2 < 0 {\n        0xffffffff\n    } else {\n        // the derivation of this formula is left as an exercise for the reader\n        let rem = (len2 % (BASE as i64)) as u32; // MOD63, then (unsigned)\n        let sum1 = adler1 & 0xffff;\n        let sum2 = (rem as u64 * sum1) % BASE; // MOD(sum2)\n        let mut sum1 = sum1 + (adler2 & 0xffff) + BASE - 1;\n        let mut sum2 = sum2 + ((adler1 >> 16) & 0xffff) + ((adler2 >> 16) & 0xffff) + BASE\n            - rem as u64;\n        if sum1 >= BASE {\n            sum1 -= BASE;\n        }\n        if sum1 >= BASE {\n            sum1 -= BASE;\n        }\n        if sum2 >= BASE << 1 {\n            sum2 -= BASE << 1;\n        }\n        if sum2 >= BASE {\n            sum2 -= BASE;\n        }\n        sum1 | (sum2 << 16)\n    }\n}\n\n/// `adler32_combine(adler1, adler2, len2)` (`z_off_t` is 64 bits on LP64).\npub fn adler32_combine(adler1: u64, adler2: u64, len2: i64) -> u64 {\n    adler32_combine_(adler1, adler2, len2)\n}\n\n/// `adler32_combine64(adler1, adler2, len2)`.\npub fn adler32_combine64(adler1: u64, adler2: u64, len2: i64) -> u64 {\n    adler32_combine_(adler1, adler2, len2)\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Value":[1,{"Array":[{"Value":[2,{"TypeVar":{"Bound":[0,0]}}]},{"Value":[0,[{"Var":{"Bound":[0,0]}},{"Deduplicated":0}]]},null]}]},"kind":"InherentImplBlock"}}},{"Ident":["as_slice",0]}]},{"key":{"Fun":1},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1},"kind":"Inhere