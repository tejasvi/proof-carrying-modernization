teger":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"bits","contents":"//! Bit-twiddling functions (Rust side of the TypeScript migration demos).\n\n/// FNV-1a, 32 bits, over a byte slice.\npub fn fnv1a32(data: &[u8]) -> u32 {\n    let mut h: u32 = 0x811c_9dc5;\n    let mut i: usize = 0;\n    while i < data.len() {\n        h ^= data[i] as u32;\n        h = h.wrapping_mul(0x0100_0193);\n        i += 1;\n    }\n    h\n}\n\n/// Number of set bits (Kernighan: clear the lowest set bit until zero).\npub fn popcount(x: u32) -> u32 {\n    let mut v = x;\n    let mut c: u32 = 0;\n    while v != 0 {\n        v &= v - 1;\n        c += 1;\n    }\n    c\n}\n\n/// Number of set bits, branch-free (SWAR).\npub fn popcount_swar(x: u32) -> u32 {\n    let mut v = x;\n    v = v - ((v >> 1u32) & 0x5555_5555);\n    v = (v & 0x3333_3333) + ((v >> 2u32) & 0x3333_3333);\n    v = (v + (v >> 4u32)) & 0x0f0f_0f0f;\n    v.wrapping_mul(0x0101_0101) >> 24u32\n}\n\n/// Reverse the 32 bits of a word.\npub fn reverse_bits(x: u32) -> u32 {\n    let mut v = x;\n    let mut r: u32 = 0;\n    let mut i: u32 = 0;\n    while i < 32 {\n        r = (r << 1u32) | (v & 1);\n        v >>= 1u32;\n        i += 1;\n    }\n    r\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/m