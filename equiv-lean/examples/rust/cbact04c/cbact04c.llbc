{"charon_version":"0.1.293","translated":{"crate_name":"cbact04c","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"cbact04c","contents":"//! Rust port of CardDemo's CBACT04C (monthly interest on category balances), for the COBOL → Rust\n//! proof against coblean's all-input theorem `cbact04c_all` (translated to Lean by Charon and\n//! Aeneas).\n//!\n//! The files of the COBOL program are arguments and results, as a data-access layer would\n//! provide them: the category-balance records in file order (TCATBAL), the account and\n//! disclosure-group records, looked up by key like the keyed READs (ACCTDAT, DISCGRP), and as\n//! results the rewritten accounts in REWRITE order and the number of interest transactions\n//! written (TRANSACT).  Amounts are in cents and rates in hundredths of a percent, as in the\n//! `PIC S9(n)V99` fields; the truncation of an ADD or COMPUTE into a smaller field is explicit\n//! (`S9(9)V99`: remainder modulo 10^11, `S9(10)V99`: modulo 10^12).  `/` and `%` on `i64`\n//! truncate toward zero, as COBOL does here; all arithmetic is checked (an overflow panics).\n//! The alphanumeric keys are integers: the group id (`PIC X(10)`) is the big-endian value of\n//! its ten EBCDIC bytes, the transaction type code (`PIC X(02)`) that of its two bytes.\n//!\n//! Like the COBOL program, the interest of the last account in the file is never posted: the\n//! `ELSE PERFORM 1050-UPDATE-ACCOUNT` branch of the main loop is dead (CardDemo issue #64).\n\n/// TRAN-CAT-BAL-RECORD.\npub struct Cat {\n    pub acct_id: i64,\n    pub type_cd: u16,\n    pub cat_cd: i32,\n    pub bal: i64,\n}\n\n/// ACCOUNT-RECORD: the fields the program reads or changes.  A keyed READ copies the record\n/// (`READ ACCOUNT-FILE INTO ACCOUNT-RECORD`).\n#[derive(Clone, Copy)]\npub struct Account {\n    pub id: i64,\n    pub bal: i64,\n    pub cyc_credit: i64,\n    pub cyc_debit: i64,\n    pub group_id: u128,\n}\n\n/// DIS-GROUP-RECORD.\npub struct Disc {\n    pub group_id: u128,\n    pub type_cd: u16,\n    pub cat_cd: i32,\n    pub rate: i64,\n}\n\n/// The group id `'DEFAULT'` (padded with spaces to ten EBCDIC bytes).\nconst DEFAULT_GROUP: u128 = 0xC4C5_C6C1_E4D3_E340_4040;\n\n/// 1100-GET-ACCT-DATA: the account record with this key (`None`: INVALID KEY).\nfn read_account(accounts: &[Account], id: i64) -> Option<Account> {\n    let mut i = 0;\n    while i < accounts.len() {\n        if accounts[i].id == id {\n            return Some(accounts[i]);\n        }\n        i += 1;\n    }\n    None\n}\n\n/// The rate of the disclosure-group record with this key (`None`: INVALID KEY).\nfn find_rate(discs: &[Disc], group_id: u128, type_cd: u16, cat_cd: i32) -> Option<i64> {\n    let mut i = 0;\n    while i < discs.len() {\n        let d = &discs[i];\n        if d.group_id == group_id && d.type_cd == type_cd && d.cat_cd == cat_cd {\n            return Some(d.rate);\n        }\n        i += 1;\n    }\n    None\n}\n\n/// 1200-GET-INTEREST-RATE, with 1200-A-GET-DEFAULT-INT-RATE when the key is not found.\nfn read_rate(discs: &[Disc], group_id: u128, type_cd: u16, cat_cd: i32) -> i64 {\n    match find_rate(discs, group_id, type_cd, cat_cd) {\n        Some(rate) => rate,\n        None => find_rate(discs, DEFAULT_GROUP, type_cd, cat_cd).expect(\"no disclosure group record\"),\n    }\n}\n\n/// 1050-UPDATE-ACCOUNT: post the interest, zero the cycle credit and debit.\nfn post(a: Account, total_int: i64) -> Account {\n    Account {\n        id: a.id,\n        bal: (a.bal + total_int) % 1_000_000_000_000,\n        cyc_credit: 0,\n        cyc_debit: 0,\n        group_id: a.group_id,\n    }\n}\n\n/// The main loop of the PROCEDURE DIVISION: the REWRITEs, in order, and the number of\n/// transactions written.\npub fn run(cats: &[Cat], accounts: &[Account], discs: &[Disc]) -> (Vec<Account>, u32) {\n    let mut rewrites = Vec::new();\n    let mut transactions: u32 = 0;\n    let mut first_time = true;\n    let mut last_acct: i64 = 0;\n    let mut total_int: i64 = 0;\n    let mut acct: Option<Account> = None;\n    let mut i = 0;\n    while i < cats.len() {\n        let c = &cats[i];\n        // WS-LAST-ACCT-NUM holds spaces until the first record: no account id equals it\n        if first_time || c.acct_id != last_acct {\n            if !first_time {\n                rewrites.push(post(acct.unwrap(), total_int));\n            } else {\n                first_time = false;\n            }\n            total_int = 0;\n            last_acct = c.acct_id;\n            acct = read_account(accounts, c.acct_id);\n        }\n        let a = acct.expect(\"account not found\");\n        let rate = read_rate(discs, a.group_id, c.type_cd, c.cat_cd);\n        if rate != 0 {\n            // 1300-COMPUTE-INTEREST and 1300-B-WRITE-TX\n            let monthly = c.bal * rate / 120_000 % 100_000_000_000;\n            total_int = (total_int + monthly) % 100_000_000_000;\n            transactions += 1;\n        }\n        i += 1;\n    }\n    (rewrites, transactions)\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"