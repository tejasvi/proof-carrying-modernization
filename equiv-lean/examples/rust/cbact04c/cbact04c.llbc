cct: Option<Account> = None;\n    let mut i = 0;\n    while i < cats.len() {\n        let c = &cats[i];\n        // WS-LAST-ACCT-NUM holds spaces until the first record: no account id equals it\n        if first_time || c.acct_id != last_acct {\n            if !first_time {\n                rewrites.push(post(acct.unwrap(), total_int));\n            } else {\n                first_time = false;\n            }\n            total_int = 0;\n            last_acct = c.acct_id;\n            acct = read_account(accounts, c.acct_id);\n        }\n        let a = acct.expect(\"account not found\");\n        let rate = read_rate(discs, a.group_id, c.type_cd, c.cat_cd);\n        if rate != 0 {\n            // 1300-COMPUTE-INTEREST and 1300-B-WRITE-TX\n            let monthly = c.bal * rate / 120_000 % 100_000_000_000;\n            total_int = (total_int + monthly) % 100_000_000_000;\n            transactions += 1;\n        }\n        i += 1;\n    }\n    (rewrites, transactions)\n}","attr_info":{"attributes":[{"DocComment":" The main loop of the PROCEDURE DIVISION: the REWRITEs, in order, and the number of"},{"DocComment":" transactions written."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[60,{"Ref":[{"Var":{"Free":0}},{"Value":[61,{"Slice":[{"Value":[62,{"Adt":{"id":5,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]},n