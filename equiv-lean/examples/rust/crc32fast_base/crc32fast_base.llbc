{"charon_version":"0.1.293","translated":{"crate_name":"crc32fast_base","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"crc32fast_base","contents":"//! crc32fast 1.4.2 (MIT OR Apache-2.0, LICENSE-MIT): `src/baseline.rs` (this file) and\n//! `src/table.rs`, unmodified except the module path of `CRC32_TABLE`; `State::combine` (another\n//! module) and the tests are left out.\npub mod table;\nuse crate::table::CRC32_TABLE;\n\n#[derive(Clone)]\npub struct State {\n    state: u32,\n}\n\nimpl State {\n    pub fn new(state: u32) -> Self {\n        State { state }\n    }\n\n    pub fn update(&mut self, buf: &[u8]) {\n        self.state = update_fast_16(self.state, buf);\n    }\n\n    pub fn finalize(self) -> u32 {\n        self.state\n    }\n\n    pub fn reset(&mut self) {\n        self.state = 0;\n    }\n\n}\n\npub(crate) fn update_fast_16(prev: u32, mut buf: &[u8]) -> u32 {\n    const UNROLL: usize = 4;\n    const BYTES_AT_ONCE: usize = 16 * UNROLL;\n\n    let mut crc = !prev;\n\n    while buf.len() >= BYTES_AT_ONCE {\n        for _ in 0..UNROLL {\n            crc = CRC32_TABLE[0x0][buf[0xf] as usize]\n                ^ CRC32_TABLE[0x1][buf[0xe] as usize]\n                ^ CRC32_TABLE[0x2][buf[0xd] as usize]\n                ^ CRC32_TABLE[0x3][buf[0xc] as usize]\n                ^ CRC32_TABLE[0x4][buf[0xb] as usize]\n                ^ CRC32_TABLE[0x5][buf[0xa] as usize]\n                ^ CRC32_TABLE[0x6][buf[0x9] as usize]\n                ^ CRC32_TABLE[0x7][buf[0x8] as usize]\n                ^ CRC32_TABLE[0x8][buf[0x7] as usize]\n                ^ CRC32_TABLE[0x9][buf[0x6] as usize]\n                ^ CRC32_TABLE[0xa][buf[0x5] as usize]\n                ^ CRC32_TABLE[0xb][buf[0x4] as usize]\n                ^ CRC32_TABLE[0xc][buf[0x3] as usize ^ ((crc >> 0x18) & 0xFF) as usize]\n                ^ CRC32_TABLE[0xd][buf[0x2] as usize ^ ((crc >> 0x10) & 0xFF) as usize]\n                ^ CRC32_TABLE[0xe][buf[0x1] as usize ^ ((crc >> 0x08) & 0xFF) as usize]\n                ^ CRC32_TABLE[0xf][buf[0x0] as usize ^ ((crc >> 0x00) & 0xFF) as usize];\n            buf = &buf[16..];\n        }\n    }\n\n    update_slow(!crc, buf)\n}\n\npub(crate) fn update_slow(prev: u32, buf: &[u8]) -> u32 {\n    let mut crc = !prev;\n\n    for &byte in buf.iter() {\n        crc = CRC32_TABLE[0][((crc as u8) ^ byte) as usize] ^ (crc >> 8);\n    }\n\n    !crc\n}\n\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"src/table.rs"}