 if parser.toksuper != -1 {\n                    tokens[parser.toksuper as usize].size += 1;\n                }\n            }\n        } else if c == b'\\t' || c == b'\\r' || c == b'\\n' || c == b' ' {\n        } else if c == b':' {\n            parser.toksuper = parser.toknext as i32 - 1;\n        } else if c == b',' {\n            if parser.toksuper != -1 && !is_container(tokens[parser.toksuper as usize].typ) {\n                let i = find_open_container(tokens, parser.toknext as i32 - 1);\n                if i != -1 {\n                    parser.toksuper = i;\n                }\n            }\n        } else {\n            let r = parse_primitive(parser, js, tokens);\n            if r < 0 {\n                ret = r;\n                stop = true;\n            } else {\n                count += 1;\n                if parser.toksuper != -1 {\n                    tokens[parser.toksuper as usize].size += 1;\n                }\n            }\n        }\n        if !stop {\n            parser.pos += 1;\n        }\n    }\n    if stop {\n        return ret;\n    }\n    if find_open(tokens, parser.toknext as i32 - 1) != -1 {\n        return JSMN_ERROR_PART;\n    }\n    count\n}","attr_info":{"attributes":[{"DocComment":" `jsmn_parse` with a token array: the number of tokens, or `JSMN_ERROR_NOMEM`,"},{"DocComment":" `JSMN_ERROR_INVAL`, `JSMN_ERROR_PART`."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"