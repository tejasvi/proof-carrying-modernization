{"charon_version":"0.1.293","translated":{"crate_name":"jsmn_rs","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"jsmn_rs","contents":"//! jsmn (zserge/jsmn @ 25647e6, `jsmn.h`), default configuration (neither `JSMN_PARENT_LINKS` nor\n//! `JSMN_STRICT`), in safe Rust: written by equiv-lean's agents in an Aeneas-friendly form (no\n//! `unsafe`; loops as `while` with state, no `return` inside a loop; the token array as a slice).\n//! The source length is `js.len()` and the token capacity `tokens.len()`; positions and the token\n//! counter are `usize` (C: `unsigned int`), token fields and `toksuper` are `i32` (C: `int`).\n//! Only the mode with a token array (C: `tokens != NULL`) is translated.\n\n/// Not enough tokens were provided.\npub const JSMN_ERROR_NOMEM: i32 = -1;\n/// Invalid character inside JSON string.\npub const JSMN_ERROR_INVAL: i32 = -2;\n/// The string is not a full JSON packet, more bytes expected.\npub const JSMN_ERROR_PART: i32 = -3;\n\n/// `jsmntype_t` (C values 0, 1, 2, 4, 8).\n#[derive(Clone, Copy)]\npub enum JsmnType {\n    Undefined,\n    Object,\n    Array,\n    String,\n    Primitive,\n}\n\n/// `jsmntok_t`.\n#[derive(Clone, Copy)]\npub struct JsmnTok {\n    pub typ: JsmnType,\n    pub start: i32,\n    pub end: i32,\n    pub size: i32,\n}\n\n/// `jsmn_parser`.\npub struct JsmnParser {\n    pub pos: usize,\n    pub toknext: usize,\n    pub toksuper: i32,\n}\n\n/// `jsmn_init`.\npub fn jsmn_init() -> JsmnParser {\n    JsmnParser { pos: 0, toknext: 0, toksuper: -1 }\n}\n\n/// A container token (object or array).\nfn is_container(t: JsmnType) -> bool {\n    match t {\n        JsmnType::Object => true,\n        JsmnType::Array => true,\n        _ => false,\n    }\n}\n\n/// `token->type == type` for the type of a closing bracket (`}`: object, `]`: array).\nfn type_is(t: JsmnType, object: bool) -> bool {\n    match t {\n        JsmnType::Object => object,\n        JsmnType::Array => !object,\n        _ => false,\n    }\n}\n\n/// `jsmn_alloc_token`: the index of the next free token, or `None` when the array is full.\nfn alloc_token(parser: &mut JsmnParser, tokens: &mut [JsmnTok]) -> Option<usize> {\n    if parser.toknext >= tokens.len() {\n        return None;\n    }\n    let i = parser.toknext;\n    parser.toknext += 1;\n    tokens[i].start = -1;\n    tokens[i].end = -1;\n    tokens[i].size = 0;\n    Some(i)\n}\n\n/// `jsmn_fill_token`.\nfn fill_token(token: &mut JsmnTok, typ: JsmnType, start: i32, end: i32) {\n    token.typ = typ;\n    token.start = start;\n    token.end = end;\n    token.size = 0;\n}\n\n/// `jsmn_parse_primitive` (non-strict: a primitive ends at `:`, whitespace, `,`, `]`, `}`, the end\n/// of the input or a NUL byte).\nfn parse_primitive(parser: &mut JsmnParser, js: &[u8], tokens: &mut [JsmnTok]) -> i32 {\n    let len = js.len();\n    let start = parser.pos;\n    let mut found = false;\n    let mut inval = false;\n    while !found && !inval && parser.pos < len && js[parser.pos] != 0 {\n        let c = js[parser.pos];\n        if c == b':' || c == b'\\t' || c == b'\\r' || c == b'\\n' || c == b' ' || c == b',' || c == b']'\n            || c == b'}'\n        {\n            found = true;\n        } else if c < 32 || c >= 127 {\n            inval = true;\n        } else {\n            parser.pos += 1;\n        }\n    }\n    if inval {\n        parser.pos = start;\n        return JSMN_ERROR_INVAL;\n    }\n    match alloc_token(parser, tokens) {\n        None => {\n            parser.pos = start;\n            JSMN_ERROR_NOMEM\n        }\n        Some(i) => {\n            fill_token(&mut tokens[i], JsmnType::Primitive, start as i32, parser.pos as i32);\n            parser.pos -= 1;\n            0\n        }\n    }\n}\n\n/// A hexadecimal digit `0-9`, `A-F`, `a-f`.\nfn is_hex(h: u8) -> bool {\n    (h >= 48 && h <= 57) || (h >= 65 && h <= 70) || (h >= 97 && h <= 102)\n}\n\n/// One of the escaped symbols `\"`, `/`, `\\`, `b`, `f`, `r`, `n`, `t`.\nfn is_simple_escape(e: u8) -> bool {\n    e == b'\"' || e == b'/' || e == b'\\\\' || e == b'b' || e == b'f' || e == b'r' || e == b'n' || e == b't'\n}\n\n/// `jsmn_parse_string` (`parser.pos` at the opening quote).\nfn parse_string(parser: &mut JsmnParser, js: &[u8], tokens: &mut [JsmnTok]) -> i32 {\n    let len = js.len();\n    let start = parser.pos;\n    parser.pos += 1;\n    let mut res = JSMN_ERROR_PART;\n    let mut done = false;\n    while !done && parser.pos < len && js[parser.pos] != 0 {\n        let c = js[parser.pos];\n        if c == b'\"' {\n            match alloc_token(parser, tokens) {\n                None => {\n                    parser.pos = start;\n                    res = JSMN_ERROR_NOMEM;\n                }\n                Some(i) => {\n                    fill_token(&mut tokens[i], JsmnType::String, start as i32 + 1, parser.pos as i32);\n                    res = 0;\n                }\n            }\n            done = true;\n        } else if c == b'\\\\' && parser.pos + 1 < len {\n            parser.pos += 1;\n            let e = js[parser.pos];\n            if is_simple_escape(e) {\n                parser.pos += 1;\n            } else if e == b'u' {\n                parser.pos += 1;\n                let mut i = 0;\n                let mut bad = false;\n                while !bad && i < 4 && parser.pos < len && js[parser.pos] != 0 {\n                    if is_hex(js[parser.pos]) {\n                        parser.pos += 1;\n                        i += 1;\n                    } else {\n                        bad = true;\n                    }\n                }\n                if bad {\n                    parser.pos = start;\n                    res = JSMN_ERROR_INVAL;\n                    done = true;\n                }\n            } else {\n                parser.pos = start;\n                res = JSMN_ERROR_INVAL;\n                done = true;\n            }\n        } else {\n            parser.pos += 1;\n        }\n    }\n    if !done {\n        parser.pos = start;\n    }\n    res\n}\n\n/// The innermost open token (`start != -1`, `end == -1`) at index `i` or below, or `-1`.\nfn find_open(tokens: &[JsmnTok], i0: i32) -> i32 {\n    let mut i = i0;\n    let mut found = false;\n    while !found && i >= 0 {\n        let t = tokens[i as usize];\n        if t.start != -1 && t.end == -1 {\n            found = true;\n        } else {\n            i -= 1;\n        }\n    }\n    i\n}\n\n/// The innermost open object or array at index `i` or below, or `-1`.\nfn find_open_container(tokens: &[JsmnTok], i0: i32) -> i32 {\n    let mut i = i0;\n    let mut found = false;\n    while !found && i >= 0 {\n        let t = tokens[i as usize];\n        if is_container(t.typ) && t.start != -1 && t.end == -1 {\n            found = true;\n        } else {\n            i -= 1;\n        }\n    }\n    i\n}\n\n/// `jsmn_parse` with a token array: the number of tokens, or `JSMN_ERROR_NOMEM`,\n/// `JSMN_ERROR_INVAL`, `JSMN_ERROR_PART`.\npub fn jsmn_parse(parser: &mut JsmnParser, js: &[u8], tokens: &mut [JsmnTok]) -> i32 {\n    let len = js.len();\n    let mut count = parser.toknext as i32;\n    let mut ret = 0;\n    let mut stop = false;\n    while !stop && parser.pos < len && js[parser.pos] != 0 {\n        let c = js[parser.pos];\n        if c == b'{' || c == b'[' {\n            count += 1;\n            match alloc_token(parser, tokens) {\n                None => {\n                    ret = JSMN_ERROR_NOMEM;\n                    stop = true;\n                }\n                Some(i) => {\n                    if parser.toksuper != -1 {\n                        tokens[parser.toksuper as usize].size += 1;\n                    }\n                    tokens[i].typ = if c == b'{' { JsmnType::Object } else { JsmnType::Array };\n                    tokens[i].start = parser.pos as i32;\n                    parser.toksuper = parser.toknext as i32 - 1;\n                }\n            }\n        } else if c == b'}' || c == b']' {\n            let object = c == b'}';\n            let i = find_open(tokens, parser.toknext as i32 - 1);\n            if i == -1 {\n                ret = JSMN_ERROR_INVAL;\n                stop = true;\n            } else if !type_is(tokens[i as usize].typ, object) {\n                ret = JSMN_ERROR_INVAL;\n                stop = true;\n            } else {\n                parser.toksuper = -1;\n                tokens[i as usize].end = parser.pos as i32 + 1;\n                let j = find_open(tokens, i);\n                if j != -1 {\n                    parser.toksuper = j;\n                }\n            }\n        } else if c == b'\"' {\n            let r = parse_string(parser, js, tokens);\n            if r < 0 {\n                ret = r;\n                stop = true;\n            } else {\n                count += 1;\n                if parser.toksuper != -1 {\n                    tokens[parser.toksuper as usize].size += 1;\n                }\n            }\n        } else if c == b'\\t' || c == b'\\r' || c == b'\\n' || c == b' ' {\n        } else if c == b':' {\n            parser.toksuper = parser.toknext as i32 - 1;\n        } else if c == b',' {\n            if parser.toksuper != -1 && !is_container(tokens[parser.toksuper as usize].typ) {\n                let i = find_open_container(tokens, parser.toknext as i32 - 1);\n                if i != -1 {\n                    parser.toksuper = i;\n                }\n            }\n        } else {\n            let r = parse_primitive(parser, js, tokens);\n            if r < 0 {\n                ret = r;\n                stop = true;\n            } else {\n                count += 1;\n                if parser.toksuper != -1 {\n                    tokens[parser.toksuper as usize].size += 1;\n                }\n            }\n        }\n        if !stop {\n            parser.pos += 1;\n        }\n    }\n    if stop {\n        return ret;\n    }\n    if find_open(tokens, parser.toknext as i32 - 1) != -1 {\n        return JSMN_ERROR_PART;\n    }\n    count\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip