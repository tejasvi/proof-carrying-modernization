{"charon_version":"0.1.293","translated":{"crate_name":"cbact01c","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"cbact01c","contents":"#[derive(Clone, Copy)]\npub struct AccountRecord {\n    pub acct_id: i64,\n    pub acct_active_status: [u8; 1],\n    pub acct_curr_bal: i64,\n    pub acct_credit_limit: i64,\n    pub acct_cash_credit_limit: i64,\n    pub acct_open_date: [u8; 10],\n    pub acct_expiraion_date: [u8; 10],\n    pub acct_reissue_date: [u8; 10],\n    pub acct_curr_cyc_credit: i64,\n    pub acct_curr_cyc_debit: i64,\n    pub acct_addr_zip: [u8; 10],\n    pub acct_group_id: [u8; 10],\n    pub filler1: [u8; 178],\n}\n\n#[derive(Clone, Copy)]\npub struct OutAcctRec {\n    pub out_acct_id: i64,\n    pub out_acct_active_status: [u8; 1],\n    pub out_acct_curr_bal: i64,\n    pub out_acct_credit_limit: i64,\n    pub out_acct_cash_credit_limit: i64,\n    pub out_acct_open_date: [u8; 10],\n    pub out_acct_expiraion_date: [u8; 10],\n    pub out_acct_reissue_date: [u8; 10],\n    pub out_acct_curr_cyc_credit: i64,\n    pub out_acct_curr_cyc_debit: i64,\n    pub out_acct_group_id: [u8; 10],\n}\n\n#[derive(Clone, Copy)]\npub struct ArrArrayRec {\n    pub arr_acct_id: i64,\n    pub arr_acct_curr_bal: [i64; 5],\n    pub arr_acct_curr_cyc_debit: [i64; 5],\n    pub arr_filler: [u8; 4],\n}\n\npub struct Output {\n    pub displays: Vec<Vec<u8>>,\n    pub out_file_writes: Vec<OutAcctRec>,\n    pub arry_file_writes: Vec<ArrArrayRec>,\n    pub vbrc_file_writes: Vec<Vec<u8>>,\n    pub abended: bool,\n}\n\nfn push_bytes(out: &mut Vec<u8>, s: &[u8]) {\n    let mut i = 0;\n    while i < s.len() {\n        out.push(s[i]);\n        i += 1;\n    }\n}\n\nfn lit(s: &[u8]) -> Vec<u8> {\n    let mut v = Vec::new();\n    push_bytes(&mut v, s);\n    v\n}\n\nfn overpunch(d: u8, neg: bool) -> u8 {\n    if neg {\n        if d == 0 {\n            b'}'\n        } else {\n            b'J' + d - 1\n        }\n    } else if d == 0 {\n        b'{'\n    } else {\n        b'A' + d - 1\n    }\n}\n\nfn magnitude(v: i64) -> u64 {\n    if v < 0 {\n        ((-(v + 1)) as u64) + 1\n    } else {\n        v as u64\n    }\n}\n\n/// Zoned decimal display form; signed items get the sign overpunched in the last digit.\nfn push_zoned(out: &mut Vec<u8>, v: i64, digits: usize, signed: bool) {\n    let neg = v < 0;\n    let mut m: u64 = magnitude(v);\n    let mut buf = [b'0'; 20];\n    let mut i = digits;\n    while i > 0 {\n        i -= 1;\n        buf[i] = b'0' + (m % 10) as u8;\n        m /= 10;\n    }\n    if signed && digits > 0 {\n        let d = buf[digits - 1] - b'0';\n        buf[digits - 1] = overpunch(d, neg);\n    }\n    let mut k = 0;\n    while k < digits {\n        out.push(buf[k]);\n        k += 1;\n    }\n}\n\nfn set_err_msg(rec: &mut [u8; 80]) {\n    let msg = b\"INVALID INPUT\";\n    let mut i = 0;\n    while i < 38 {\n        let c = if i < 13 { msg[i] } else { b' ' };\n        rec[42 + i] = c;\n        i += 1;\n    }\n}\n\n/// COBDATFT: date formatting routine operating on the CODATECN-REC layout:\n/// type(0) inp-date(1..21) outtype(21) out-date(22..42) error-msg(42..80)\nfn cobdatft(rec: &mut [u8; 80]) {\n    let intype = rec[0];\n    let outtype = rec[21];\n    let mut mode: u8 = 0;\n    if intype == b'1' {\n        if rec[5] != b'-' && outtype != b'2' {\n            mode = 1;\n        }\n    } else if intype == b'2' {\n        if outtype != b'1' {\n            mode = 2;\n        }\n    }\n    if mode == 1 {\n        rec[22] = rec[1];\n        rec[23] = rec[2];\n        rec[24] = rec[3];\n        rec[25] = rec[4];\n        rec[26] = b'-';\n        rec[27] = rec[5];\n        rec[28] = rec[6];\n        rec[29] = b'-';\n        rec[30] = rec[7];\n        rec[31] = rec[8];\n    } else if mode == 2 {\n        rec[22] = rec[1];\n        rec[23] = rec[2];\n        rec[24] = rec[3];\n        rec[25] = rec[4];\n        rec[26] = rec[6];\n        rec[27] = rec[7];\n        rec[28] = rec[9];\n        rec[29] = rec[10];\n    } else {\n        set_err_msg(rec);\n    }\n}\n\nfn set_inp_date(rec: &mut [u8; 80], d: &[u8; 10]) {\n    let mut i = 0;\n    while i < 20 {\n        let c = if i < 10 { d[i] } else { b' ' };\n        rec[1 + i] = c;\n        i += 1;\n    }\n}\n\nfn get_out_date(rec: &[u8; 80]) -> [u8; 10] {\n    let mut r = [b' '; 10];\n    let mut j = 0;\n    while j < 10 {\n        r[j] = rec[22 + j];\n        j += 1;\n    }\n    r\n}\n\nfn push_first4(out: &mut Vec<u8>, s: &[u8; 10]) {\n    let mut k = 0;\n    while k < 4 {\n        out.push(s[k]);\n        k += 1;\n    }\n}\n\nfn labeled_num(label: &[u8], v: i64, digits: usize, signed: bool) -> Vec<u8> {\n    let mut d = lit(label);\n    push_zoned(&mut d, v, digits, signed);\n    d\n}\n\nfn labeled_x(label: &[u8], x: &[u8]) -> Vec<u8> {\n    let mut d = lit(label);\n    push_bytes(&mut d, x);\n    d\n}\n\npub fn run(acctfile_file: &[AccountRecord]) -> Output {\n    let mut displays: Vec<Vec<u8>> = Vec::new();\n    let mut out_file_writes: Vec<OutAcctRec> = Vec::new();\n    let mut arry_file_writes: Vec<ArrArrayRec> = Vec::new();\n    let mut vbrc_file_writes: Vec<Vec<u8>> = Vec::new();\n\n    displays.push(lit(b\"START OF EXECUTION OF PROGRAM CBACT01C\"));\n\n    let mut out_rec = OutAcctRec {\n        out_acct_id: 0,\n        out_acct_active_status: [b' '; 1],\n        out_acct_curr_bal: 0,\n        out_acct_credit_limit: 0,\n        out_acct_cash_credit_limit: 0,\n        out_acct_open_date: [b' '; 10],\n        out_acct_expiraion_date: [b' '; 10],\n        out_acct_reissue_date: [b' '; 10],\n        out_acct_curr_cyc_credit: 0,\n        out_acct_curr_cyc_debit: 0,\n        out_acct_group_id: [b' '; 10],\n    };\n    let mut codatecn: [u8; 80] = [b' '; 80];\n\n    let mut end_of_file = false;\n    let mut idx: usize = 0;\n\n    while !end_of_file {\n        if idx < acctfile_file.len() {\n            let acct = acctfile_file[idx];\n            idx += 1;\n\n            // 1100-DISPLAY-ACCT-RECORD\n            displays.push(labeled_num(b\"ACCT-ID                 :\", acct.acct_id, 11, false));\n            displays.push(labeled_x(b\"ACCT-ACTIVE-STATUS      :\", &acct.acct_active_status));\n            displays.push(labeled_num(b\"ACCT-CURR-BAL           :\", acct.acct_curr_bal, 12, true));\n            displays.push(labeled_num(b\"ACCT-CREDIT-LIMIT       :\", acct.acct_credit_limit, 12, true));\n            displays.push(labeled_num(\n                b\"ACCT-CASH-CREDIT-LIMIT  :\",\n                acct.acct_cash_credit_limit,\n                12,\n                true,\n            ));\n            displays.push(labeled_x(b\"ACCT-OPEN-DATE          :\", &acct.acct_open_date));\n            displays.push(labeled_x(b\"ACCT-EXPIRAION-DATE     :\", &acct.acct_expiraion_date));\n            displays.push(labeled_x(b\"ACCT-REISSUE-DATE       :\", &acct.acct_reissue_date));\n            displays.push(labeled_num(\n                b\"ACCT-CURR-CYC-CREDIT    :\",\n                acct.acct_curr_cyc_credit,\n                12,\n                true,\n            ));\n            displays.push(labeled_num(\n                b\"ACCT-CURR-CYC-DEBIT     :\",\n                acct.acct_curr_cyc_debit,\n                12,\n                true,\n            ));\n            displays.push(labeled_x(b\"ACCT-GROUP-ID           :\", &acct.acct_group_id));\n            displays.push(lit(b\"-------------------------------------------------\"));\n\n            // 1300-POPUL-ACCT-RECORD\n            out_rec.out_acct_id = acct.acct_id;\n            out_rec.out_acct_active_status = acct.acct_active_status;\n            out_rec.out_acct_curr_bal = acct.acct_curr_bal;\n            out_rec.out_acct_credit_limit = acct.acct_credit_limit;\n            out_rec.out_acct_cash_credit_limit = acct.acct_cash_credit_limit;\n            out_rec.out_acct_open_date = acct.acct_open_date;\n            out_rec.out_acct_expiraion_date = acct.acct_expiraion_date;\n            set_inp_date(&mut codatecn, &acct.acct_reissue_date);\n            let ws_reissue: [u8; 10] = acct.acct_reissue_date;\n            codatecn[0] = b'2';\n            codatecn[21] = b'2';\n            cobdatft(&mut codatecn);\n            out_rec.out_acct_reissue_date = get_out_date(&codatecn);\n            out_rec.out_acct_curr_cyc_credit = acct.acct_curr_cyc_credit;\n            if acct.acct_curr_cyc_debit == 0 {\n                out_rec.out_acct_curr_cyc_debit = 252500;\n            }\n            out_rec.out_acct_group_id = acct.acct_group_id;\n\n            // 1350-WRITE-ACCT-RECORD\n            out_file_writes.push(out_rec);\n\n            // INITIALIZE ARR-ARRAY-REC + 1400-POPUL-ARRAY-RECORD\n            let mut bal: [i64; 5] = [0; 5];\n            let mut deb: [i64; 5] = [0; 5];\n            bal[0] = acct.acct_curr_bal;\n            deb[0] = 100500;\n            bal[1] = acct.acct_curr_bal;\n            deb[1] = 152500;\n            bal[2] = -102500;\n            deb[2] = -250000;\n            let arr_rec = ArrArrayRec {\n                arr_acct_id: acct.acct_id,\n                arr_acct_curr_bal: bal,\n                arr_acct_curr_cyc_debit: deb,\n                arr_filler: [b' '; 4],\n            };\n\n            // 1450-WRITE-ARRY-RECORD\n            arry_file_writes.push(arr_rec);\n\n            // 1500-POPUL-VBRC-RECORD\n            let mut vbrc1: Vec<u8> = Vec::new();\n            push_zoned(&mut vbrc1, acct.acct_id, 11, false);\n            vbrc1.push(acct.acct_active_status[0]);\n\n            let mut vbrc2: Vec<u8> = Vec::new();\n            push_zoned(&mut vbrc2, acct.acct_id, 11, false);\n            push_zoned(&mut vbrc2, acct.acct_curr_bal, 12, true);\n            push_zoned(&mut vbrc2, acct.acct_credit_limit, 12, true);\n            push_first4(&mut vbrc2, &ws_reissue);\n\n            let mut d1 = lit(b\"VBRC-REC1:\");\n            push_bytes(&mut d1, &vbrc1);\n            displays.push(d1);\n            let mut d2 = lit(b\"VBRC-REC2:\");\n            push_bytes(&mut d2, &vbrc2);\n            displays.push(d2);\n\n            // 1550-WRITE-VB1-RECORD (length 12)\n            vbrc_file_writes.push(vbrc1);\n            // 1575-WRITE-VB2-RECORD (length 39)\n            vbrc_file_writes.push(vbrc2);\n\n            // DISPLAY ACCOUNT-RECORD\n            let mut d = Vec::new();\n            push_zoned(&mut d, acct.acct_id, 11, false);\n            push_bytes(&mut d, &acct.acct_active_status);\n            push_zoned(&mut d, acct.acct_curr_bal, 12, true);\n            push_zoned(&mut d, acct.acct_credit_limit, 12, true);\n            push_zoned(&mut d, acct.acct_cash_credit_limit, 12, true);\n            push_bytes(&mut d, &acct.acct_open_date);\n            push_bytes(&mut d, &acct.acct_expiraion_date);\n            push_bytes(&mut d, &acct.acct_reissue_date);\n            push_zoned(&mut d, acct.acct_curr_cyc_credit, 12, true);\n            push_zoned(&mut d, acct.acct_curr_cyc_debit, 12, true);\n            push_bytes(&mut d, &acct.acct_addr_zip);\n            push_bytes(&mut d, &acct.acct_group_id);\n            push_bytes(&mut d, &acct.filler1);\n            displays.push(d);\n        } else {\n            end_of_file = true;\n        }\n    }\n\n    displays.push(lit(b\"END OF EXECUTION OF PROGRAM CBACT01C\"));\n\n    Output {\n        displays,\n        out_file_writes,\n        arry_file_writes,\n        vbrc_file_writes,\n        abended: false,\n    }\n}"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":12,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":13,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/ops/deref.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Value":[1,{"Array":[{"Value":[2,{"TypeVar":{"Bound":[0,0]}}]},{"Value":[0,[{"Var":{"Bound":[0,0]}},{"Deduplicated":0}]]},null]}]},"kind":"InherentImplBlock"}}},{"Ident":["as_slice",0]}]},{"key":{"Fun":1},"value":[{"Ident":["c