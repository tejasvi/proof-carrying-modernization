{"charon_version":"0.1.293","translated":{"crate_name":"cbact02c","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"cbact02c","contents":"#[derive(Clone, Copy)]\npub struct CardRecord {\n    pub card_num: [u8; 16],\n    pub card_acct_id: i64,\n    pub card_cvv_cd: i64,\n    pub card_embossed_name: [u8; 50],\n    pub card_expiraion_date: [u8; 10],\n    pub card_active_status: [u8; 1],\n    pub filler1: [u8; 59],\n}\n\npub struct Output {\n    pub displays: Vec<Vec<u8>>,\n    pub abended: bool,\n}\n\nfn push_bytes(dst: &mut Vec<u8>, src: &[u8]) {\n    let mut i = 0;\n    while i < src.len() {\n        dst.push(src[i]);\n        i += 1;\n    }\n}\n\n/// Unsigned zoned-decimal display of `digits` digits (PIC 9(n)).\nfn push_unsigned(dst: &mut Vec<u8>, value: i64, digits: usize) {\n    let mut v: u64 = if value < 0 {\n        (0i64 - (value as i128) as i64) as u64\n    } else {\n        value as u64\n    };\n    let mut buf: [u8; 18] = [b'0'; 18];\n    let mut i = 0;\n    while i < digits && i < 18 {\n        buf[digits - 1 - i] = b'0' + (v % 10) as u8;\n        v /= 10;\n        i += 1;\n    }\n    let mut j = 0;\n    while j < digits && j < 18 {\n        dst.push(buf[j]);\n        j += 1;\n    }\n}\n\nfn card_record_display(r: &CardRecord) -> Vec<u8> {\n    let mut line: Vec<u8> = Vec::new();\n    push_bytes(&mut line, &r.card_num);\n    push_unsigned(&mut line, r.card_acct_id, 11);\n    push_unsigned(&mut line, r.card_cvv_cd, 3);\n    push_bytes(&mut line, &r.card_embossed_name);\n    push_bytes(&mut line, &r.card_expiraion_date);\n    push_bytes(&mut line, &r.card_active_status);\n    push_bytes(&mut line, &r.filler1);\n    line\n}\n\nfn display_io_status(displays: &mut Vec<Vec<u8>>, status: [u8; 2]) {\n    let stat1 = status[0];\n    let stat2 = status[1];\n    let numeric = stat1 >= b'0' && stat1 <= b'9' && stat2 >= b'0' && stat2 <= b'9';\n    let mut line: Vec<u8> = Vec::new();\n    push_bytes(&mut line, b\"FILE STATUS IS: NNNN\");\n    if !numeric || stat1 == b'9' {\n        line.push(stat1);\n        push_unsigned(&mut line, stat2 as i64, 3);\n    } else {\n        line.push(b'0');\n        line.push(b'0');\n        line.push(stat1);\n        line.push(stat2);\n    }\n    displays.push(line);\n}\n\nfn abend(displays: &mut Vec<Vec<u8>>) {\n    displays.push(b\"ABENDING PROGRAM\".to_vec());\n}\n\npub fn run(cardfile_file: &[CardRecord]) -> Output {\n    let mut displays: Vec<Vec<u8>> = Vec::new();\n    displays.push(b\"START OF EXECUTION OF PROGRAM CBACT02C\".to_vec());\n\n    // OPEN INPUT always succeeds with status '00'.\n    let mut pos: usize = 0;\n    let mut at_eof = false;\n    let mut end_of_file = false;\n\n    while !end_of_file {\n        // 1000-CARDFILE-GET-NEXT\n        let status: [u8; 2];\n        let mut rec_opt: Option<CardRecord> = None;\n        if at_eof {\n            status = [b'4', b'6'];\n        } else if pos < cardfile_file.len() {\n            rec_opt = Some(cardfile_file[pos]);\n            pos += 1;\n            status = [b'0', b'0'];\n        } else {\n            at_eof = true;\n            status = [b'1', b'0'];\n        }\n        let appl_result: i64 = if status[0] == b'0' && status[1] == b'0' {\n            0\n        } else if status[0] == b'1' && status[1] == b'0' {\n            16\n        } else {\n            12\n        };\n        if appl_result == 0 {\n            // continue\n        } else if appl_result == 16 {\n            end_of_file = true;\n        } else {\n            displays.push(b\"ERROR READING CARDFILE\".to_vec());\n            display_io_status(&mut displays, status);\n            abend(&mut displays);\n            return Output {\n                displays,\n                abended: true,\n            };\n        }\n        if !end_of_file {\n            if let Some(r) = rec_opt {\n                displays.push(card_record_display(&r));\n            }\n        }\n    }\n\n    // CLOSE always succeeds with status '00'.\n    displays.push(b\"END OF EXECUTION OF PROGRAM CBACT02C\".to_vec());\n\n    Output {\n        displays,\n        abended: false,\n    }\n}"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":12,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":13,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":14,"name":{"Local":"