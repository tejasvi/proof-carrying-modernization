{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"cbact03c","contents":"#[derive(Clone, Copy)]\npub struct CardXrefRecord {\n    pub xref_card_num: [u8; 16],\n    pub xref_cust_id: i64,\n    pub xref_acct_id: i64,\n    pub filler1: [u8; 14],\n}\n\npub struct Output {\n    pub displays: Vec<Vec<u8>>,\n    pub abended: bool,\n}\n\nconst DIGITS: [u8; 10] = *b\"0123456789\";\n\nfn push_bytes(dst: &mut Vec<u8>, src: &[u8]) {\n    let mut i = 0;\n    while i < src.len() {\n        dst.push(src[i]);\n        i += 1;\n    }\n}\n\nfn push_unsigned(dst: &mut Vec<u8>, value: i64, digits: usize) {\n    // Unsigned display numeric: magnitude, truncated to the field's digits.\n    let mut v: i64 = if value < 0 { -value } else { value };\n    let mut buf: [u8; 20] = [b'0'; 20];\n    let mut pos = digits;\n    while pos > 0 {\n        pos -= 1;\n        let d = (v % 10) as usize;\n        buf[pos] = DIGITS[d];\n        v = v / 10;\n    }\n    let mut i = 0;\n    while i < digits {\n        dst.push(buf[i]);\n        i += 1;\n    }\n}\n\nfn record_bytes(r: &CardXrefRecord) -> Vec<u8> {\n    let mut out: Vec<u8> = Vec::new();\n    push_bytes(&mut out, &r.xref_card_num);\n    push_unsigned(&mut out, r.xref_cust_id, 9);\n    push_unsigned(&mut out, r.xref_acct_id, 11);\n    push_bytes(&mut out, &r.filler1);\n    out\n}\n\nfn is_digit(b: u8) -> bool {\n    b >= b'0' && b <= b'9'\n}\n\nfn display_io_status(displays: &mut Vec<Vec<u8>>, stat1: u8, stat2: u8) {\n    let mut line: Vec<u8> = Vec::new();\n    push_bytes(&mut line, b\"FILE STATUS IS: NNNN\");\n    if !(is_digit(stat1) && is_digit(stat2)) || stat1 == b'9' {\n        line.push(stat1);\n        let v = stat2 as i64;\n        push_unsigned(&mut line, v, 3);\n    } else {\n        line.push(b'0');\n        line.push(b'0');\n        line.push(stat1);\n        line.push(stat2);\n    }\n    displays.push(line);\n}\n\nfn abend(displays: &mut Vec<Vec<u8>>) {\n    let mut line: Vec<u8> = Vec::new();\n    push_bytes(&mut line, b\"ABENDING PROGRAM\");\n    displays.push(line);\n}\n\npub fn run(xreffile_file: &[CardXrefRecord]) -> Output {\n    let mut displays: Vec<Vec<u8>> = Vec::new();\n\n    let mut line: Vec<u8> = Vec::new();\n    push_bytes(&mut line, b\"START OF EXECUTION OF PROGRAM CBACT03C\");\n    displays.push(line);\n\n    // OPEN INPUT succeeds (status '00').\n    let mut card_xref_record = CardXrefRecord {\n        xref_card_num: [b' '; 16],\n        xref_cust_id: 0,\n        xref_acct_id: 0,\n        filler1: [b' '; 14],\n    };\n    let mut end_of_file = false;\n    let mut pos: usize = 0;\n    let mut eof_reached = false;\n\n    while !end_of_file {\n        // 1000-XREFFILE-GET-NEXT\n        let stat1: u8;\n        let stat2: u8;\n        if eof_reached {\n            stat1 = b'4';\n            stat2 = b'6';\n        } else if pos < xreffile_file.len() {\n            card_xref_record = xreffile_file[pos];\n            pos += 1;\n            stat1 = b'0';\n            stat2 = b'0';\n        } else {\n            eof_reached = true;\n            stat1 = b'1';\n            stat2 = b'0';\n        }\n        let appl_result: i64;\n        if stat1 == b'0' && stat2 == b'0' {\n            appl_result = 0;\n            displays.push(record_bytes(&card_xref_record));\n        } else if stat1 == b'1' && stat2 == b'0' {\n            appl_result = 16;\n        } else {\n            appl_result = 12;\n        }\n        if appl_result == 0 {\n            // continue\n        } else if appl_result == 16 {\n            end_of_file = true;\n        } else {\n            let mut l: Vec<u8> = Vec::new();\n            push_bytes(&mut l, b\"ERROR READING XREFFILE\");\n            displays.push(l);\n            display_io_status(&mut displays, stat1, stat2);\n            abend(&mut displays);\n            return Output {\n                displays,\n                abended: true,\n            };\n        }\n        if !end_of_file {\n            displays.push(record_bytes(&card_xref_record));\n        }\n    }\n\n    // CLOSE succeeds (status '00').\n\n    let mut line2: Vec<u8> = Vec::new();\n    push_bytes(&mut line2, b\"END OF EXECUTION OF PROGRAM CBACT03C\");\n    displays.push(line2);\n\n    Output {\n        displays,\n        abended: false,\n    }\n}"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":