{"charon_version":"0.1.293","translated":{"crate_name":"cbact04c_t","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"cbact04c_t","contents":"#[derive(Clone, Copy)]\npub struct TranCatBalRecord {\n    pub trancat_acct_id: i64,\n    pub trancat_type_cd: [u8; 2],\n    pub trancat_cd: i64,\n    pub tran_cat_bal: i64,\n    pub filler1: [u8; 22],\n}\n\n#[derive(Clone, Copy)]\npub struct CardXrefRecord {\n    pub xref_card_num: [u8; 16],\n    pub xref_cust_id: i64,\n    pub xref_acct_id: i64,\n    pub filler1: [u8; 14],\n}\n\n#[derive(Clone, Copy)]\npub struct DisGroupRecord {\n    pub dis_acct_group_id: [u8; 10],\n    pub dis_tran_type_cd: [u8; 2],\n    pub dis_tran_cat_cd: i64,\n    pub dis_int_rate: i64,\n    pub filler1: [u8; 28],\n}\n\n#[derive(Clone, Copy)]\npub struct AccountRecord {\n    pub acct_id: i64,\n    pub acct_active_status: [u8; 1],\n    pub acct_curr_bal: i64,\n    pub acct_credit_limit: i64,\n    pub acct_cash_credit_limit: i64,\n    pub acct_open_date: [u8; 10],\n    pub acct_expiraion_date: [u8; 10],\n    pub acct_reissue_date: [u8; 10],\n    pub acct_curr_cyc_credit: i64,\n    pub acct_curr_cyc_debit: i64,\n    pub acct_addr_zip: [u8; 10],\n    pub acct_group_id: [u8; 10],\n    pub filler1: [u8; 178],\n}\n\n#[derive(Clone, Copy)]\npub struct TranRecord {\n    pub tran_id: [u8; 16],\n    pub tran_type_cd: [u8; 2],\n    pub tran_cat_cd: i64,\n    pub tran_source: [u8; 10],\n    pub tran_desc: [u8; 100],\n    pub tran_amt: i64,\n    pub tran_merchant_id: i64,\n    pub tran_merchant_name: [u8; 50],\n    pub tran_merchant_city: [u8; 50],\n    pub tran_merchant_zip: [u8; 10],\n    pub tran_card_num: [u8; 16],\n    pub tran_orig_ts: [u8; 26],\n    pub tran_proc_ts: [u8; 26],\n    pub filler1: [u8; 20],\n}\n\n#[derive(Clone, Copy)]\npub struct ExternalParms {\n    pub parm_length: i64,\n    pub parm_date: [u8; 10],\n}\n\npub struct Output {\n    pub displays: Vec<Vec<u8>>,\n    pub transact_file_writes: Vec<TranRecord>,\n    pub account_file_rewrites: Vec<AccountRecord>,\n    pub abended: bool,\n}\n\nstruct State {\n    accounts: Vec<AccountRecord>,\n    tran_cat_bal_record: TranCatBalRecord,\n    card_xref_record: CardXrefRecord,\n    dis_group_record: DisGroupRecord,\n    account_record: AccountRecord,\n    tran_record: TranRecord,\n    last_acct_set: bool,\n    last_acct: i64,\n    first_time: bool,\n    total_int: i64,\n    tranid_suffix: i64,\n}\n\nfn to_vec(s: &[u8]) -> Vec<u8> {\n    let mut v: Vec<u8> = Vec::new();\n    let mut i: usize = 0;\n    while i < s.len() {\n        v.push(s[i]);\n        i += 1;\n    }\n    v\n}\n\nfn push_bytes(v: &mut Vec<u8>, s: &[u8]) {\n    let mut i: usize = 0;\n    while i < s.len() {\n        v.push(s[i]);\n        i += 1;\n    }\n}\n\nfn eq10(a: &[u8; 10], b: &[u8; 10]) -> bool {\n    let mut eq = true;\n    let mut i: usize = 0;\n    while i < 10 {\n        if a[i] != b[i] {\n            eq = false;\n        }\n        i += 1;\n    }\n    eq\n}\n\nfn eq2(a: &[u8; 2], b: &[u8; 2]) -> bool {\n    a[0] == b[0] && a[1] == b[1]\n}\n\n// ---------------------------------------------------------------- texts\n\nfn m_start() -> Vec<u8> {\n    let a = [\n        b'S', b'T', b'A', b'R', b'T', b' ', b'O', b'F', b' ', b'E', b'X', b'E', b'C', b'U',\n        b'T', b'I', b'O', b'N', b' ', b'O', b'F', b' ', b'P', b'R', b'O', b'G', b'R', b'A',\n        b'M', b' ', b'C', b'B', b'A', b'C', b'T', b'0', b'4', b'C',\n    ];\n    to_vec(&a)\n}\n\nfn m_end() -> Vec<u8> {\n    let a = [\n        b'E', b'N', b'D', b' ', b'O', b'F', b' ', b'E', b'X', b'E', b'C', b'U', b'T', b'I',\n        b'O', b'N', b' ', b'O', b'F', b' ', b'P', b'R', b'O', b'G', b'R', b'A', b'M', b' ',\n        b'C', b'B', b'A', b'C', b'T', b'0', b'4', b'C',\n    ];\n    to_vec(&a)\n}\n\nfn m_abending() -> Vec<u8> {\n    let a = [\n        b'A', b'B', b'E', b'N', b'D', b'I', b'N', b'G', b' ', b'P', b'R', b'O', b'G', b'R',\n        b'A', b'M',\n    ];\n    to_vec(&a)\n}\n\nfn m_file_status() -> Vec<u8> {\n    let a = [\n        b'F', b'I', b'L', b'E', b' ', b'S', b'T', b'A', b'T', b'U', b'S', b' ', b'I', b'S',\n        b':', b' ', b'N', b'N', b'N', b'N',\n    ];\n    to_vec(&a)\n}\n\nfn m_err_rewrite_acct() -> Vec<u8> {\n    let a = [\n        b'E', b'R', b'R', b'O', b'R', b' ', b'R', b'E', b'-', b'W', b'R', b'I', b'T', b'I',\n        b'N', b'G', b' ', b'A', b'C', b'C', b'O', b'U', b'N', b'T', b' ', b'F', b'I', b'L',\n        b'E',\n    ];\n    to_vec(&a)\n}\n\nfn m_acct_not_found() -> Vec<u8> {\n    let a = [\n        b'A', b'C', b'C', b'O', b'U', b'N', b'T', b' ', b'N', b'O', b'T', b' ', b'F', b'O',\n        b'U', b'N', b'D', b':', b' ',\n    ];\n    to_vec(&a)\n}\n\nfn m_err_read_acct() -> Vec<u8> {\n    let a = [\n        b'E', b'R', b'R', b'O', b'R', b' ', b'R', b'E', b'A', b'D', b'I', b'N', b'G', b' ',\n        b'A', b'C', b'C', b'O', b'U', b'N', b'T', b' ', b'F', b'I', b'L', b'E',\n    ];\n    to_vec(&a)\n}\n\nfn m_err_read_xref() -> Vec<u8> {\n    let a = [\n        b'E', b'R', b'R', b'O', b'R', b' ', b'R', b'E', b'A', b'D', b'I', b'N', b'G', b' ',\n        b'X', b'R', b'E', b'F', b' ', b'F', b'I', b'L', b'E',\n    ];\n    to_vec(&a)\n}\n\nfn m_disc_missing() -> Vec<u8> {\n    let a = [\n        b'D', b'I', b'S', b'C', b'L', b'O', b'S', b'U', b'R', b'E', b' ', b'G', b'R', b'O',\n        b'U', b'P', b' ', b'R', b'E', b'C', b'O', b'R', b'D', b' ', b'M', b'I', b'S', b'S',\n        b'I', b'N', b'G',\n    ];\n    to_vec(&a)\n}\n\nfn m_try_default() -> Vec<u8> {\n    let a = [\n        b'T', b'R', b'Y', b' ', b'W', b'I', b'T', b'H', b' ', b'D', b'E', b'F', b'A', b'U',\n        b'L', b'T', b' ', b'G', b'R', b'O', b'U', b'P', b' ', b'C', b'O', b'D', b'E',\n    ];\n    to_vec(&a)\n}\n\nfn m_err_default_disc() -> Vec<u8> {\n    let a = [\n        b'E', b'R', b'R', b'O', b'R', b' ', b'R', b'E', b'A', b'D', b'I', b'N', b'G', b' ',\n        b'D', b'E', b'F', b'A', b'U', b'L', b'T', b' ', b'D', b'I', b'S', b'C', b'L', b'O',\n        b'S', b'U', b'R', b'E', b' ', b'G', b'R', b'O', b'U', b'P',\n    ];\n    to_vec(&a)\n}\n\n// ---------------------------------------------------------------- numbers\n\nfn abs_u64(val: i64) -> u64 {\n    if val < 0 {\n        ((-(val + 1)) as u64) + 1\n    } else {\n        val as u64\n    }\n}\n\nfn pow10(n: u32) -> i64 {\n    let mut p: i64 = 1;\n    let mut i: u32 = 0;\n    while i < n {\n        p = p * 10;\n        i += 1;\n    }\n    p\n}\n\n// High-order truncation to n digits, sign kept.\nfn trunc_digits(val: i64, n: u32) -> i64 {\n    val % pow10(n)\n}\n\n// Unsigned zoned display digits (n digits).\nfn digits_of(val: i64, n: usize) -> Vec<u8> {\n    let mut a = abs_u64(val);\n    let mut tmp: Vec<u8> = Vec::new();\n    let mut i: usize = 0;\n    while i < n {\n        tmp.push(b'0' + (a % 10) as u8);\n        a = a / 10;\n        i += 1;\n    }\n    let mut v: Vec<u8> = Vec::new();\n    let mut j: usize = n;\n    while j > 0 {\n        j -= 1;\n        v.push(tmp[j]);\n    }\n    v\n}\n\nfn push_digits(v: &mut Vec<u8>, val: i64, n: usize) {\n    let d = digits_of(val, n);\n    let mut i: usize = 0;\n    while i < d.len() {\n        v.push(d[i]);\n        i += 1;\n    }\n}\n\n// Signed zoned display with trailing overpunch sign.\nfn push_signed(v: &mut Vec<u8>, val: i64, n: usize) {\n    let d = digits_of(val, n);\n    let neg = val < 0;\n    let mut i: usize = 0;\n    while i < n {\n        if i + 1 == n {\n            let dg = d[i] - b'0';\n            let c = if neg {\n                if dg == 0 {\n                    b'}'\n                } else {\n                    b'J' + dg - 1\n                }\n            } else if dg == 0 {\n                b'{'\n            } else {\n                b'A' + dg - 1\n            };\n            v.push(c);\n        } else {\n            v.push(d[i]);\n        }\n        i += 1;\n    }\n}\n\nfn is_digit(b: u8) -> bool {\n    b >= b'0' && b <= b'9'\n}\n\nfn status_line(s0: u8, s1: u8) -> Vec<u8> {\n    let mut v = m_file_status();\n    let numeric = is_digit(s0) && is_digit(s1);\n    if !numeric || s0 == b'9' {\n        v.push(s0);\n        let n = (s1 as i64) % 1000;\n        push_digits(&mut v, n, 3);\n    } else {\n        v.push(b'0');\n        v.push(b'0');\n        v.push(s0);\n        v.push(s1);\n    }\n    v\n}\n\nfn abend(out: &mut Output, msg: Vec<u8>, s0: u8, s1: u8) {\n    out.displays.push(msg);\n    out.displays.push(status_line(s0, s1));\n    out.displays.push(m_abending());\n    out.abended = true;\n}\n\nfn display_tcat(r: &TranCatBalRecord) -> Vec<u8> {\n    let mut v: Vec<u8> = Vec::new();\n    push_digits(&mut v, r.trancat_acct_id, 11);\n    push_bytes(&mut v, &r.trancat_type_cd);\n    push_digits(&mut v, r.trancat_cd, 4);\n    push_signed(&mut v, r.tran_cat_bal, 11);\n    push_bytes(&mut v, &r.filler1);\n    v\n}\n\n// ---------------------------------------------------------------- lookups\n// Each returns the index of the first match, or the length when not found.\n\nfn find_account(accounts: &Vec<AccountRecord>, id: i64) -> usize {\n    let n = accounts.len();\n    let mut result: usize = n;\n    let mut i: usize = 0;\n    while i < n {\n        let r = accounts[i];\n        if result == n {\n            if r.acct_id == id {\n                result = i;\n            }\n        }\n        i += 1;\n    }\n    result\n}\n\nfn find_xref(xref_file: &[CardXrefRecord], acct_id: i64) -> usize {\n    let n = xref_file.len();\n    let mut result: usize = n;\n    let mut i: usize = 0;\n    while i < n {\n        let r = xref_file[i];\n        if result == n {\n            if r.xref_acct_id == acct_id {\n                result = i;\n            }\n        }\n        i += 1;\n    }\n    result\n}\n\nfn find_disc(\n    discgrp_file: &[DisGroupRecord],\n    group: &[u8; 10],\n    typ: &[u8; 2],\n    cat: i64,\n) -> usize {\n    let n = discgrp_file.len();\n    let mut result: usize = n;\n    let mut i: usize = 0;\n    while i < n {\n        let r = discgrp_file[i];\n        if result == n {\n            let g = r.dis_acct_group_id;\n            let t = r.dis_tran_type_cd;\n            if eq10(&g, group) {\n                if eq2(&t, typ) {\n                    if r.dis_tran_cat_cd == cat {\n                        result = i;\n                    }\n                }\n            }\n        }\n        i += 1;\n    }\n    result\n}\n\n// ---------------------------------------------------------------- paragraphs\n\n// 1050-UPDATE-ACCOUNT. Returns false if the program abended.\nfn update_account(st: &mut State, out: &mut Output) -> bool {\n    let mut a = st.account_record;\n    a.acct_curr_bal = trunc_digits(a.acct_curr_bal + st.total_int, 12);\n    a.acct_curr_cyc_credit = 0;\n    a.acct_curr_cyc_debit = 0;\n    st.account_record = a;\n    let idx = find_account(&st.accounts, a.acct_id);\n    if idx < st.accounts.len() {\n        st.accounts[idx] = a;\n        out.account_file_rewrites.push(a);\n        true\n    } else {\n        abend(out, m_err_rewrite_acct(), b'2', b'3');\n        false\n    }\n}\n\nfn make_timestamp(clock: &[u8; 21]) -> [u8; 26] {\n    let mut ts = [b' '; 26];\n    ts[0] = clock[0];\n    ts[1] = clock[1];\n    ts[2] = clock[2];\n    ts[3] = clock[3];\n    ts[4] = b'-';\n    ts[5] = clock[4];\n    ts[6] = clock[5];\n    ts[7] = b'-';\n    ts[8] = clock[6];\n    ts[9] = clock[7];\n    ts[10] = b'-';\n    ts[11] = clock[8];\n    ts[12] = clock[9];\n    ts[13] = b'.';\n    ts[14] = clock[10];\n    ts[15] = clock[11];\n    ts[16] = b'.';\n    ts[17] = clock[12];\n    ts[18] = clock[13];\n    ts[19] = b'.';\n    ts[20] = clock[14];\n    ts[21] = clock[15];\n    ts[22] = b'0';\n    ts[23] = b'0';\n    ts[24] = b'0';\n    ts[25] = b'0';\n    ts\n}\n\n// 1300-B-WRITE-TX record construction.\nfn build_tran(\n    prev: TranRecord,\n    parm_date: &[u8; 10],\n    suffix: i64,\n    acct_id: i64,\n    monthly_int: i64,\n    card_num: [u8; 16],\n    clock: &[u8; 21],\n) -> TranRecord {\n    let mut t = prev;\n    let mut tid = [b' '; 16];\n    let mut p: usize = 0;\n    while p < 10 {\n        tid[p] = parm_date[p];\n        p += 1;\n    }\n    let sd = digits_of(suffix, 6);\n    let mut q: usize = 0;\n    while q < 6 {\n        tid[10 + q] = sd[q];\n        q += 1;\n    }\n    t.tran_id = tid;\n    t.tran_type_cd = [b'0', b'1'];\n    t.tran_cat_cd = 5;\n    t.tran_source = [b'S', b'y', b's', b't', b'e', b'm', b' ', b' ', b' ', b' '];\n    let prefix = [\n        b'I', b'n', b't', b'.', b' ', b'f', b'o', b'r', b' ', b'a', b'/', b'c', b' ',\n    ];\n    let mut desc = t.tran_desc;\n    let mut x: usize = 0;\n    while x < 13 {\n        desc[x] = prefix[x];\n        x += 1;\n    }\n    let ad = digits_of(acct_id, 11);\n    let mut y: usize = 0;\n    while y < 11 {\n        desc[13 + y] = ad[y];\n        y += 1;\n    }\n    t.tran_desc = desc;\n    t.tran_amt = monthly_int;\n    t.tran_merchant_id = 0;\n    t.tran_merchant_name = [b' '; 50];\n    t.tran_merchant_city = [b' '; 50];\n    t.tran_merchant_zip = [b' '; 10];\n    t.tran_card_num = card_num;\n    let ts = make_timestamp(clock);\n    t.tran_orig_ts = ts;\n    t.tran_proc_ts = ts;\n    t\n}\n\n// Processing of one TCATBAL record. Returns false if the program abended.\nfn process_record(\n    st: &mut State,\n    xref_file: &[CardXrefRecord],\n    discgrp_file: &[DisGroupRecord],\n    parms: &ExternalParms,\n    clock: &[u8; 21],\n    out: &mut Output,\n) -> bool {\n    let rec = st.tran_cat_bal_record;\n    out.displays.push(display_tcat(&rec));\n    if !st.last_acct_set || rec.trancat_acct_id != st.last_acct {\n        if st.first_time {\n            st.first_time = false;\n        } else {\n            if !update_account(st, out) {\n                return false;\n            }\n        }\n        st.total_int = 0;\n        st.last_acct = rec.trancat_acct_id;\n        st.last_acct_set = true;\n        // 1100-GET-ACCT-DATA\n        let fd_acct_id = rec.trancat_acct_id;\n        let idx = find_account(&st.accounts, fd_acct_id);\n        if idx >= st.accounts.len() {\n            let mut v = m_acct_not_found();\n            push_digits(&mut v, fd_acct_id, 11);\n            out.displays.push(v);\n            abend(out, m_err_read_acct(), b'2', b'3');\n            return false;\n        }\n        st.account_record = st.accounts[idx];\n        // 1110-GET-XREF-DATA\n        let fd_xref_acct_id = rec.trancat_acct_id;\n        let xidx = find_xref(xref_file, fd_xref_acct_id);\n        if xidx >= xref_file.len() {\n            let mut v = m_acct_not_found();\n            push_digits(&mut v, fd_xref_acct_id, 11);\n            out.displays.push(v);\n            abend(out, m_err_read_xref(), b'2', b'3');\n            return false;\n        }\n        st.card_xref_record = xref_file[xidx];\n    }\n    // 1200-GET-INTEREST-RATE\n    let group = st.account_record.acct_group_id;\n    let typ = rec.trancat_type_cd;\n    let cat = rec.trancat_cd;\n    let didx = find_disc(discgrp_file, &group, &typ, cat);\n    if didx < discgrp_file.len() {\n        st.dis_group_record = discgrp_file[didx];\n    } else {\n        out.displays.push(m_disc_missing());\n        out.displays.push(m_try_default());\n        let def = [b'D', b'E', b'F', b'A', b'U', b'L', b'T', b' ', b' ', b' '];\n        // 1200-A-GET-DEFAULT-INT-RATE\n        let didx2 = find_disc(discgrp_file, &def, &typ, cat);\n        if didx2 >= discgrp_file.len() {\n            abend(out, m_err_default_disc(), b'2', b'3');\n            return false;\n        }\n        st.dis_group_record = discgrp_file[didx2];\n    }\n    if st.dis_group_record.dis_int_rate != 0 {\n        // 1300-COMPUTE-INTEREST\n        let monthly_int = trunc_digits(\n            (rec.tran_cat_bal * st.dis_group_record.dis_int_rate) / 120000,\n            11,\n        );\n        st.total_int = trunc_digits(st.total_int + monthly_int, 11);\n        // 1300-B-WRITE-TX\n        st.tranid_suffix = (st.tranid_suffix + 1) % 1000000;\n        let t = build_tran(\n            st.tran_record,\n            &parms.parm_date,\n            st.tranid_suffix,\n            st.account_record.acct_id,\n            monthly_int,\n            st.card_xref_record.xref_card_num,\n            clock,\n        );\n        st.tran_record = t;\n        out.transact_file_writes.push(t);\n        // 1400-COMPUTE-FEES: not implemented\n    }\n    true\n}\n\npub fn run(\n    tcatbal_file: &[TranCatBalRecord],\n    xref_file: &[CardXrefRecord],\n    account_file: &[AccountRecord],\n    discgrp_file: &[DisGroupRecord],\n    external_parms: &ExternalParms,\n    clock: &[u8; 21],\n) -> Output {\n    let mut out = Output {\n        displays: Vec::new(),\n        transact_file_writes: Vec::new(),\n        account_file_rewrites: Vec::new(),\n        abended: false,\n    };\n\n    let mut accounts: Vec<AccountRecord> = Vec::new();\n    let mut k: usize = 0;\n    while k < account_file.len() {\n        accounts.push(account_file[k]);\n        k += 1;\n    }\n\n    let mut st = State {\n        accounts: accounts,\n        tran_cat_bal_record: TranCatBalRecord {\n            trancat_acct_id: 0,\n            trancat_type_cd: [b' '; 2],\n            trancat_cd: 0,\n            tran_cat_bal: 0,\n            filler1: [b' '; 22],\n        },\n        card_xref_record: CardXrefRecord {\n            xref_card_num: [b' '; 16],\n            xref_cust_id: 0,\n            xref_acct_id: 0,\n            filler1: [b' '; 14],\n        },\n        dis_group_record: DisGroupRecord {\n            dis_acct_group_id: [b' '; 10],\n            dis_tran_type_cd: [b' '; 2],\n            dis_tran_cat_cd: 0,\n            dis_int_rate: 0,\n            filler1: [b' '; 28],\n        },\n        account_record: AccountRecord {\n            acct_id: 0,\n            acct_active_status: [b' '; 1],\n            acct_curr_bal: 0,\n            acct_credit_limit: 0,\n            acct_cash_credit_limit: 0,\n            acct_open_date: [b' '; 10],\n            acct_expiraion_date: [b' '; 10],\n            acct_reissue_date: [b' '; 10],\n            acct_curr_cyc_credit: 0,\n            acct_curr_cyc_debit: 0,\n            acct_addr_zip: [b' '; 10],\n            acct_group_id: [b' '; 10],\n            filler1: [b' '; 178],\n        },\n        tran_record: TranRecord {\n            tran_id: [b' '; 16],\n            tran_type_cd: [b' '; 2],\n            tran_cat_cd: 0,\n            tran_source: [b' '; 10],\n            tran_desc: [b' '; 100],\n            tran_amt: 0,\n            tran_merchant_id: 0,\n            tran_merchant_name: [b' '; 50],\n            tran_merchant_city: [b' '; 50],\n            tran_merchant_zip: [b' '; 10],\n            tran_card_num: [b' '; 16],\n            tran_orig_ts: [b' '; 26],\n            tran_proc_ts: [b' '; 26],\n            filler1: [b' '; 20],\n        },\n        last_acct_set: false,\n        last_acct: 0,\n        first_time: true,\n        total_int: 0,\n        tranid_suffix: 0,\n    };\n\n    out.displays.push(m_start());\n    // All OPENs succeed.\n\n    let mut end_of_file = false;\n    let mut stop = false;\n    let mut pos: usize = 0;\n    while !end_of_file && !stop {\n        // 1000-TCATBALF-GET-NEXT\n        if pos < tcatbal_file.len() {\n            st.tran_cat_bal_record = tcatbal_file[pos];\n            pos += 1;\n            if !process_record(\n                &mut st,\n                xref_file,\n                discgrp_file,\n                external_parms,\n                clock,\n                &mut out,\n            ) {\n                stop = true;\n            }\n        } else {\n            end_of_file = true;\n        }\n    }\n\n    if !stop {\n        // All CLOSEs succeed.\n        out.displays.push(m_end());\n    }\n    out\n}"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":12,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":13,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/ptr/mod.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"regions_outlive":[]