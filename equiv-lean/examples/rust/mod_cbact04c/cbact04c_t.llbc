account_file: &[AccountRecord],\n    discgrp_file: &[DisGroupRecord],\n    external_parms: &ExternalParms,\n    clock: &[u8; 21],\n) -> Output {\n    let mut out = Output {\n        displays: Vec::new(),\n        transact_file_writes: Vec::new(),\n        account_file_rewrites: Vec::new(),\n        abended: false,\n    };\n\n    let mut accounts: Vec<AccountRecord> = Vec::new();\n    let mut k: usize = 0;\n    while k < account_file.len() {\n        accounts.push(account_file[k]);\n        k += 1;\n    }\n\n    let mut st = State {\n        accounts: accounts,\n        tran_cat_bal_record: TranCatBalRecord {\n            trancat_acct_id: 0,\n            trancat_type_cd: [b' '; 2],\n            trancat_cd: 0,\n            tran_cat_bal: 0,\n            filler1: [b' '; 22],\n        },\n        card_xref_record: CardXrefRecord {\n            xref_card_num: [b' '; 16],\n            xref_cust_id: 0,\n            xref_acct_id: 0,\n            filler1: [b' '; 14],\n        },\n        dis_group_record: DisGroupRecord {\n            dis_acct_group_id: [b' '; 10],\n            dis_tran_type_cd: [b' '; 2],\n            dis_tran_cat_cd: 0,\n            dis_int_rate: 0,\n            filler1: [b' '; 28],\n        },\n        account_record: AccountRecord {\n            acct_id: 0,\n            acct_active_status: [b' '; 1],\n            acct_curr_bal: 0,\n            acct_credit_limit: 0,\n            acct_cash_credit_limit: 0,\n            acct_open_date: [b' '; 10],\n            acct_expiraion_date: [b' '; 10],\n            acct_reissue_date: [b' '; 10],\n            acct_curr_cyc_credit: 0,\n            acct_curr_cyc_debit: 0,\n            acct_addr_zip: [b' '; 10],\n            acct_group_id: [b' '; 10],\n            filler1: [b' '; 178],\n        },\n        tran_record: TranRecord {\n            tran_id: [b' '; 16],\n            tran_type_cd: [b' '; 2],\n            tran_cat_cd: 0,\n            tran_source: [b' '; 10],\n            tran_desc: [b' '; 100],\n            tran_amt: 0,\n            tran_merchant_id: 0,\n            tran_merchant_name: [b' '; 50],\n            tran_merchant_city: [b' '; 50],\n            tran_merchant_zip: [b' '; 10],\n            tran_card_num: [b' '; 16],\n            tran_orig_ts: [b' '; 26],\n            tran_proc_ts: [b' '; 26],\n            filler1: [b' '; 20],\n        },\n        last_acct_set: false,\n        last_acct: 0,\n        first_time: true,\n        total_int: 0,\n        tranid_suffix: 0,\n    };\n\n    out.displays.push(m_start());\n    // All OPENs succeed.\n\n    let mut end_of_file = false;\n    let mut stop = false;\n    let mut pos: usize = 0;\n    while !end_of_file && !stop {\n        // 1000-TCATBALF-GET-NEXT\n        if pos < tcatbal_file.len() {\n            st.tran_cat_bal_record = tcatbal_file[pos];\n            pos += 1;\n            if !process_record(\n                &mut st,\n                xref_file,\n                discgrp_file,\n                external_parms,\n                clock,\n                &mut out,\n            ) {\n                stop = true;\n            }\n        } else {\n            end_of_file = true;\n        }\n    }\n\n    if !stop {\n        // All CLOSEs succeed.\n        out.displays.push(m_end());\n    }\n    out\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":4,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":5,"name":null,"variance":"Covariant","mutability":"Un