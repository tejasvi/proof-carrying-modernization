omerRecord> = None;\n            if at_eof {\n                status = [b'4', b'6'];\n            } else if pos < custfile_file.len() {\n                rec = Some(custfile_file[pos]);\n                pos += 1;\n                status = [b'0', b'0'];\n            } else {\n                at_eof = true;\n                status = [b'1', b'0'];\n            }\n            let appl_result: i64;\n            if status[0] == b'0' && status[1] == b'0' {\n                appl_result = 0;\n                if let Some(r) = rec {\n                    displays.push(customer_display(&r));\n                }\n            } else if status[0] == b'1' && status[1] == b'0' {\n                appl_result = 16;\n            } else {\n                appl_result = 12;\n            }\n            if appl_result == 0 {\n                // continue\n            } else if appl_result == 16 {\n                end_of_file = b'Y';\n            } else {\n                displays.push(lit(b\"ERROR READING CUSTOMER FILE\"));\n                z_display_io_status(&mut displays, status);\n                z_abend_program(&mut displays);\n                return Output {\n                    displays,\n                    abended: true,\n                };\n            }\n            if end_of_file == b'N' {\n                if let Some(r) = rec {\n                    displays.push(customer_display(&r));\n                }\n            }\n        }\n    }\n\n    // 9000-CUSTFILE-CLOSE: CLOSE succeeds with status '00'.\n\n    displays.push(lit(b\"END OF EXECUTION OF PROGRAM CBCUS01C\"));\n    Output {\n        displays,\n        abended: false,\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[]