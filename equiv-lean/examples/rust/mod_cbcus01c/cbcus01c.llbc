{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"cbcus01c","contents":"#[derive(Clone, Copy)]\npub struct CustomerRecord {\n    pub cust_id: i64,\n    pub cust_first_name: [u8; 25],\n    pub cust_middle_name: [u8; 25],\n    pub cust_last_name: [u8; 25],\n    pub cust_addr_line_1: [u8; 50],\n    pub cust_addr_line_2: [u8; 50],\n    pub cust_addr_line_3: [u8; 50],\n    pub cust_addr_state_cd: [u8; 2],\n    pub cust_addr_country_cd: [u8; 3],\n    pub cust_addr_zip: [u8; 10],\n    pub cust_phone_num_1: [u8; 15],\n    pub cust_phone_num_2: [u8; 15],\n    pub cust_ssn: i64,\n    pub cust_govt_issued_id: [u8; 20],\n    pub cust_dob_yyyy_mm_dd: [u8; 10],\n    pub cust_eft_account_id: [u8; 10],\n    pub cust_pri_card_holder_ind: [u8; 1],\n    pub cust_fico_credit_score: i64,\n    pub filler1: [u8; 168],\n}\n\npub struct Output {\n    pub displays: Vec<Vec<u8>>,\n    pub abended: bool,\n}\n\nfn push_bytes(out: &mut Vec<u8>, b: &[u8]) {\n    let mut i = 0;\n    while i < b.len() {\n        out.push(b[i]);\n        i += 1;\n    }\n}\n\nfn magnitude(v: i64) -> u64 {\n    if v < 0 {\n        ((-(v + 1)) as u64) + 1\n    } else {\n        v as u64\n    }\n}\n\n// Unsigned zoned decimal display of `digits` digits (magnitude, truncated on the left).\nfn push_unsigned(out: &mut Vec<u8>, v: i64, digits: usize) {\n    let mut u = magnitude(v);\n    let mut buf: [u8; 20] = [b'0'; 20];\n    let mut i = 0;\n    while i < digits {\n        buf[digits - 1 - i] = b'0' + (u % 10) as u8;\n        u /= 10;\n        i += 1;\n    }\n    let mut j = 0;\n    while j < digits {\n        out.push(buf[j]);\n        j += 1;\n    }\n}\n\nfn customer_display(r: &CustomerRecord) -> Vec<u8> {\n    let mut d: Vec<u8> = Vec::new();\n    push_unsigned(&mut d, r.cust_id, 9);\n    push_bytes(&mut d, &r.cust_first_name);\n    push_bytes(&mut d, &r.cust_middle_name);\n    push_bytes(&mut d, &r.cust_last_name);\n    push_bytes(&mut d, &r.cust_addr_line_1);\n    push_bytes(&mut d, &r.cust_addr_line_2);\n    push_bytes(&mut d, &r.cust_addr_line_3);\n    push_bytes(&mut d, &r.cust_addr_state_cd);\n    push_bytes(&mut d, &r.cust_addr_country_cd);\n    push_bytes(&mut d, &r.cust_addr_zip);\n    push_bytes(&mut d, &r.cust_phone_num_1);\n    push_bytes(&mut d, &r.cust_phone_num_2);\n    push_unsigned(&mut d, r.cust_ssn, 9);\n    push_bytes(&mut d, &r.cust_govt_issued_id);\n    push_bytes(&mut d, &r.cust_dob_yyyy_mm_dd);\n    push_bytes(&mut d, &r.cust_eft_account_id);\n    push_bytes(&mut d, &r.cust_pri_card_holder_ind);\n    push_unsigned(&mut d, r.cust_fico_credit_score, 3);\n    push_bytes(&mut d, &r.filler1);\n    d\n}\n\nfn lit(s: &[u8]) -> Vec<u8> {\n    let mut v: Vec<u8> = Vec::new();\n    push_bytes(&mut v, s);\n    v\n}\n\nfn is_digit(b: u8) -> bool {\n    b >= b'0' && b <= b'9'\n}\n\nfn z_display_io_status(displays: &mut Vec<Vec<u8>>, io_status: [u8; 2]) {\n    let mut st04: [u8; 4] = [b'0'; 4];\n    if !(is_digit(io_status[0]) && is_digit(io_status[1])) || io_status[0] == b'9' {\n        st04[0] = io_status[0];\n        let bin: u64 = io_status[1] as u64;\n        let v = bin % 1000;\n        st04[1] = b'0' + ((v / 100) % 10) as u8;\n        st04[2] = b'0' + ((v / 10) % 10) as u8;\n        st04[3] = b'0' + (v % 10) as u8;\n    } else {\n        st04[0] = b'0';\n        st04[1] = b'0';\n        st04[2] = io_status[0];\n        st04[3] = io_status[1];\n    }\n    let mut d = lit(b\"FILE STATUS IS: NNNN\");\n    push_bytes(&mut d, &st04);\n    displays.push(d);\n}\n\nfn z_abend_program(displays: &mut Vec<Vec<u8>>) {\n    displays.push(lit(b\"ABENDING PROGRAM\"));\n}\n\npub fn run(custfile_file: &[CustomerRecord]) -> Output {\n    let mut displays: Vec<Vec<u8>> = Vec::new();\n    displays.push(lit(b\"START OF EXECUTION OF PROGRAM CBCUS01C\"));\n\n    // 0000-CUSTFILE-OPEN: OPEN succeeds with status '00'.\n    let mut pos: usize = 0;\n    let mut at_eof = false;\n    let mut end_of_file: u8 = b'N';\n\n    while end_of_file != b'Y' {\n        if end_of_file == b'N' {\n            // 1000-CUSTFILE-GET-NEXT\n            let status: [u8; 2];\n            let mut rec: Option<CustomerRecord> = None;\n            if at_eof {\n                status = [b'4', b'6'];\n            } else if pos < custfile_file.len() {\n                rec = Some(custfile_file[pos]);\n                pos += 1;\n                status = [b'0', b'0'];\n            } else {\n                at_eof = true;\n                status = [b'1', b'0'];\n            }\n            let appl_result: i64;\n            if status[0] == b'0' && status[1] == b'0' {\n                appl_result = 0;\n                if let Some(r) = rec {\n                    displays.push(customer_display(&r));\n                }\n            } else if status[0] == b'1' && status[1] == b'0' {\n                appl_result = 16;\n            } else {\n                appl_result = 12;\n            }\n            if appl_result == 0 {\n                // continue\n            } else if appl_result == 16 {\n                end_of_file = b'Y';\n            } else {\n                displays.push(lit(b\"ERROR READING CUSTOMER FILE\"));\n                z_display_io_status(&mut displays, status);\n                z_abend_program(&mut displays);\n                return Output {\n                    displays,\n                    abended: true,\n                };\n            }\n            if end_of_file == b'N' {\n                if let Some(r) = rec {\n                    displays.push(customer_display(&r));\n                }\n            }\n        }\n    }\n\n    // 9000-CUSTFILE-CLOSE: CLOSE succeeds with status '00'.\n\n    displays.push(lit(b\"END OF EXECUTION OF PROGRAM CBCUS01C\"));\n    Output {\n        displays,\n        abended: false,\n    }\n}"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":12,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":13,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"In