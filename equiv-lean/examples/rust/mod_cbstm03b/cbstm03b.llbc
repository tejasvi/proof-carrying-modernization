{"charon_version":"0.1.293","translated":{"crate_name":"cbstm03b","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"cbstm03b","contents":"#[derive(Clone, Copy)]\npub struct FdTrnxfileRec {\n    pub fd_trnx_card: [u8; 16],\n    pub fd_trnx_id: [u8; 16],\n    pub fd_acct_data: [u8; 318],\n}\n\n#[derive(Clone, Copy)]\npub struct FdXreffileRec {\n    pub fd_xref_card_num: [u8; 16],\n    pub fd_xref_data: [u8; 34],\n}\n\n#[derive(Clone, Copy)]\npub struct FdCustfileRec {\n    pub fd_cust_id: [u8; 9],\n    pub fd_cust_data: [u8; 491],\n}\n\n#[derive(Clone, Copy)]\npub struct FdAcctfileRec {\n    pub fd_acct_id: i64,\n    pub fd_acct_data: [u8; 289],\n}\n\n#[derive(Clone, Copy)]\npub struct LkM03bArea {\n    pub lk_m03b_dd: [u8; 8],\n    pub lk_m03b_oper: [u8; 1],\n    pub lk_m03b_rc: [u8; 2],\n    pub lk_m03b_key: [u8; 25],\n    pub lk_m03b_key_ln: i64,\n    pub lk_m03b_fldt: [u8; 1000],\n}\n\npub struct TrnxFile {\n    pub open: bool,\n    pub recs: Vec<FdTrnxfileRec>,\n    pub pos: usize,\n    pub eof: bool,\n}\n\npub struct XrefFile {\n    pub open: bool,\n    pub recs: Vec<FdXreffileRec>,\n    pub pos: usize,\n    pub eof: bool,\n}\n\npub struct CustFile {\n    pub open: bool,\n    pub recs: Vec<FdCustfileRec>,\n    pub pos: usize,\n    pub eof: bool,\n}\n\npub struct AcctFile {\n    pub open: bool,\n    pub recs: Vec<FdAcctfileRec>,\n    pub pos: usize,\n    pub eof: bool,\n}\n\npub struct State {\n    pub trnx_file: TrnxFile,\n    pub xref_file: XrefFile,\n    pub cust_file: CustFile,\n    pub acct_file: AcctFile,\n    pub fd_trnxfile_rec: FdTrnxfileRec,\n    pub fd_xreffile_rec: FdXreffileRec,\n    pub fd_custfile_rec: FdCustfileRec,\n    pub fd_acctfile_rec: FdAcctfileRec,\n    pub trnxfile_status: [u8; 2],\n    pub xreffile_status: [u8; 2],\n    pub custfile_status: [u8; 2],\n    pub acctfile_status: [u8; 2],\n}\n\nconst ACCT_MOD: i64 = 100_000_000_000;\nconst NO_ERR: u8 = 255;\n\nfn fmt_status(c: u8) -> [u8; 2] {\n    [b'0' + (c / 10) % 10, b'0' + c % 10]\n}\n\nfn open_err_code(err: Option<u8>) -> u8 {\n    match err {\n        Some(c) => c,\n        None => NO_ERR,\n    }\n}\n\nfn eq8(a: [u8; 8], b: [u8; 8]) -> bool {\n    let mut eq = true;\n    let mut i: usize = 0;\n    while i < 8 {\n        if a[i] != b[i] {\n            eq = false;\n        }\n        i += 1;\n    }\n    eq\n}\n\nfn eq9(a: [u8; 9], b: [u8; 9]) -> bool {\n    let mut eq = true;\n    let mut i: usize = 0;\n    while i < 9 {\n        if a[i] != b[i] {\n            eq = false;\n        }\n        i += 1;\n    }\n    eq\n}\n\n/// Display form of LK-M03B-KEY-LN (PIC S9(4)), sign overpunched in the last digit.\nfn key_ln_display(v: i64) -> [u8; 4] {\n    let neg = v < 0;\n    let mut a = if neg { 0 - v } else { v };\n    a = a % 10000;\n    let mut out = [b'0'; 4];\n    let mut i: usize = 4;\n    while i > 0 {\n        i -= 1;\n        out[i] = b'0' + (a % 10) as u8;\n        a = a / 10;\n    }\n    let d = out[3] - b'0';\n    if neg {\n        if d == 0 {\n            out[3] = b'}';\n        } else {\n            out[3] = b'J' + (d - 1);\n        }\n    } else {\n        if d == 0 {\n            out[3] = b'{';\n        } else {\n            out[3] = b'A' + (d - 1);\n        }\n    }\n    out\n}\n\n/// Byte at offset i starting from LK-M03B-KEY in the linkage area.\nfn key_byte(area: &LkM03bArea, i: usize) -> u8 {\n    if i < 25 {\n        area.lk_m03b_key[i]\n    } else if i < 29 {\n        let d = key_ln_display(area.lk_m03b_key_ln);\n        d[i - 25]\n    } else if i < 1029 {\n        area.lk_m03b_fldt[i - 29]\n    } else {\n        b' '\n    }\n}\n\n/// MOVE LK-M03B-KEY (1:LK-M03B-KEY-LN) TO FD-CUST-ID\nfn cust_key(area: &LkM03bArea) -> [u8; 9] {\n    let k = area.lk_m03b_key_ln as usize;\n    let mut id = [b' '; 9];\n    let mut j: usize = 0;\n    while j < 9 {\n        if j < k {\n            id[j] = key_byte(area, j);\n        }\n        j += 1;\n    }\n    id\n}\n\n/// MOVE LK-M03B-KEY (1:LK-M03B-KEY-LN) TO FD-ACCT-ID\nfn acct_key(area: &LkM03bArea) -> i64 {\n    let k = area.lk_m03b_key_ln as usize;\n    let start = if k > 11 { k - 11 } else { 0 };\n    let mut val: i64 = 0;\n    let mut i = start;\n    while i < k {\n        let b = key_byte(area, i);\n        let d = (b & 0x0F) as i64;\n        val = (val * 10 + d) % ACCT_MOD;\n        i += 1;\n    }\n    val\n}\n\nfn cust_id_at(recs: &Vec<FdCustfileRec>, i: usize) -> [u8; 9] {\n    recs[i].fd_cust_id\n}\n\nfn acct_id_at(recs: &Vec<FdAcctfileRec>, i: usize) -> i64 {\n    recs[i].fd_acct_id\n}\n\n/// Returns index of first match, or recs.len() if none.\nfn find_cust(recs: &Vec<FdCustfileRec>, id: [u8; 9]) -> usize {\n    let n = recs.len();\n    let mut idx: usize = n;\n    let mut i: usize = 0;\n    while i < n {\n        if idx == n {\n            let k = cust_id_at(recs, i);\n            if eq9(k, id) {\n                idx = i;\n            }\n        }\n        i += 1;\n    }\n    idx\n}\n\n/// Returns index of first match, or recs.len() if none.\nfn find_acct(recs: &Vec<FdAcctfileRec>, key: i64) -> usize {\n    let n = recs.len();\n    let mut idx: usize = n;\n    let mut i: usize = 0;\n    while i < n {\n        if idx == n {\n            let k = acct_id_at(recs, i);\n            if k == key {\n                idx = i;\n            }\n        }\n        i += 1;\n    }\n    idx\n}\n\nfn trnx_image(r: &FdTrnxfileRec) -> [u8; 1000] {\n    let mut out = [b' '; 1000];\n    let mut i: usize = 0;\n    while i < 16 {\n        out[i] = r.fd_trnx_card[i];\n        i += 1;\n    }\n    i = 0;\n    while i < 16 {\n        out[16 + i] = r.fd_trnx_id[i];\n        i += 1;\n    }\n    i = 0;\n    while i < 318 {\n        out[32 + i] = r.fd_acct_data[i];\n        i += 1;\n    }\n    out\n}\n\nfn xref_image(r: &FdXreffileRec) -> [u8; 1000] {\n    let mut out = [b' '; 1000];\n    let mut i: usize = 0;\n    while i < 16 {\n        out[i] = r.fd_xref_card_num[i];\n        i += 1;\n    }\n    i = 0;\n    while i < 34 {\n        out[16 + i] = r.fd_xref_data[i];\n        i += 1;\n    }\n    out\n}\n\nfn cust_image(r: &FdCustfileRec) -> [u8; 1000] {\n    let mut out = [b' '; 1000];\n    let mut i: usize = 0;\n    while i < 9 {\n        out[i] = r.fd_cust_id[i];\n        i += 1;\n    }\n    i = 0;\n    while i < 491 {\n        out[9 + i] = r.fd_cust_data[i];\n        i += 1;\n    }\n    out\n}\n\nfn acct_image(r: &FdAcctfileRec) -> [u8; 1000] {\n    let mut out = [b' '; 1000];\n    let mut v = r.fd_acct_id % ACCT_MOD;\n    if v < 0 {\n        v = 0 - v;\n    }\n    let mut i: usize = 11;\n    while i > 0 {\n        i -= 1;\n        out[i] = b'0' + (v % 10) as u8;\n        v = v / 10;\n    }\n    i = 0;\n    while i < 289 {\n        out[11 + i] = r.fd_acct_data[i];\n        i += 1;\n    }\n    out\n}\n\nfn trnx_proc(err_code: u8, st: &mut State, area: &mut LkM03bArea) {\n    let op = area.lk_m03b_oper[0];\n    if op == b'O' {\n        let mut s: [u8; 2] = *b\"00\";\n        if st.trnx_file.open {\n            s = *b\"41\";\n        } else if err_code != NO_ERR {\n            s = fmt_status(err_code);\n        } else {\n            st.trnx_file.open = true;\n            st.trnx_file.pos = 0;\n            st.trnx_file.eof = false;\n        }\n        st.trnxfile_status = s;\n    } else if op == b'R' {\n        let mut s: [u8; 2] = *b\"00\";\n        if !st.trnx_file.open {\n            s = *b\"47\";\n        } else if st.trnx_file.eof {\n            s = *b\"46\";\n        } else if st.trnx_file.pos >= st.trnx_file.recs.len() {\n            st.trnx_file.eof = true;\n            s = *b\"10\";\n        } else {\n            let r = st.trnx_file.recs[st.trnx_file.pos];\n            st.trnx_file.pos += 1;\n            st.fd_trnxfile_rec = r;\n            area.lk_m03b_fldt = trnx_image(&r);\n        }\n        st.trnxfile_status = s;\n    } else if op == b'C' {\n        let mut s: [u8; 2] = *b\"00\";\n        if !st.trnx_file.open {\n            s = *b\"42\";\n        } else {\n            st.trnx_file.open = false;\n        }\n        st.trnxfile_status = s;\n    }\n    area.lk_m03b_rc = st.trnxfile_status;\n}\n\nfn xref_proc(err_code: u8, st: &mut State, area: &mut LkM03bArea) {\n    let op = area.lk_m03b_oper[0];\n    if op == b'O' {\n        let mut s: [u8; 2] = *b\"00\";\n        if st.xref_file.open {\n            s = *b\"41\";\n        } else if err_code != NO_ERR {\n            s = fmt_status(err_code);\n        } else {\n            st.xref_file.open = true;\n            st.xref_file.pos = 0;\n            st.xref_file.eof = false;\n        }\n        st.xreffile_status = s;\n    } else if op == b'R' {\n        let mut s: [u8; 2] = *b\"00\";\n        if !st.xref_file.open {\n            s = *b\"47\";\n        } else if st.xref_file.eof {\n            s = *b\"46\";\n        } else if st.xref_file.pos >= st.xref_file.recs.len() {\n            st.xref_file.eof = true;\n            s = *b\"10\";\n        } else {\n            let r = st.xref_file.recs[st.xref_file.pos];\n            st.xref_file.pos += 1;\n            st.fd_xreffile_rec = r;\n            area.lk_m03b_fldt = xref_image(&r);\n        }\n        st.xreffile_status = s;\n    } else if op == b'C' {\n        let mut s: [u8; 2] = *b\"00\";\n        if !st.xref_file.open {\n            s = *b\"42\";\n        } else {\n            st.xref_file.open = false;\n        }\n        st.xreffile_status = s;\n    }\n    area.lk_m03b_rc = st.xreffile_status;\n}\n\nfn cust_proc(err_code: u8, st: &mut State, area: &mut LkM03bArea) {\n    let op = area.lk_m03b_oper[0];\n    if op == b'O' {\n        let mut s: [u8; 2] = *b\"00\";\n        if st.cust_file.open {\n            s = *b\"41\";\n        } else if err_code != NO_ERR {\n            s = fmt_status(err_code);\n        } else {\n            st.cust_file.open = true;\n            st.cust_file.pos = 0;\n            st.cust_file.eof = false;\n        }\n        st.custfile_status = s;\n    } else if op == b'K' {\n        let id = cust_key(area);\n        st.fd_custfile_rec.fd_cust_id = id;\n        let mut s: [u8; 2] = *b\"00\";\n        if !st.cust_file.open {\n            s = *b\"47\";\n        } else {\n            let n = st.cust_file.recs.len();\n            let idx = find_cust(&st.cust_file.recs, id);\n            if idx >= n {\n                s = *b\"23\";\n            } else {\n                let r = st.cust_file.recs[idx];\n                st.cust_file.pos = idx + 1;\n                st.cust_file.eof = false;\n                st.fd_custfile_rec = r;\n                area.lk_m03b_fldt = cust_image(&r);\n            }\n        }\n        st.custfile_status = s;\n    } else if op == b'C' {\n        let mut s: [u8; 2] = *b\"00\";\n        if !st.cust_file.open {\n            s = *b\"42\";\n        } else {\n            st.cust_file.open = false;\n        }\n        st.custfile_status = s;\n    }\n    area.lk_m03b_rc = st.custfile_status;\n}\n\nfn acct_proc(err_code: u8, st: &mut State, area: &mut LkM03bArea) {\n    let op = area.lk_m03b_oper[0];\n    if op == b'O' {\n        let mut s: [u8; 2] = *b\"00\";\n        if st.acct_file.open {\n            s = *b\"41\";\n        } else if err_code != NO_ERR {\n            s = fmt_status(err_code);\n        } else {\n            st.acct_file.open = true;\n            st.acct_file.pos = 0;\n            st.acct_file.eof = false;\n        }\n        st.acctfile_status = s;\n    } else if op == b'K' {\n        let val = acct_key(area);\n        st.fd_acctfile_rec.fd_acct_id = val;\n        let mut s: [u8; 2] = *b\"00\";\n        if !st.acct_file.open {\n            s = *b\"47\";\n        } else {\n            let n = st.acct_file.recs.len();\n            let idx = find_acct(&st.acct_file.recs, val);\n            if idx >= n {\n                s = *b\"23\";\n            } else {\n                let r = st.acct_file.recs[idx];\n                st.acct_file.pos = idx + 1;\n                st.acct_file.eof = false;\n                st.fd_acctfile_rec = r;\n                area.lk_m03b_fldt = acct_image(&r);\n            }\n        }\n        st.acctfile_status = s;\n    } else if op == b'C' {\n        let mut s: [u8; 2] = *b\"00\";\n        if !st.acct_file.open {\n            s = *b\"42\";\n        } else {\n            st.acct_file.open = false;\n        }\n        st.acctfile_status = s;\n    }\n    area.lk_m03b_rc = st.acctfile_status;\n}\n\npub fn call(open_errors: &[Option<u8>; 4], st: &mut State, area: &mut LkM03bArea) {\n    let dd = area.lk_m03b_dd;\n    let trnx: [u8; 8] = [b'T', b'R', b'N', b'X', b'F', b'I', b'L', b'E'];\n    let xref: [u8; 8] = [b'X', b'R', b'E', b'F', b'F', b'I', b'L', b'E'];\n    let cust: [u8; 8] = [b'C', b'U', b'S', b'T', b'F', b'I', b'L', b'E'];\n    let acct: [u8; 8] = [b'A', b'C', b'C', b'T', b'F', b'I', b'L', b'E'];\n    if eq8(dd, trnx) {\n        let e: Option<u8> = open_errors[0];\n        let c = open_err_code(e);\n        trnx_proc(c, st, area);\n    } else if eq8(dd, xref) {\n        let e: Option<u8> = open_errors[1];\n        let c = open_err_code(e);\n        xref_proc(c, st, area);\n    } else if eq8(dd, cust) {\n        let e: Option<u8> = open_errors[2];\n        let c = open_err_code(e);\n        cust_proc(c, st, area);\n    } else if eq8(dd, acct) {\n        let e: Option<u8> = open_errors[3];\n        let c = open_err_code(e);\n        acct_proc(c, st, area);\n    }\n}"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":nul