{"charon_version":"0.1.293","translated":{"crate_name":"cbtrn01c","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"cbtrn01c","contents":"#[derive(Clone, Copy)]\npub struct DalytranRecord {\n    pub dalytran_id: [u8; 16],\n    pub dalytran_type_cd: [u8; 2],\n    pub dalytran_cat_cd: i64,\n    pub dalytran_source: [u8; 10],\n    pub dalytran_desc: [u8; 100],\n    pub dalytran_amt: i64,\n    pub dalytran_merchant_id: i64,\n    pub dalytran_merchant_name: [u8; 50],\n    pub dalytran_merchant_city: [u8; 50],\n    pub dalytran_merchant_zip: [u8; 10],\n    pub dalytran_card_num: [u8; 16],\n    pub dalytran_orig_ts: [u8; 26],\n    pub dalytran_proc_ts: [u8; 26],\n    pub filler1: [u8; 20],\n}\n\n#[derive(Clone, Copy)]\npub struct FdCustfileRec {\n    pub fd_cust_id: i64,\n    pub fd_cust_data: [u8; 491],\n}\n\n#[derive(Clone, Copy)]\npub struct CardXrefRecord {\n    pub xref_card_num: [u8; 16],\n    pub xref_cust_id: i64,\n    pub xref_acct_id: i64,\n    pub filler1: [u8; 14],\n}\n\n#[derive(Clone, Copy)]\npub struct FdCardfileRec {\n    pub fd_card_num: [u8; 16],\n    pub fd_card_data: [u8; 134],\n}\n\n#[derive(Clone, Copy)]\npub struct AccountRecord {\n    pub acct_id: i64,\n    pub acct_active_status: [u8; 1],\n    pub acct_curr_bal: i64,\n    pub acct_credit_limit: i64,\n    pub acct_cash_credit_limit: i64,\n    pub acct_open_date: [u8; 10],\n    pub acct_expiraion_date: [u8; 10],\n    pub acct_reissue_date: [u8; 10],\n    pub acct_curr_cyc_credit: i64,\n    pub acct_curr_cyc_debit: i64,\n    pub acct_addr_zip: [u8; 10],\n    pub acct_group_id: [u8; 10],\n    pub filler1: [u8; 178],\n}\n\n#[derive(Clone, Copy)]\npub struct FdTranfileRec {\n    pub fd_trans_id: [u8; 16],\n    pub fd_acct_data: [u8; 334],\n}\n\npub struct Output {\n    pub displays: Vec<Vec<u8>>,\n    pub abended: bool,\n}\n\nfn init_dalytran() -> DalytranRecord {\n    DalytranRecord {\n        dalytran_id: [b' '; 16],\n        dalytran_type_cd: [b' '; 2],\n        dalytran_cat_cd: 0,\n        dalytran_source: [b' '; 10],\n        dalytran_desc: [b' '; 100],\n        dalytran_amt: 0,\n        dalytran_merchant_id: 0,\n        dalytran_merchant_name: [b' '; 50],\n        dalytran_merchant_city: [b' '; 50],\n        dalytran_merchant_zip: [b' '; 10],\n        dalytran_card_num: [b' '; 16],\n        dalytran_orig_ts: [b' '; 26],\n        dalytran_proc_ts: [b' '; 26],\n        filler1: [b' '; 20],\n    }\n}\n\nfn init_xref() -> CardXrefRecord {\n    CardXrefRecord {\n        xref_card_num: [b' '; 16],\n        xref_cust_id: 0,\n        xref_acct_id: 0,\n        filler1: [b' '; 14],\n    }\n}\n\nfn init_account() -> AccountRecord {\n    AccountRecord {\n        acct_id: 0,\n        acct_active_status: [b' '; 1],\n        acct_curr_bal: 0,\n        acct_credit_limit: 0,\n        acct_cash_credit_limit: 0,\n        acct_open_date: [b' '; 10],\n        acct_expiraion_date: [b' '; 10],\n        acct_reissue_date: [b' '; 10],\n        acct_curr_cyc_credit: 0,\n        acct_curr_cyc_debit: 0,\n        acct_addr_zip: [b' '; 10],\n        acct_group_id: [b' '; 10],\n        filler1: [b' '; 178],\n    }\n}\n\nfn push_bytes(out: &mut Vec<u8>, s: &[u8]) {\n    let mut i = 0usize;\n    while i < s.len() {\n        out.push(s[i]);\n        i += 1;\n    }\n}\n\nfn abs_u64(v: i64) -> u64 {\n    if v < 0 {\n        ((v + 1) * -1) as u64 + 1\n    } else {\n        v as u64\n    }\n}\n\nfn digits_of(v: i64, n: usize) -> [u8; 18] {\n    let mut d = [b'0'; 18];\n    let mut x = abs_u64(v);\n    let mut i = n;\n    while i > 0 {\n        d[i - 1] = b'0' + (x % 10) as u8;\n        x /= 10;\n        i -= 1;\n    }\n    d\n}\n\nfn push_unsigned(out: &mut Vec<u8>, v: i64, n: usize) {\n    let d = digits_of(v, n);\n    let mut i = 0usize;\n    while i < n {\n        out.push(d[i]);\n        i += 1;\n    }\n}\n\nfn push_signed_overpunch(out: &mut Vec<u8>, v: i64, n: usize) {\n    let d = digits_of(v, n);\n    let mut i = 0usize;\n    while i + 1 < n {\n        out.push(d[i]);\n        i += 1;\n    }\n    let last = d[n - 1] - b'0';\n    let c = if v >= 0 {\n        if last == 0 {\n            b'{'\n        } else {\n            b'A' + last - 1\n        }\n    } else {\n        if last == 0 {\n            b'}'\n        } else {\n            b'J' + last - 1\n        }\n    };\n    out.push(c);\n}\n\nfn dalytran_bytes(r: &DalytranRecord) -> Vec<u8> {\n    let mut v: Vec<u8> = Vec::new();\n    push_bytes(&mut v, &r.dalytran_id);\n    push_bytes(&mut v, &r.dalytran_type_cd);\n    push_unsigned(&mut v, r.dalytran_cat_cd, 4);\n    push_bytes(&mut v, &r.dalytran_source);\n    push_bytes(&mut v, &r.dalytran_desc);\n    push_signed_overpunch(&mut v, r.dalytran_amt, 11);\n    push_unsigned(&mut v, r.dalytran_merchant_id, 9);\n    push_bytes(&mut v, &r.dalytran_merchant_name);\n    push_bytes(&mut v, &r.dalytran_merchant_city);\n    push_bytes(&mut v, &r.dalytran_merchant_zip);\n    push_bytes(&mut v, &r.dalytran_card_num);\n    push_bytes(&mut v, &r.dalytran_orig_ts);\n    push_bytes(&mut v, &r.dalytran_proc_ts);\n    push_bytes(&mut v, &r.filler1);\n    v\n}\n\nfn is_digit(b: u8) -> bool {\n    b >= b'0' && b <= b'9'\n}\n\nfn io_status_line(s1: u8, s2: u8) -> Vec<u8> {\n    let mut v: Vec<u8> = Vec::new();\n    push_bytes(&mut v, b\"FILE STATUS IS: NNNN\");\n    if !(is_digit(s1) && is_digit(s2)) || s1 == b'9' {\n        v.push(s1);\n        push_unsigned(&mut v, (s2 as i64) % 1000, 3);\n    } else {\n        push_bytes(&mut v, b\"00\");\n        v.push(s1);\n        v.push(s2);\n    }\n    v\n}\n\nfn bytes_eq16(a: &[u8; 16], b: &[u8; 16]) -> bool {\n    let mut i = 0usize;\n    while i < 16 {\n        if a[i] != b[i] {\n            return false;\n        }\n        i += 1;\n    }\n    true\n}\n\npub fn run(\n    dalytran_file: &[DalytranRecord],\n    customer_file: &[FdCustfileRec],\n    xref_file: &[CardXrefRecord],\n    card_file: &[FdCardfileRec],\n    account_file: &[AccountRecord],\n    transact_file: &[FdTranfileRec],\n) -> Output {\n    let _ = customer_file;\n    let _ = card_file;\n    let _ = transact_file;\n\n    let mut out = Output {\n        displays: Vec::new(),\n        abended: false,\n    };\n\n    out.displays\n        .push(b\"START OF EXECUTION OF PROGRAM CBTRN01C\".to_vec());\n    // All OPENs succeed (status '00').\n\n    let mut dal = init_dalytran();\n    let mut xref = init_xref();\n    let mut acct = init_account();\n    let mut eof_flag: u8 = b'N';\n    let mut pos: usize = 0;\n    let mut eof_hit = false;\n\n    while eof_flag != b'Y' {\n        if eof_flag == b'N' {\n            // 1000-DALYTRAN-GET-NEXT\n            let s1: u8;\n            let s2: u8;\n            if pos < dalytran_file.len() {\n                dal = dalytran_file[pos];\n                pos += 1;\n                s1 = b'0';\n                s2 = b'0';\n            } else if !eof_hit {\n                eof_hit = true;\n                s1 = b'1';\n                s2 = b'0';\n            } else {\n                s1 = b'4';\n                s2 = b'6';\n            }\n            let appl: i64 = if s1 == b'0' && s2 == b'0' {\n                0\n            } else if s1 == b'1' && s2 == b'0' {\n                16\n            } else {\n                12\n            };\n            if appl == 0 {\n            } else if appl == 16 {\n                eof_flag = b'Y';\n            } else {\n                out.displays\n                    .push(b\"ERROR READING DAILY TRANSACTION FILE\".to_vec());\n                out.displays.push(io_status_line(s1, s2));\n                out.displays.push(b\"ABENDING PROGRAM\".to_vec());\n                out.abended = true;\n                return out;\n            }\n\n            if eof_flag == b'N' {\n                out.displays.push(dalytran_bytes(&dal));\n            }\n\n            let mut xref_status: i64 = 0;\n            xref.xref_card_num = dal.dalytran_card_num;\n            // 2000-LOOKUP-XREF\n            let key = xref.xref_card_num;\n            let mut found = false;\n            let mut i = 0usize;\n            while i < xref_file.len() {\n                if bytes_eq16(&xref_file[i].xref_card_num, &key) {\n                    xref = xref_file[i];\n                    found = true;\n                    break;\n                }\n                i += 1;\n            }\n            if !found {\n                out.displays\n                    .push(b\"INVALID CARD NUMBER FOR XREF\".to_vec());\n                xref_status = 4;\n            } else {\n                out.displays.push(b\"SUCCESSFUL READ OF XREF\".to_vec());\n                let mut l1: Vec<u8> = Vec::new();\n                push_bytes(&mut l1, b\"CARD NUMBER: \");\n                push_bytes(&mut l1, &xref.xref_card_num);\n                out.displays.push(l1);\n                let mut l2: Vec<u8> = Vec::new();\n                push_bytes(&mut l2, b\"ACCOUNT ID : \");\n                push_unsigned(&mut l2, xref.xref_acct_id, 11);\n                out.displays.push(l2);\n                let mut l3: Vec<u8> = Vec::new();\n                push_bytes(&mut l3, b\"CUSTOMER ID: \");\n                push_unsigned(&mut l3, xref.xref_cust_id, 9);\n                out.displays.push(l3);\n            }\n\n            if xref_status == 0 {\n                let mut acct_status: i64 = 0;\n                acct.acct_id = (abs_u64(xref.xref_acct_id) % 100_000_000_000u64) as i64;\n                // 3000-READ-ACCOUNT\n                let akey = acct.acct_id;\n                let mut afound = false;\n                let mut j = 0usize;\n                while j < account_file.len() {\n                    if account_file[j].acct_id == akey {\n                        acct = account_file[j];\n                        afound = true;\n                        break;\n                    }\n                    j += 1;\n                }\n                if !afound {\n                    out.displays\n                        .push(b\"INVALID ACCOUNT NUMBER FOUND\".to_vec());\n                    acct_status = 4;\n                } else {\n                    out.displays\n                        .push(b\"SUCCESSFUL READ OF ACCOUNT FILE\".to_vec());\n                }\n                if acct_status != 0 {\n                    let mut l: Vec<u8> = Vec::new();\n                    push_bytes(&mut l, b\"ACCOUNT \");\n                    push_unsigned(&mut l, acct.acct_id, 11);\n                    push_bytes(&mut l, b\" NOT FOUND\");\n                    out.displays.push(l);\n                }\n            } else {\n                let mut l: Vec<u8> = Vec::new();\n                push_bytes(&mut l, b\"CARD NUMBER \");\n                push_bytes(&mut l, &dal.dalytran_card_num);\n                push_bytes(\n                    &mut l,\n                    b\" COULD NOT BE VERIFIED. SKIPPING TRANSACTION ID-\",\n                );\n                push_bytes(&mut l, &dal.dalytran_id);\n                out.displays.push(l);\n            }\n        }\n    }\n\n    // All CLOSEs succeed (status '00').\n    out.displays\n        .push(b\"END OF EXECUTION OF PROGRAM CBTRN01C\".to_vec());\n    out\n}"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"nam