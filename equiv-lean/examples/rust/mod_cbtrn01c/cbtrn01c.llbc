let mut eof_hit = false;\n\n    while eof_flag != b'Y' {\n        if eof_flag == b'N' {\n            // 1000-DALYTRAN-GET-NEXT\n            let s1: u8;\n            let s2: u8;\n            if pos < dalytran_file.len() {\n                dal = dalytran_file[pos];\n                pos += 1;\n                s1 = b'0';\n                s2 = b'0';\n            } else if !eof_hit {\n                eof_hit = true;\n                s1 = b'1';\n                s2 = b'0';\n            } else {\n                s1 = b'4';\n                s2 = b'6';\n            }\n            let appl: i64 = if s1 == b'0' && s2 == b'0' {\n                0\n            } else if s1 == b'1' && s2 == b'0' {\n                16\n            } else {\n                12\n            };\n            if appl == 0 {\n            } else if appl == 16 {\n                eof_flag = b'Y';\n            } else {\n                out.displays\n                    .push(b\"ERROR READING DAILY TRANSACTION FILE\".to_vec());\n                out.displays.push(io_status_line(s1, s2));\n                out.displays.push(b\"ABENDING PROGRAM\".to_vec());\n                out.abended = true;\n                return out;\n            }\n\n            if eof_flag == b'N' {\n                out.displays.push(dalytran_bytes(&dal));\n            }\n\n            let mut xref_status: i64 = 0;\n            xref.xref_card_num = dal.dalytran_card_num;\n            // 2000-LOOKUP-XREF\n            let key = xref.xref_card_num;\n            let mut found = false;\n            let mut i = 0usize;\n            while i < xref_file.len() {\n                if bytes_eq16(&xref_file[i].xref_card_num, &key) {\n                    xref = xref_file[i];\n                    found = true;\n                    break;\n                }\n                i += 1;\n            }\n            if !found {\n                out.displays\n                    .push(b\"INVALID CARD NUMBER FOR XREF\".to_vec());\n                xref_status = 4;\n            } else {\n                out.displays.push(b\"SUCCESSFUL READ OF XREF\".to_vec());\n                let mut l1: Vec<u8> = Vec::new();\n                push_bytes(&mut l1, b\"CARD NUMBER: \");\n                push_bytes(&mut l1, &xref.xref_card_num);\n                out.displays.push(l1);\n                let mut l2: Vec<u8> = Vec::new();\n                push_bytes(&mut l2, b\"ACCOUNT ID : \");\n                push_unsigned(&mut l2, xref.xref_acct_id, 11);\n                out.displays.push(l2);\n                let mut l3: Vec<u8> = Vec::new();\n                push_bytes(&mut l3, b\"CUSTOMER ID: \");\n                push_unsigned(&mut l3, xref.xref_cust_id, 9);\n                out.displays.push(l3);\n            }\n\n            if xref_status == 0 {\n                let mut acct_status: i64 = 0;\n                acct.acct_id = (abs_u64(xref.xref_acct_id) % 100_000_000_000u64) as i64;\n                // 3000-READ-ACCOUNT\n                let akey = acct.acct_id;\n                let mut afound = false;\n                let mut j = 0usize;\n                while j < account_file.len() {\n                    if account_file[j].acct_id == akey {\n                        acct = account_file[j];\n                        afound = true;\n                        break;\n                    }\n                    j += 1;\n                }\n                if !afound {\n                    out.displays\n                        .push(b\"INVALID ACCOUNT NUMBER FOUND\".to_vec());\n                    acct_status = 4;\n                } else {\n                    out.displays\n                        .push(b\"SUCCESSFUL READ OF ACCOUNT FILE\".to_vec());\n                }\n                if acct_status != 0 {\n                    let mut l: Vec<u8> = Vec::new();\n                    push_bytes(&mut l, b\"ACCOUNT \");\n                    push_unsigned(&mut l, acct.acct_id, 11);\n                    push_bytes(&mut l, b\" NOT FOUND\");\n                    out.displays.push(l);\n                }\n            } else {\n                let mut l: Vec<u8> = Vec::new();\n                push_bytes(&mut l, b\"CARD NUMBER \");\n                push_bytes(&mut l, &dal.dalytran_card_num);\n                push_bytes(\n                    &mut l,\n                    b\" COULD NOT BE VERIFIED. SKIPPING TRANSACTION ID-\",\n                );\n                push_bytes(&mut l, &dal.dalytran_id);\n                out.displays.push(l);\n            }\n        }\n    }\n\n    // All CLOSEs succeed (status '00').\n    out.displays\n        .push(b\"END OF EXECUTION OF PROGRAM CBTRN01C\".to_vec());\n    out\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":4,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true},{"index":5,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[143,{"Ref":[{"Var":{"Free":0}},{"Value":[144,{"Slice":[{"Deduplicated":46},null]}]},"Shared"]}]},{"Value":[145,{"Ref":[{"Var":{"Free":1}},{"Value":[146,{"Slice":[{"Value":[147,{"Adt":{"id":6,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]},null]}]},"Shared"]}]},{"Value":[148,{"Ref":[{"Var":{"Free":2}},{"Value":[149,{"Slice":[{"Deduplica