{"charon_version":"0.1.293","translated":{"crate_name":"cbtrn03c","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"cbtrn03c","contents":"#[derive(Clone, Copy)]\npub struct TranRecord {\n    pub tran_id: [u8; 16],\n    pub tran_type_cd: [u8; 2],\n    pub tran_cat_cd: i64,\n    pub tran_source: [u8; 10],\n    pub tran_desc: [u8; 100],\n    pub tran_amt: i64,\n    pub tran_merchant_id: i64,\n    pub tran_merchant_name: [u8; 50],\n    pub tran_merchant_city: [u8; 50],\n    pub tran_merchant_zip: [u8; 10],\n    pub tran_card_num: [u8; 16],\n    pub tran_orig_ts: [u8; 26],\n    pub tran_proc_ts: [u8; 26],\n    pub filler1: [u8; 20],\n}\n\n#[derive(Clone, Copy)]\npub struct CardXrefRecord {\n    pub xref_card_num: [u8; 16],\n    pub xref_cust_id: i64,\n    pub xref_acct_id: i64,\n    pub filler1: [u8; 14],\n}\n\n#[derive(Clone, Copy)]\npub struct TranTypeRecord {\n    pub tran_type: [u8; 2],\n    pub tran_type_desc: [u8; 50],\n    pub filler1: [u8; 8],\n}\n\n#[derive(Clone, Copy)]\npub struct TranCatRecord {\n    pub tran_type_cd: [u8; 2],\n    pub tran_cat_cd: i64,\n    pub tran_cat_type_desc: [u8; 50],\n    pub filler1: [u8; 4],\n}\n\n#[derive(Clone, Copy)]\npub struct WsDateparmRecord {\n    pub ws_start_date: [u8; 10],\n    pub filler1: [u8; 1],\n    pub ws_end_date: [u8; 10],\n}\n\n#[derive(Clone, Copy)]\npub struct FdReptfileRec {\n    pub fd_reptfile_rec: [u8; 133],\n}\n\npub struct Output {\n    pub displays: Vec<Vec<u8>>,\n    pub report_file_writes: Vec<FdReptfileRec>,\n    pub abended: bool,\n}\n\nstruct St {\n    displays: Vec<Vec<u8>>,\n    writes: Vec<FdReptfileRec>,\n    line_counter: i64,\n    page_total: i64,\n    account_total: i64,\n    grand_total: i64,\n    rept_start_date: [u8; 10],\n    rept_end_date: [u8; 10],\n}\n\n// CP037: EBCDIC code -> character code point\nconst CP037: [u8; 256] = [\n    0x00, 0x01, 0x02, 0x03, 0x9C, 0x09, 0x86, 0x7F, 0x97, 0x8D, 0x8E, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F,\n    0x10, 0x11, 0x12, 0x13, 0x9D, 0x85, 0x08, 0x87, 0x18, 0x19, 0x92, 0x8F, 0x1C, 0x1D, 0x1E, 0x1F,\n    0x80, 0x81, 0x82, 0x83, 0x84, 0x0A, 0x17, 0x1B, 0x88, 0x89, 0x8A, 0x8B, 0x8C, 0x05, 0x06, 0x07,\n    0x90, 0x91, 0x16, 0x93, 0x94, 0x95, 0x96, 0x04, 0x98, 0x99, 0x9A, 0x9B, 0x14, 0x15, 0x9E, 0x1A,\n    0x20, 0xA0, 0xE2, 0xE4, 0xE0, 0xE1, 0xE3, 0xE5, 0xE7, 0xF1, 0xA2, 0x2E, 0x3C, 0x28, 0x2B, 0x7C,\n    0x26, 0xE9, 0xEA, 0xEB, 0xE8, 0xED, 0xEE, 0xEF, 0xEC, 0xDF, 0x21, 0x24, 0x2A, 0x29, 0x3B, 0xAC,\n    0x2D, 0x2F, 0xC2, 0xC4, 0xC0, 0xC1, 0xC3, 0xC5, 0xC7, 0xD1, 0xA6, 0x2C, 0x25, 0x5F, 0x3E, 0x3F,\n    0xF8, 0xC9, 0xCA, 0xCB, 0xC8, 0xCD, 0xCE, 0xCF, 0xCC, 0x60, 0x3A, 0x23, 0x40, 0x27, 0x3D, 0x22,\n    0xD8, 0x61, 0x62, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68, 0x69, 0xAB, 0xBB, 0xF0, 0xFD, 0xFE, 0xB1,\n    0xB0, 0x6A, 0x6B, 0x6C, 0x6D, 0x6E, 0x6F, 0x70, 0x71, 0x72, 0xAA, 0xBA, 0xE6, 0xB8, 0xC6, 0xA4,\n    0xB5, 0x7E, 0x73, 0x74, 0x75, 0x76, 0x77, 0x78, 0x79, 0x7A, 0xA1, 0xBF, 0xD0, 0xDD, 0xDE, 0xAE,\n    0x5E, 0xA3, 0xA5, 0xB7, 0xA9, 0xA7, 0xB6, 0xBC, 0xBD, 0xBE, 0x5B, 0x5D, 0xAF, 0xA8, 0xB4, 0xD7,\n    0x7B, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47, 0x48, 0x49, 0xAD, 0xF4, 0xF6, 0xF2, 0xF3, 0xF5,\n    0x7D, 0x4A, 0x4B, 0x4C, 0x4D, 0x4E, 0x4F, 0x50, 0x51, 0x52, 0xB9, 0xFB, 0xFC, 0xF9, 0xFA, 0xFF,\n    0x5C, 0xF7, 0x53, 0x54, 0x55, 0x56, 0x57, 0x58, 0x59, 0x5A, 0xB2, 0xD4, 0xD6, 0xD2, 0xD3, 0xD5,\n    0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0xB3, 0xDB, 0xDC, 0xD9, 0xDA, 0x9F,\n];\n\nfn ebcdic_weight(b: u8) -> usize {\n    let mut i: usize = 0;\n    while i < 256 {\n        if CP037[i] == b {\n            return i;\n        }\n        i += 1;\n    }\n    b as usize\n}\n\n// returns -1, 0, 1 comparing a and b (equal length) in EBCDIC collating sequence\nfn cmp_ebcdic(a: &[u8], b: &[u8]) -> i32 {\n    let mut i: usize = 0;\n    while i < a.len() && i < b.len() {\n        let wa = ebcdic_weight(a[i]);\n        let wb = ebcdic_weight(b[i]);\n        if wa < wb {\n            return -1;\n        }\n        if wa > wb {\n            return 1;\n        }\n        i += 1;\n    }\n    0\n}\n\nfn bytes_eq(a: &[u8], b: &[u8]) -> bool {\n    if a.len() != b.len() {\n        return false;\n    }\n    let mut i: usize = 0;\n    while i < a.len() {\n        if a[i] != b[i] {\n            return false;\n        }\n        i += 1;\n    }\n    true\n}\n\nfn push_bytes(out: &mut Vec<u8>, s: &[u8]) {\n    let mut i: usize = 0;\n    while i < s.len() {\n        out.push(s[i]);\n        i += 1;\n    }\n}\n\nfn push_padded(out: &mut Vec<u8>, s: &[u8], width: usize) {\n    let mut i: usize = 0;\n    while i < width {\n        if i < s.len() {\n            out.push(s[i]);\n        } else {\n            out.push(b' ');\n        }\n        i += 1;\n    }\n}\n\nfn push_fill(out: &mut Vec<u8>, c: u8, width: usize) {\n    let mut i: usize = 0;\n    while i < width {\n        out.push(c);\n        i += 1;\n    }\n}\n\nfn push_digits(out: &mut Vec<u8>, v: i64, width: usize) {\n    let mut mag: u64 = if v < 0 { (-v) as u64 } else { v as u64 };\n    let mut buf = [b'0'; 20];\n    let mut i: usize = 0;\n    while i < width {\n        buf[width - 1 - i] = b'0' + (mag % 10) as u8;\n        mag /= 10;\n        i += 1;\n    }\n    let mut j: usize = 0;\n    while j < width {\n        out.push(buf[j]);\n        j += 1;\n    }\n}\n\nfn push_zoned_signed(out: &mut Vec<u8>, v: i64, width: usize) {\n    push_digits(out, v, width);\n    let n = out.len();\n    let d = out[n - 1] - b'0';\n    out[n - 1] = if v < 0 {\n        if d == 0 {\n            b'}'\n        } else {\n            b'J' + d - 1\n        }\n    } else if d == 0 {\n        b'{'\n    } else {\n        b'A' + d - 1\n    };\n}\n\n// [+|-]ZZZ,ZZZ,ZZZ.ZZ\nfn edit_amount(v: i64, plus: bool) -> [u8; 15] {\n    let mut out = [b' '; 15];\n    let mag_full: u64 = if v < 0 { (-v) as u64 } else { v as u64 };\n    let mag = mag_full % 100_000_000_000;\n    if mag == 0 {\n        return out;\n    }\n    out[0] = if v < 0 {\n        b'-'\n    } else if plus {\n        b'+'\n    } else {\n        b' '\n    };\n    let int_part = mag / 100;\n    let frac = mag % 100;\n    let mut digits = [0u8; 9];\n    let mut t = int_part;\n    let mut i: usize = 0;\n    while i < 9 {\n        digits[8 - i] = (t % 10) as u8;\n        t /= 10;\n        i += 1;\n    }\n    let pattern: &[u8; 11] = b\"ZZZ,ZZZ,ZZZ\";\n    let mut suppress = true;\n    let mut k: usize = 0;\n    let mut p: usize = 0;\n    while p < 11 {\n        if pattern[p] == b',' {\n            out[1 + p] = if suppress { b' ' } else { b',' };\n        } else {\n            let d = digits[k];\n            k += 1;\n            if suppress && d == 0 {\n                out[1 + p] = b' ';\n            } else {\n                suppress = false;\n                out[1 + p] = b'0' + d;\n            }\n        }\n        p += 1;\n    }\n    out[12] = b'.';\n    out[13] = b'0' + (frac / 10) as u8;\n    out[14] = b'0' + (frac % 10) as u8;\n    out\n}\n\nfn to133(v: &[u8]) -> [u8; 133] {\n    let mut r = [b' '; 133];\n    let mut i: usize = 0;\n    while i < 133 && i < v.len() {\n        r[i] = v[i];\n        i += 1;\n    }\n    r\n}\n\nfn trunc11(x: i64) -> i64 {\n    x % 100_000_000_000\n}\n\nfn inc_counter(st: &mut St) {\n    st.line_counter = (st.line_counter + 1) % 1_000_000_000;\n}\n\nfn write_rec(st: &mut St, rec: [u8; 133]) {\n    st.writes.push(FdReptfileRec { fd_reptfile_rec: rec });\n}\n\nfn header2() -> [u8; 133] {\n    [b'-'; 133]\n}\n\nfn write_page_totals(st: &mut St) {\n    let mut v = Vec::new();\n    push_padded(&mut v, b\"Page Total\", 11);\n    push_fill(&mut v, b'.', 86);\n    let e = edit_amount(st.page_total, true);\n    push_bytes(&mut v, &e);\n    write_rec(st, to133(&v));\n    st.grand_total = trunc11(st.grand_total + st.page_total);\n    st.page_total = 0;\n    inc_counter(st);\n    write_rec(st, header2());\n    inc_counter(st);\n}\n\nfn write_account_totals(st: &mut St) {\n    let mut v = Vec::new();\n    push_padded(&mut v, b\"Account Total\", 13);\n    push_fill(&mut v, b'.', 84);\n    let e = edit_amount(st.account_total, true);\n    push_bytes(&mut v, &e);\n    write_rec(st, to133(&v));\n    st.account_total = 0;\n    inc_counter(st);\n    write_rec(st, header2());\n    inc_counter(st);\n}\n\nfn write_grand_totals(st: &mut St) {\n    let mut v = Vec::new();\n    push_padded(&mut v, b\"Grand Total\", 11);\n    push_fill(&mut v, b'.', 86);\n    let e = edit_amount(st.grand_total, true);\n    push_bytes(&mut v, &e);\n    write_rec(st, to133(&v));\n}\n\nfn write_headers(st: &mut St) {\n    let mut v = Vec::new();\n    push_padded(&mut v, b\"DALYREPT\", 38);\n    push_padded(&mut v, b\"Daily Transaction Report\", 41);\n    push_padded(&mut v, b\"Date Range: \", 12);\n    let sd = st.rept_start_date;\n    let ed = st.rept_end_date;\n    push_bytes(&mut v, &sd);\n    push_bytes(&mut v, b\" to \");\n    push_bytes(&mut v, &ed);\n    write_rec(st, to133(&v));\n    inc_counter(st);\n\n    write_rec(st, [b' '; 133]);\n    inc_counter(st);\n\n    let mut h = Vec::new();\n    push_padded(&mut h, b\"Transaction ID\", 17);\n    push_padded(&mut h, b\"Account ID\", 12);\n    push_padded(&mut h, b\"Transaction Type\", 19);\n    push_padded(&mut h, b\"Tran Category\", 35);\n    push_padded(&mut h, b\"Tran Source\", 14);\n    push_padded(&mut h, b\" \", 1);\n    push_padded(&mut h, b\"        Amount\", 16);\n    write_rec(st, to133(&h));\n    inc_counter(st);\n\n    write_rec(st, header2());\n    inc_counter(st);\n}\n\nfn write_detail(\n    st: &mut St,\n    tran: &TranRecord,\n    xref: &CardXrefRecord,\n    ttype: &TranTypeRecord,\n    tcat: &TranCatRecord,\n) {\n    let mut v = Vec::new();\n    push_bytes(&mut v, &tran.tran_id);\n    v.push(b' ');\n    push_digits(&mut v, xref.xref_acct_id, 11);\n    v.push(b' ');\n    push_bytes(&mut v, &tran.tran_type_cd);\n    v.push(b'-');\n    push_padded(&mut v, &ttype.tran_type_desc[0..15], 15);\n    v.push(b' ');\n    push_digits(&mut v, tran.tran_cat_cd, 4);\n    v.push(b'-');\n    push_padded(&mut v, &tcat.tran_cat_type_desc[0..29], 29);\n    v.push(b' ');\n    push_bytes(&mut v, &tran.tran_source);\n    push_fill(&mut v, b' ', 4);\n    let e = edit_amount(tran.tran_amt, false);\n    push_bytes(&mut v, &e);\n    push_fill(&mut v, b' ', 2);\n    write_rec(st, to133(&v));\n    inc_counter(st);\n}\n\nfn write_transaction_report(\n    st: &mut St,\n    first_time: &mut bool,\n    dates: &WsDateparmRecord,\n    tran: &TranRecord,\n    xref: &CardXrefRecord,\n    ttype: &TranTypeRecord,\n    tcat: &TranCatRecord,\n) {\n    if *first_time {\n        *first_time = false;\n        st.rept_start_date = dates.ws_start_date;\n        st.rept_end_date = dates.ws_end_date;\n        write_headers(st);\n    }\n    if st.line_counter % 20 == 0 {\n        write_page_totals(st);\n        write_headers(st);\n    }\n    st.page_total = trunc11(st.page_total + tran.tran_amt);\n    st.account_total = trunc11(st.account_total + tran.tran_amt);\n    write_detail(st, tran, xref, ttype, tcat);\n}\n\nfn tran_record_bytes(t: &TranRecord) -> Vec<u8> {\n    let mut v = Vec::new();\n    push_bytes(&mut v, &t.tran_id);\n    push_bytes(&mut v, &t.tran_type_cd);\n    push_digits(&mut v, t.tran_cat_cd, 4);\n    push_bytes(&mut v, &t.tran_source);\n    push_bytes(&mut v, &t.tran_desc);\n    push_zoned_signed(&mut v, t.tran_amt, 11);\n    push_digits(&mut v, t.tran_merchant_id, 9);\n    push_bytes(&mut v, &t.tran_merchant_name);\n    push_bytes(&mut v, &t.tran_merchant_city);\n    push_bytes(&mut v, &t.tran_merchant_zip);\n    push_bytes(&mut v, &t.tran_card_num);\n    push_bytes(&mut v, &t.tran_orig_ts);\n    push_bytes(&mut v, &t.tran_proc_ts);\n    push_bytes(&mut v, &t.filler1);\n    v\n}\n\nfn abend_status23(st: &mut St) {\n    let mut d = Vec::new();\n    push_bytes(&mut d, b\"FILE STATUS IS: NNNN0023\");\n    st.displays.push(d);\n    let mut a = Vec::new();\n    push_bytes(&mut a, b\"ABENDING PROGRAM\");\n    st.displays.push(a);\n}\n\nfn finish(st: St, abended: bool) -> Output {\n    Output {\n        displays: st.displays,\n        report_file_writes: st.writes,\n        abended,\n    }\n}\n\npub fn run(\n    transact_file: &[TranRecord],\n    xref_file: &[CardXrefRecord],\n    trantype_file: &[TranTypeRecord],\n    trancatg_file: &[TranCatRecord],\n    date_parms_file: &[WsDateparmRecord],\n) -> Output {\n    let mut st = St {\n        displays: Vec::new(),\n        writes: Vec::new(),\n        line_counter: 0,\n        page_total: 0,\n        account_total: 0,\n        grand_total: 0,\n        rept_start_date: [b' '; 10],\n        rept_end_date: [b' '; 10],\n    };\n\n    let mut tran = TranRecord {\n        tran_id: [b' '; 16],\n        tran_type_cd: [b' '; 2],\n        tran_cat_cd: 0,\n        tran_source: [b' '; 10],\n        tran_desc: [b' '; 100],\n        tran_amt: 0,\n        tran_merchant_id: 0,\n        tran_merchant_name: [b' '; 50],\n        tran_merchant_city: [b' '; 50],\n        tran_merchant_zip: [b' '; 10],\n        tran_card_num: [b' '; 16],\n        tran_orig_ts: [b' '; 26],\n        tran_proc_ts: [b' '; 26],\n        filler1: [b' '; 20],\n    };\n    let mut xref = CardXrefRecord {\n        xref_card_num: [b' '; 16],\n        xref_cust_id: 0,\n        xref_acct_id: 0,\n        filler1: [b' '; 14],\n    };\n    let mut ttype = TranTypeRecord {\n        tran_type: [b' '; 2],\n        tran_type_desc: [b' '; 50],\n        filler1: [b' '; 8],\n    };\n    let mut tcat = TranCatRecord {\n        tran_type_cd: [b' '; 2],\n        tran_cat_cd: 0,\n        tran_cat_type_desc: [b' '; 50],\n        filler1: [b' '; 4],\n    };\n    let mut dates = WsDateparmRecord {\n        ws_start_date: [b' '; 10],\n        filler1: [b' '; 1],\n        ws_end_date: [b' '; 10],\n    };\n\n    let mut first_time = true;\n    let mut curr_card: [u8; 16] = [b' '; 16];\n    let mut end_of_file = false;\n    let mut tran_idx: usize = 0;\n\n    let mut s = Vec::new();\n    push_bytes(&mut s, b\"START OF EXECUTION OF PROGRAM CBTRN03C\");\n    st.displays.push(s);\n\n    // 0550-DATEPARM-READ\n    if date_parms_file.len() > 0 {\n        dates = date_parms_file[0];\n        let mut d = Vec::new();\n        push_bytes(&mut d, b\"Reporting from \");\n        push_bytes(&mut d, &dates.ws_start_date);\n        push_bytes(&mut d, b\" to \");\n        push_bytes(&mut d, &dates.ws_end_date);\n        st.displays.push(d);\n    } else {\n        end_of_file = true;\n    }\n\n    while !end_of_file {\n        // 1000-TRANFILE-GET-NEXT\n        if tran_idx < transact_file.len() {\n            tran = transact_file[tran_idx];\n            tran_idx += 1;\n        } else {\n            end_of_file = true;\n        }\n\n        let ts = &tran.tran_proc_ts[0..10];\n        let in_range = cmp_ebcdic(ts, &dates.ws_start_date) >= 0\n            && cmp_ebcdic(ts, &dates.ws_end_date) <= 0;\n        if !in_range {\n            // NEXT SENTENCE: leaves the inline PERFORM\n            break;\n        }\n\n        if !end_of_file {\n            st.displays.push(tran_record_bytes(&tran));\n            if !bytes_eq(&curr_card, &tran.tran_card_num) {\n                if !first_time {\n                    write_account_totals(&mut st);\n                }\n                curr_card = tran.tran_card_num;\n                let key = tran.tran_card_num;\n                let mut found = false;\n                let mut i: usize = 0;\n                while i < xref_file.len() {\n                    if bytes_eq(&xref_file[i].xref_card_num, &key) {\n                        xref = xref_file[i];\n                        found = true;\n                        break;\n                    }\n                    i += 1;\n                }\n                if !found {\n                    let mut d = Vec::new();\n                    push_bytes(&mut d, b\"INVALID CARD NUMBER : \");\n                    push_bytes(&mut d, &key);\n                    st.displays.push(d);\n                    abend_status23(&mut st);\n                    return finish(st, true);\n                }\n            }\n\n            let tkey = tran.tran_type_cd;\n            let mut found = false;\n            let mut i: usize = 0;\n            while i < trantype_file.len() {\n                if bytes_eq(&trantype_file[i].tran_type, &tkey) {\n                    ttype = trantype_file[i];\n                    found = true;\n                    break;\n                }\n                i += 1;\n            }\n            if !found {\n                let mut d = Vec::new();\n                push_bytes(&mut d, b\"INVALID TRANSACTION TYPE : \");\n                push_bytes(&mut d, &tkey);\n                st.displays.push(d);\n                abend_status23(&mut st);\n                return finish(st, true);\n            }\n\n            let ckey_type = tran.tran_type_cd;\n            let ckey_cat = tran.tran_cat_cd;\n            let mut found = false;\n            let mut i: usize = 0;\n            while i < trancatg_file.len() {\n                if bytes_eq(&trancatg_file[i].tran_type_cd, &ckey_type)\n                    && trancatg_file[i].tran_cat_cd == ckey_cat\n                {\n                    tcat = trancatg_file[i];\n                    found = true;\n                    break;\n                }\n                i += 1;\n            }\n            if !found {\n                let mut d = Vec::new();\n                push_bytes(&mut d, b\"INVALID TRAN CATG KEY : \");\n                push_bytes(&mut d, &ckey_type);\n                push_digits(&mut d, ckey_cat, 4);\n                st.displays.push(d);\n                abend_status23(&mut st);\n                return finish(st, true);\n            }\n\n            write_transaction_report(\n                &mut st,\n                &mut first_time,\n                &dates,\n                &tran,\n                &xref,\n                &ttype,\n                &tcat,\n            );\n        } else {\n            let mut d = Vec::new();\n            push_bytes(&mut d, b\"TRAN-AMT \");\n            push_zoned_signed(&mut d, tran.tran_amt, 11);\n            st.displays.push(d);\n            let mut d2 = Vec::new();\n            push_bytes(&mut d2, b\"WS-PAGE-TOTAL\");\n            push_zoned_signed(&mut d2, st.page_total, 11);\n            st.displays.push(d2);\n            st.page_total = trunc11(st.page_total + tran.tran_amt);\n            st.account_total = trunc11(st.account_total + tran.tran_amt);\n            write_page_totals(&mut st);\n            write_grand_totals(&mut st);\n        }\n    }\n\n    let mut e = Vec::new();\n    push_bytes(&mut e, b\"END OF EXECUTION OF PROGRAM CBTRN03C\");\n    st.displays.push(e);\n\n    finish(st, false)\n}"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/c