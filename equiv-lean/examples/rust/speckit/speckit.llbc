{"charon_version":"0.1.293","translated":{"crate_name":"speckit","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"speckit","contents":"//! Test cases for the Rust spec-proof kit: loops over record slices that build output Vecs.\n\n#[derive(Clone, Copy)]\npub struct Rec {\n    pub id: u32,\n    pub amount: u32,\n}\n\n#[derive(Clone, Copy)]\npub struct Line {\n    pub key: u32,\n    pub val: u32,\n}\n\n/// (a) One output line per record.\npub fn map_lines(recs: &[Rec]) -> Vec<Line> {\n    let mut out: Vec<Line> = Vec::new();\n    let mut i: usize = 0;\n    while i < recs.len() {\n        let r = recs[i];\n        out.push(Line { key: r.id, val: r.amount });\n        i += 1;\n    }\n    out\n}\n\n/// (a') A header line, one line per record, a trailer line.\npub fn framed(recs: &[Rec]) -> Vec<Line> {\n    let mut out: Vec<Line> = Vec::new();\n    out.push(Line { key: 0, val: 0 });\n    let mut i: usize = 0;\n    while i < recs.len() {\n        out.push(Line { key: recs[i].id, val: recs[i].amount });\n        i += 1;\n    }\n    out.push(Line { key: 1, val: 1 });\n    out\n}\n\n/// (b) Lines for the records with a nonzero amount.\npub fn filter_lines(recs: &[Rec]) -> Vec<Line> {\n    let mut out: Vec<Line> = Vec::new();\n    let mut i: usize = 0;\n    while i < recs.len() {\n        let r = recs[i];\n        if r.amount != 0 {\n            out.push(Line { key: r.id, val: r.amount });\n        }\n        i += 1;\n    }\n    out\n}\n\n/// (c) The records with a nonzero amount, then a final line with their count.\npub fn count_lines(recs: &[Rec]) -> Vec<Line> {\n    let mut out: Vec<Line> = Vec::new();\n    let mut n: u32 = 0;\n    let mut i: usize = 0;\n    while i < recs.len() {\n        let r = recs[i];\n        if r.amount != 0 {\n            out.push(Line { key: r.id, val: r.amount });\n            n += 1;\n        }\n        i += 1;\n    }\n    out.push(Line { key: 9, val: n });\n    out\n}\n\n/// (c') A wrapping running total in a final line.\npub fn total_line(recs: &[Rec]) -> Vec<Line> {\n    let mut out: Vec<Line> = Vec::new();\n    let mut total: u32 = 0;\n    let mut i: usize = 0;\n    while i < recs.len() {\n        total = total.wrapping_add(recs[i].amount);\n        out.push(Line { key: recs[i].id, val: total });\n        i += 1;\n    }\n    out.push(Line { key: 9, val: total });\n    out\n}\n\n/// (d) Two outputs: a line per record, and the records with a nonzero amount; and a return code.\npub fn two_outputs(recs: &[Rec]) -> (Vec<Line>, Vec<Rec>, u32) {\n    let mut lines: Vec<Line> = Vec::new();\n    let mut written: Vec<Rec> = Vec::new();\n    let mut i: usize = 0;\n    while i < recs.len() {\n        let r = recs[i];\n        lines.push(Line { key: r.id, val: r.amount });\n        if r.amount != 0 {\n            written.push(r);\n        }\n        i += 1;\n    }\n    (lines, written, 0)\n}\n\n/// (e) The amount of the first record of `tbl` with key `key`, or 0 (linear search).\npub fn lookup(tbl: &[Rec], key: u32) -> u32 {\n    let mut j: usize = 0;\n    while j < tbl.len() {\n        if tbl[j].id == key {\n            return tbl[j].amount;\n        }\n        j += 1;\n    }\n    0\n}\n\n/// (e) For each record, its id and the amount found in `tbl` under its id.\npub fn joined(recs: &[Rec], tbl: &[Rec]) -> Vec<Line> {\n    let mut out: Vec<Line> = Vec::new();\n    let mut i: usize = 0;\n    while i < recs.len() {\n        let v = lookup(tbl, recs[i].id);\n        out.push(Line { key: recs[i].id, val: v });\n        i += 1;\n    }\n    out\n}\n\n/// (f) Two loops in sequence: the lines of `a`, then the lines of `b`.\npub fn two_loops(a: &[Rec], b: &[Rec]) -> Vec<Line> {\n    let mut out: Vec<Line> = Vec::new();\n    let mut i: usize = 0;\n    while i < a.len() {\n        out.push(Line { key: a[i].id, val: a[i].amount });\n        i += 1;\n    }\n    let mut j: usize = 0;\n    while j < b.len() {\n        out.push(Line { key: b[j].id, val: b[j].amount });\n        j += 1;\n    }\n    out\n}\n\n/// (g) A return code: 4 if some record has a zero amount, else 0; and the lines.\npub fn with_rc(recs: &[Rec]) -> (Vec<Line>, u32) {\n    let mut out: Vec<Line> = Vec::new();\n    let mut bad: bool = false;\n    let mut i: usize = 0;\n    while i < recs.len() {\n        if recs[i].amount == 0 {\n            bad = true;\n        } else {\n            out.push(Line { key: recs[i].id, val: recs[i].amount });\n        }\n        i += 1;\n    }\n    let rc: u32 = if bad { 4 } else { 0 };\n    (out, rc)\n}\n\n/// (h) A CBACT02C-shaped program: a card record, displayed field by field.\n#[derive(Clone, Copy)]\npub struct CardRecord {\n    pub card_num: [u8; 16],\n    pub card_acct_id: i64,\n    pub card_cvv_cd: i64,\n    pub filler1: [u8; 59],\n}\n\npub struct Output {\n    pub displays: Vec<Vec<u8>>,\n    pub abended: bool,\n}\n\n/// The `n` low decimal digits of `v` (0 for a negative `v`), zero-padded, as Latin-1 bytes\n/// (`n <= 19`).\npub fn zero_pad(v: i64, n: usize) -> Vec<u8> {\n    let x: u64 = if v < 0 { 0 } else { v as u64 };\n    let mut p: u64 = 1;\n    let mut k: usize = 0;\n    while k < n {\n        p = p * 10;\n        k += 1;\n    }\n    let mut out: Vec<u8> = Vec::new();\n    let mut j: usize = 0;\n    while j < n {\n        p = p / 10;\n        let d = (x / p) % 10;\n        out.push(b'0' + (d as u8));\n        j += 1;\n    }\n    out\n}\n\n/// Appends the bytes of a field.\npub fn push_bytes(line: &mut Vec<u8>, b: &[u8]) {\n    let mut j: usize = 0;\n    while j < b.len() {\n        line.push(b[j]);\n        j += 1;\n    }\n}\n\n/// The display line of a card record: its fields in order.\npub fn card_line(c: &CardRecord) -> Vec<u8> {\n    let mut line: Vec<u8> = Vec::new();\n    push_bytes(&mut line, &c.card_num);\n    let a = zero_pad(c.card_acct_id, 11);\n    push_bytes(&mut line, &a);\n    let v = zero_pad(c.card_cvv_cd, 3);\n    push_bytes(&mut line, &v);\n    push_bytes(&mut line, &c.filler1);\n    line\n}\n\n/// A start line, one line per card record, an end line.\npub fn run(cards: &[CardRecord]) -> Output {\n    let mut displays: Vec<Vec<u8>> = Vec::new();\n    let mut start: Vec<u8> = Vec::new();\n    start.push(b'S');\n    start.push(b'T');\n    displays.push(start);\n    let mut i: usize = 0;\n    while i < cards.len() {\n        displays.push(card_line(&cards[i]));\n        i += 1;\n    }\n    let mut end: Vec<u8> = Vec::new();\n    end.push(b'E');\n    end.push(b'N');\n    displays.push(end);\n    Output { displays, abended: false }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/alloc/src/vec/mod.rs"},"crate_name":"alloc","contents":null},{"id":12,"name":{"Local":"/rustc/library/alloc/src/lib.rs"},"crate_name":"alloc","contents":null},{"id":13,"name":{"Local":"/rustc/library/alloc/src/alloc.rs"},"crate_name":"alloc","contents":null},{"id":14,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":15,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":16,"name":{"Local":"/rustc/library/core/src/ops/deref.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Value":[1,{"Array":[{"Value":[2,{"TypeVar":{"Bound":[0,0]}}]},{"Value":[0,[{"Var":{"Bound":[0,0]}},{"Deduplicated":0}]]},null]}]},"kind":"InherentImplBlock"}}},{"Ident":["as_slice",0]}]},{"key":{"Fun":1},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1},"kind":"InherentImplBlock"}}},{"Ident":["as_mut_slice",0]}]},{"key":{"Fun":2},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["repeat",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}}]},{"key":{"Fun":3},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}},{"