,"col":1}},"generated_from_span":null}},"source_text":"pub fn zero_pad(v: i64, n: usize) -> Vec<u8> {\n    let x: u64 = if v < 0 { 0 } else { v as u64 };\n    let mut p: u64 = 1;\n    let mut k: usize = 0;\n    while k < n {\n        p = p * 10;\n        k += 1;\n    }\n    let mut out: Vec<u8> = Vec::new();\n    let mut j: usize = 0;\n    while j < n {\n        p = p / 10;\n        let d = (x / p) % 10;\n        out.push(b'0' + (d as u8));\n        j += 1;\n    }\n    out\n}","attr_info":{"attributes":[{"DocComment":" The `n` low decimal digits of `v` (0 for a negative `v`), zero-padded, as Latin-1 bytes"},{"DocComment":" (`n <= 19`)."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10},{"Deduplicated":0}],"output":{"Deduplicated":13}},"src":"Normal","body":{"Structured":{"span":{"Value":[437,{"data":{"file_id":0,"beg":{"line":174,"col":0},"end":{"line":191,"col":1}},"generated_from_span":null}]},"bound_body_regions":6,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[438,{"data":{"file_id":0,"beg":{"line":174,"col":37},"end":{"line":174,"col":44}},"generated_from_span":null}]},"ty":{"Deduplicated":13},"drop_flag_for":null},{"index":1,"name":"v","span":{"Value":[439,{"data":{"file_id":0,"beg":{"line":174,"col":16},"end":{"line":174,"col":17}},"generated_from_span":null}]},"ty":{"Deduplicated":10},"drop_flag_for":null},{"index":2,"name":"n","span":{"Value":[440,{"data":{"file_id":0,"beg":{"line":174,"col":24},"end":{"line":174,"col":25}},"generated_from_span":null}]},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":3,"name":"x","span":{"Value":[441,{"data":{"file_id":0,"beg"