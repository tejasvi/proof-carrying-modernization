:{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"specloops","contents":"//! Loop shapes of the Headline A translations, for the Rust spec-proof kit: `for` ranges,\n//! counters, a COBOL read loop ended by a flag, and the library calls of display lines.\n\n#[derive(Clone, Copy)]\npub struct Rec {\n    pub tag: [u8; 4],\n    pub amount: i64,\n}\n\npub struct Output {\n    pub displays: Vec<Vec<u8>>,\n    pub abended: bool,\n}\n\n/// `for i in 0..s.len()`: a copy over a range.\npub fn copy_range(s: &[u8]) -> Vec<u8> {\n    let mut v: Vec<u8> = Vec::new();\n    for i in 0..s.len() {\n        v.push(s[i]);\n    }\n    v\n}\n\n/// `for _ in 0..n`: `n` spaces (a range up to a bound).\npub fn spaces(n: usize) -> Vec<u8> {\n    let mut v: Vec<u8> = Vec::new();\n    for _i in 0..n {\n        v.push(b' ');\n    }\n    v\n}\n\n/// `while j < digits && j < 18`: the first `digits` bytes of a buffer (a counter with two bounds).\npub fn take_digits(buf: &[u8; 18], digits: usize) -> Vec<u8> {\n    let mut out: Vec<u8> = Vec::new();\n    let mut j: usize = 0;\n    while j < digits && j < 18 {\n        out.push(buf[j]);\n        j += 1;\n    }\n    out\n}\n\n/// `to_vec` and `extend_from_slice`: a literal label, then a field.\npub fn labelled(b: &[u8; 4]) -> Vec<u8> {\n    let mut line = b\"ID: \".to_vec();\n    line.extend_from_slice(b);\n    line\n}\n\n/// A COBOL read loop ended by the end-of-file flag: a start line, the tag of each record, an end\n/// line; the status of each read decides, and an unexpected status abends.\npub fn listing(recs: &[Rec]) -> Output {\n    let mut displays: Vec<Vec<u8>> = Vec::new();\n    displays.push(b\"START\".to_vec());\n    let mut pos: usize = 0;\n    let mut at_eof = false;\n    let mut end_of_file = false;\n    while !end_of_file {\n        let status: [u8; 2];\n        let mut rec: Option<Rec> = None;\n        if at_eof {\n            status = *b\"46\";\n        } else if pos < recs.len() {\n            rec = Some(recs[pos]);\n            pos += 1;\n            status = *b\"00\";\n        } else {\n            at_eof = true;\n            status = *b\"10\";\n        }\n        if status == *b\"10\" {\n            end_of_file = true;\n        } else if status != *b\"00\" {\n            displays.push(b\"ERROR\".to_vec());\n            return Output {\n                displays,\n                abended: true,\n            };\n        }\n        if !end_of_file {\n            if let Some(r) = rec {\n                displays.push(r.tag.to_vec());\n            }\n        }\n    }\n    displays.push(b\"END\".to_vec());\n    Output {\n        displays,\n        abended: false,\n    }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},