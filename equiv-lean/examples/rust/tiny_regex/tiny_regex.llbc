  b'w' => {\n                            o.kind = ALPHA;\n                        }\n                        b'W' => {\n                            o.kind = NOT_ALPHA;\n                        }\n                        b's' => {\n                            o.kind = WHITESPACE;\n                        }\n                        b'S' => {\n                            o.kind = NOT_WHITESPACE;\n                        }\n                        _ => {\n                            o.kind = CHAR;\n                            o.ch = e;\n                        }\n                    }\n                }\n            }\n            b'[' => {\n                let buf_begin = bufidx;\n                if at(pattern, i + 1) == b'^' {\n                    o.kind = INV_CHAR_CLASS;\n                    i += 1;\n                    if at(pattern, i + 1) == 0 {\n                        return None;\n                    }\n                } else {\n                    o.kind = CHAR_CLASS;\n                }\n                match compile_class(pattern, i, bufidx, &mut re.ccl_buf) {\n                    None => return None,\n                    Some((i2, b2)) => {\n                        i = i2;\n                        bufidx = b2;\n                    }\n                }\n                o.ccl = buf_begin;\n            }\n            _ => {\n                o.kind = CHAR;\n                o.ch = c;\n            }\n        }\n        re.objs[j] = o;\n        if at(pattern, i) == 0 {\n            return None;\n        }\n        i += 1;\n        j += 1;\n    }\n    let mut o = re.objs[j];\n    o.kind = UNUSED;\n    re.objs[j] = o;\n    Some(re)\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"con