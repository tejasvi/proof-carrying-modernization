{"charon_version":"0.1.293","translated":{"crate_name":"tiny_regex","options":{"ullbc":false,"no_code_duplication":false,"precise_drops":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"eager_vtables":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"no_doc_comments":false,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"resugar_drops":false,"detect_drop_flags":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"no_gen_tuple_structs":true,"raw_consts":false,"inline_anon_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_panic_calls":true,"reconstruct_asserts":true,"reconstruct_matches":true,"deallocate_all_locals":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"print_layouts":false,"print_safety":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"run_with_minirust":false,"no_serialize":false,"skip_borrowck":false,"erase_body_lifetimes":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"no_compute_layout_guarantees":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true,"c_enum_smallest_repr_ty":"I32","primitive_alignments":[{"key":"Bool","value":1},{"key":{"Integer":{"Signed":"I8"}},"value":1},{"key":{"Integer":{"Signed":"I16"}},"value":2},{"key":{"Integer":{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"tiny_regex","contents":"pub const MAX_REGEXP_OBJECTS: usize = 30;\npub const MAX_CHAR_CLASS_LEN: usize = 40;\n\nconst UNUSED: u8 = 0;\nconst DOT: u8 = 1;\nconst BEGIN: u8 = 2;\nconst END: u8 = 3;\nconst QUESTIONMARK: u8 = 4;\nconst STAR: u8 = 5;\nconst PLUS: u8 = 6;\nconst CHAR: u8 = 7;\nconst CHAR_CLASS: u8 = 8;\nconst INV_CHAR_CLASS: u8 = 9;\nconst DIGIT: u8 = 10;\nconst NOT_DIGIT: u8 = 11;\nconst ALPHA: u8 = 12;\nconst NOT_ALPHA: u8 = 13;\nconst WHITESPACE: u8 = 14;\nconst NOT_WHITESPACE: u8 = 15;\n\n#[derive(Clone, Copy)]\npub struct RegexObj {\n    pub kind: u8,\n    pub ch: u8,\n    pub ccl: usize,\n}\n\n#[derive(Clone, Copy)]\npub struct Regex {\n    pub objs: [RegexObj; 30],\n    pub ccl_buf: [u8; 40],\n}\n\n/* ---------- byte accessors ---------- */\n\nfn at(s: &[u8], i: usize) -> u8 {\n    if i < s.len() {\n        s[i]\n    } else {\n        0\n    }\n}\n\nfn obj(re: &Regex, i: usize) -> RegexObj {\n    if i < MAX_REGEXP_OBJECTS {\n        re.objs[i]\n    } else {\n        RegexObj { kind: UNUSED, ch: 0, ccl: 0 }\n    }\n}\n\nfn cb(re: &Regex, k: usize) -> u8 {\n    if k < MAX_CHAR_CLASS_LEN {\n        re.ccl_buf[k]\n    } else {\n        0\n    }\n}\n\n/* ---------- ctype (glibc, \"C\" locale, signed char) ---------- */\n\nfn isdigit(c: u8) -> bool {\n    c >= b'0' && c <= b'9'\n}\n\nfn isalpha(c: u8) -> bool {\n    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z')\n}\n\nfn isspace(c: u8) -> bool {\n    c == b' ' || (c >= 9 && c <= 13)\n}\n\nfn matchalphanum(c: u8) -> bool {\n    c == b'_' || isalpha(c) || isdigit(c)\n}\n\nfn ismetachar(c: u8) -> bool {\n    c == b's' || c == b'S' || c == b'w' || c == b'W' || c == b'd' || c == b'D'\n}\n\nfn matchmetachar(c: u8, s: u8) -> bool {\n    match s {\n        b'd' => isdigit(c),\n        b'D' => !isdigit(c),\n        b'w' => matchalphanum(c),\n        b'W' => !matchalphanum(c),\n        b's' => isspace(c),\n        b'S' => !isspace(c),\n        _ => c == s,\n    }\n}\n\nfn matchrange(re: &Regex, c: u8, k: usize) -> bool {\n    if c == b'-' {\n        return false;\n    }\n    if k >= MAX_CHAR_CLASS_LEN {\n        // str[0] would be 0\n        return false;\n    }\n    let s0 = re.ccl_buf[k];\n    if s0 == 0 || s0 == b'-' {\n        return false;\n    }\n    let s1 = cb(re, k + 1);\n    if s1 != b'-' {\n        return false;\n    }\n    let s2 = cb(re, k + 2);\n    if s2 == 0 {\n        return false;\n    }\n    (c as i8) >= (s0 as i8) && (c as i8) <= (s2 as i8)\n}\n\nfn matchcharclass(re: &Regex, c: u8, start: usize) -> bool {\n    let mut k = start;\n    loop {\n        if k >= MAX_CHAR_CLASS_LEN {\n            // str[0] reads as 0 here; c is never 0, so no branch matches and the loop ends.\n            return false;\n        }\n        let s0 = re.ccl_buf[k];\n        if matchrange(re, c, k) {\n            return true;\n        } else if s0 == b'\\\\' {\n            k += 1;\n            let s = cb(re, k);\n            if matchmetachar(c, s) {\n                return true;\n            } else if c == s && !ismetachar(c) {\n                return true;\n            }\n        } else if c == s0 {\n            if c == b'-' {\n                let prev = if k == 0 { 0 } else { re.ccl_buf[k - 1] };\n                let next = cb(re, k + 1);\n                return prev == 0 || next == 0;\n            } else {\n                return true;\n            }\n        }\n        let x = cb(re, k);\n        if x == 0 {\n            return false;\n        }\n        k += 1;\n    }\n}\n\nfn matchone(re: &Regex, p: RegexObj, c: u8) -> bool {\n    let k = p.kind;\n    if k == DOT {\n        true\n    } else if k == CHAR_CLASS {\n        matchcharclass(re, c, p.ccl)\n    } else if k == INV_CHAR_CLASS {\n        !matchcharclass(re, c, p.ccl)\n    } else if k == DIGIT {\n        isdigit(c)\n    } else if k == NOT_DIGIT {\n        !isdigit(c)\n    } else if k == ALPHA {\n        matchalphanum(c)\n    } else if k == NOT_ALPHA {\n        !matchalphanum(c)\n    } else if k == WHITESPACE {\n        isspace(c)\n    } else if k == NOT_WHITESPACE {\n        !isspace(c)\n    } else {\n        // unsigned char u.ch compared with a signed char\n        (p.ch as i32) == ((c as i8) as i32)\n    }\n}\n\n/* forward scan of matchstar / matchplus (not in the recursion group) */\nfn scan_fwd(re: &Regex, p: RegexObj, text: &[u8], ti: usize, ml: i32) -> (usize, i32) {\n    let mut t = ti;\n    let mut m = ml;\n    while t < text.len() && at(text, t) != 0 && matchone(re, p, at(text, t)) {\n        t += 1;\n        m = m.wrapping_add(1);\n    }\n    (t, m)\n}\n\n/* ---------- recursion group (no loops) ---------- */\n\nfn matchpattern(re: &Regex, pi: usize, text: &[u8], ti: usize, ml: i32) -> (bool, i32) {\n    matchpattern_loop(re, pi, text, ti, ml, ml)\n}\n\nfn matchpattern_loop(\n    re: &Regex,\n    pi: usize,\n    text: &[u8],\n    ti: usize,\n    ml: i32,\n    pre: i32,\n) -> (bool, i32) {\n    let p0 = obj(re, pi);\n    let p1 = obj(re, pi + 1);\n    if p0.kind == UNUSED || p1.kind == QUESTIONMARK {\n        return matchquestion(re, p0, pi + 2, text, ti, ml);\n    }\n    if p1.kind == STAR {\n        return matchstar(re, p0, pi + 2, text, ti, ml);\n    }\n    if p1.kind == PLUS {\n        return matchplus(re, p0, pi + 2, text, ti, ml);\n    }\n    if p0.kind == END && p1.kind == UNUSED {\n        return (at(text, ti) == 0, ml);\n    }\n    let ml2 = ml.wrapping_add(1);\n    let c = at(text, ti);\n    if c != 0 && matchone(re, p0, c) {\n        matchpattern_loop(re, pi + 1, text, ti + 1, ml2, pre)\n    } else {\n        (false, pre)\n    }\n}\n\nfn matchquestion(\n    re: &Regex,\n    p: RegexObj,\n    pi: usize,\n    text: &[u8],\n    ti: usize,\n    ml: i32,\n) -> (bool, i32) {\n    if p.kind == UNUSED {\n        return (true, ml);\n    }\n    let (r, ml1) = matchpattern(re, pi, text, ti, ml);\n    if r {\n        return (true, ml1);\n    }\n    let c = at(text, ti);\n    if c != 0 && matchone(re, p, c) {\n        let (r2, ml2) = matchpattern(re, pi, text, ti + 1, ml1);\n        if r2 {\n            return (true, ml2.wrapping_add(1));\n        }\n        return (false, ml2);\n    }\n    (false, ml1)\n}\n\nfn matchstar(\n    re: &Regex,\n    p: RegexObj,\n    pi: usize,\n    text: &[u8],\n    ti: usize,\n    ml: i32,\n) -> (bool, i32) {\n    let prelen = ml;\n    let (t, ml1) = scan_fwd(re, p, text, ti, ml);\n    star_back(re, pi, text, t as isize, ti as isize, ml1, prelen)\n}\n\nfn star_back(\n    re: &Regex,\n    pi: usize,\n    text: &[u8],\n    t: isize,\n    pre: isize,\n    ml: i32,\n    prelen: i32,\n) -> (bool, i32) {\n    if t < pre || t < 0 {\n        return (false, prelen);\n    }\n    let (r, ml1) = matchpattern(re, pi, text, t as usize, ml);\n    if r {\n        return (true, ml1);\n    }\n    star_back(re, pi, text, t - 1, pre, ml1.wrapping_sub(1), prelen)\n}\n\nfn matchplus(\n    re: &Regex,\n    p: RegexObj,\n    pi: usize,\n    text: &[u8],\n    ti: usize,\n    ml: i32,\n) -> (bool, i32) {\n    let (t, ml1) = scan_fwd(re, p, text, ti, ml);\n    plus_back(re, pi, text, t, ti, ml1)\n}\n\nfn plus_back(\n    re: &Regex,\n    pi: usize,\n    text: &[u8],\n    t: usize,\n    pre: usize,\n    ml: i32,\n) -> (bool, i32) {\n    if t <= pre {\n        return (false, ml);\n    }\n    let (r, ml1) = matchpattern(re, pi, text, t, ml);\n    if r {\n        return (true, ml1);\n    }\n    plus_back(re, pi, text, t - 1, pre, ml1.wrapping_sub(1))\n}\n\n/* ---------- public API ---------- */\n\npub fn re_match(pattern: &[u8], text: &[u8]) -> (i32, i32) {\n    let r = re_compile(pattern);\n    match &r {\n        Some(x) => re_matchp(Some(x), text),\n        None => re_matchp(None, text),\n    }\n}\n\npub fn re_matchp(pattern: Option<&Regex>, text: &[u8]) -> (i32, i32) {\n    match pattern {\n        None => (-1, 0),\n        Some(re) => {\n            if obj(re, 0).kind == BEGIN {\n                let (r, ml) = matchpattern(re, 1, text, 0, 0);\n                return (if r { 0 } else { -1 }, ml);\n            }\n            let mut idx: i32 = -1;\n            let mut ti: usize = 0;\n            let mut ml: i32 = 0;\n            loop {\n                idx = idx.wrapping_add(1);\n                let (r, ml1) = matchpattern(re, 0, text, ti, ml);\n                ml = ml1;\n                if r {\n                    if at(text, ti) == 0 {\n                        return (-1, ml);\n                    }\n                    return (idx, ml);\n                }\n                if at(text, ti) == 0 {\n                    break;\n                }\n                if ti >= text.len() {\n                    break;\n                }\n                ti += 1;\n            }\n            (-1, ml)\n        }\n    }\n}\n\n/* copies the characters inside [..]; None = C's `return 0` */\nfn compile_class(\n    pattern: &[u8],\n    i0: usize,\n    b0: usize,\n    buf: &mut [u8; MAX_CHAR_CLASS_LEN],\n) -> Option<(usize, usize)> {\n    let mut i = i0;\n    let mut b = b0;\n    loop {\n        if i >= pattern.len() {\n            // pattern[++i] would be past the NUL; C never gets here (the NUL stops the scan)\n            break;\n        }\n        i += 1;\n        let pc = at(pattern, i);\n        if pc == b']' || pc == 0 {\n            break;\n        }\n        if pc == b'\\\\' {\n            if b >= MAX_CHAR_CLASS_LEN - 1 {\n                return None;\n            }\n            if at(pattern, i + 1) == 0 {\n                return None;\n            }\n            buf[b] = pc;\n            b += 1;\n            i += 1;\n        } else if b >= MAX_CHAR_CLASS_LEN {\n            return None;\n        }\n        buf[b] = at(pattern, i);\n        b += 1;\n    }\n    if b >= MAX_CHAR_CLASS_LEN {\n        return None;\n    }\n    buf[b] = 0;\n    b += 1;\n    Some((i, b))\n}\n\npub fn re_compile(pattern: &[u8]) -> Option<Regex> {\n    let mut re = Regex {\n        objs: [RegexObj { kind: 0, ch: 0, ccl: 0 }; MAX_REGEXP_OBJECTS],\n        ccl_buf: [0u8; MAX_CHAR_CLASS_LEN],\n    };\n    let mut bufidx: usize = 1;\n    let mut i: usize = 0;\n    let mut j: usize = 0;\n\n    while i < pattern.len() && at(pattern, i) != 0 && j + 1 < MAX_REGEXP_OBJECTS {\n        let c = at(pattern, i);\n        let mut o = re.objs[j];\n        match c {\n            b'^' => {\n                o.kind = BEGIN;\n            }\n            b'$' => {\n                o.kind = END;\n            }\n            b'.' => {\n                o.kind = DOT;\n            }\n            b'*' => {\n                o.kind = STAR;\n            }\n            b'+' => {\n                o.kind = PLUS;\n            }\n            b'?' => {\n                o.kind = QUESTIONMARK;\n            }\n            b'\\\\' => {\n                if at(pattern, i + 1) != 0 {\n                    i += 1;\n                    let e = at(pattern, i);\n                    match e {\n                        b'd' => {\n                            o.kind = DIGIT;\n                        }\n                        b'D' => {\n                            o.kind = NOT_DIGIT;\n                        }\n                        b'w' => {\n                            o.kind = ALPHA;\n                        }\n                        b'W' => {\n                            o.kind = NOT_ALPHA;\n                        }\n                        b's' => {\n                            o.kind = WHITESPACE;\n                        }\n                        b'S' => {\n                            o.kind = NOT_WHITESPACE;\n                        }\n                        _ => {\n                            o.kind = CHAR;\n                            o.ch = e;\n                        }\n                    }\n                }\n            }\n            b'[' => {\n                let buf_begin = bufidx;\n                if at(pattern, i + 1) == b'^' {\n                    o.kind = INV_CHAR_CLASS;\n                    i += 1;\n                    if at(pattern, i + 1) == 0 {\n                        return None;\n                    }\n                } else {\n                    o.kind = CHAR_CLASS;\n                }\n                match compile_class(pattern, i, bufidx, &mut re.ccl_buf) {\n                    None => return None,\n                    Some((i2, b2)) => {\n                        i = i2;\n                        bufidx = b2;\n                    }\n                }\n                o.ccl = buf_begin;\n            }\n            _ => {\n                o.kind = CHAR;\n                o.ch = c;\n            }\n        }\n        re.objs[j] = o;\n        if at(pattern, i) == 0 {\n            return None;\n        }\n        i += 1;\n        j += 1;\n    }\n    let mut o = re.objs[j];\n    o.kind = UNUSED;\n    re.objs[j] = o;\n    Some(re)\n}"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"crate_name":"core","contents":null},{"id":5,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":6,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":7,"name":{"Local":"/rustc/library/core/src/ops/index.rs"},"crate_name":"core","contents":null},{"id":8,"name":{"Local":"/rustc/library/core/src/ops/range.rs"},"crate_name":"core","contents":null},{"id":9,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":10,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":11,"name":{"Local":"/rustc/library/core/src/num/int_macros.rs"},"crate_name":"core","contents":null},{"id":12,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null}],"item_names":[{"key":{"Type":0},"value":[{"Builtin":[{"Tuple":0},0]}]},{"key":{"Fun":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Value":[0,{"Scalar":{"Integer":{"Unsigned":"Usize"}}}]}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Value":[1,{"Array":[{"Value":[2,{"TypeVar":{"Bound":[0,0]}}]},{"Value":[0,[{"Var":{"Bound":[0,0]}},{"Deduplicated":0}]]},null]}]},"kind":"InherentImplBlock"}}},{"Ident":["as_slice",0]}]},{"key":{"Fun":1},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":0}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1},"kind":"InherentImplBlock"}}},{"Ident":["as_mut_slice",0]}]},{"key":{"Fun":2},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Ident":["repeat",0]}]},{"key":{"TraitImpl":0},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}}]},{"key":{"Fun":3},"value":[{"Ident":["core",0]},{"Ident":["array",0]},{"Impl":{"Trait":0}},{"Ident":["index",0]}]},{"key":{"Tr