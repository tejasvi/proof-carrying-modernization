nteger":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"runtime_checks":{"ub_checks":true,"overflow_checks":true,"contract_checks":false},"files":[{"id":0,"name":{"Local":"src/lib.rs"},"crate_name":"vecpr","contents":"//! `Vec` versions of a PR: building a vector and summing it.\n\npub mod v1 {\n    /// The squares `0, 1, 4, …, (n-1)^2`.\n    pub fn squares(n: u32) -> Vec<u64> {\n        let mut out = Vec::new();\n        let mut i: u32 = 0;\n        while i < n {\n            out.push((i as u64) * (i as u64));\n            i += 1;\n        }\n        out\n    }\n\n    /// Sum of a vector, panics on overflow.\n    pub fn sum(v: &Vec<u64>) -> u64 {\n        let mut s: u64 = 0;\n        let mut i: usize = 0;\n        while i < v.len() {\n            s = s + v[i];\n            i += 1;\n        }\n        s\n    }\n}\n\npub mod v2 {\n    /// PR: preallocate, and compute the square by repeated addition (i^2 = (i-1)^2 + 2i - 1).\n    pub fn squares(n: u32) -> Vec<u64> {\n        let mut out = Vec::with_capacity(n as usize);\n        let mut i: u32 = 0;\n        let mut sq: u64 = 0;\n        while i < n {\n            out.push(sq);\n            sq = sq + 2 * (i as u64) + 1;\n            i += 1;\n        }\n        out\n    }\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"