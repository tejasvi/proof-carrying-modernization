/-
Proofs of the JSDoc contracts of `examples/Specs/specs.ts` (statements generated by
`tools/jsdoc_specs.js` into `SpecsExSpecs.lean`). The number facts come from
`StrictTS.Proof.F64Order`: `result.length === xs.length` needs `ofNat n` not to be NaN, and
`clampChecked` needs the order of non-NaN doubles (`¬(x < lo)` gives `lo <= x`).
-/
import Specs.SpecsExSpecs
import StrictTS.Proof.Summarize
import StrictTS.Proof.F64Order

open StrictTS JS SpecsEx

/-- `@ensures result !== xs` (a fresh array) holds for `doubleAll` on every live array. -/
theorem doubleAll_spec_holds : doubleAll_spec := by
  intro I vs w hlive hfresh _ r w' hrun
  match vs, hlive with
  | .cons (.arr a) .nil, hlive =>
    have hc : w.heap.contains (.arr .num, a) = true := hlive.1
    rw [Std.ExtDHashMap.contains_eq_isSome_get?] at hc
    obtain ⟨xs, hxs⟩ := Option.isSome_iff_exists.mp hc
    have ha : a ≠ w.next := by
      intro h
      have := hfresh (.arr .num) a (by omega)
      rw [hxs] at this
      cases this
    have hrun' : exec (callFun I program doubleAllRef (.cons (.arr a) .nil)) w =
        some (.ok (.arr w.next), { w with
          heap := w.heap.insert (.arr .num, w.next) (xs.map (fun x => .num (x.toNum * 2))),
          next := w.next + 1 }) := by
      rw [doubleAll_call]
      simp only [doubleAllDef, ts_sym]
      ts_callbacks
      simp [ts_sym]
    rw [hrun'] at hrun
    simp only [Option.some.injEq, Prod.mk.injEq] at hrun
    obtain ⟨rfl, rfl⟩ := hrun
    refine ⟨_, rfl, ?_⟩
    rw [doubleAll__ensures_call]
    simp (disch := first | decide | omega) [doubleAll__ensuresDef, ts_sym, Ne.symm ha]

/-- `@ensures result.length === xs.length` holds for `doubleAllLen` on every live array. -/
theorem doubleAllLen_spec_holds : doubleAllLen_spec := by
  intro I vs w hlive hfresh _ r w' hrun
  match vs, hlive with
  | .cons (.arr a) .nil, hlive =>
    have hc : w.heap.contains (.arr .num, a) = true := hlive.1
    rw [Std.ExtDHashMap.contains_eq_isSome_get?] at hc
    obtain ⟨xs, hxs⟩ := Option.isSome_iff_exists.mp hc
    have ha : a ≠ w.next := by
      intro h
      have := hfresh (.arr .num) a (by omega)
      rw [hxs] at this
      cases this
    have hrun' : exec (callFun I program doubleAllLenRef (.cons (.arr a) .nil)) w =
        some (.ok (.arr w.next), { w with
          heap := w.heap.insert (.arr .num, w.next) (xs.map (fun x => .num (x.toNum * 2))),
          next := w.next + 1 }) := by
      rw [doubleAllLen_call]
      simp only [doubleAllLenDef, ts_sym]
      ts_callbacks
      simp [ts_sym]
    rw [hrun'] at hrun
    simp only [Option.some.injEq, Prod.mk.injEq] at hrun
    obtain ⟨rfl, rfl⟩ := hrun
    refine ⟨_, rfl, ?_⟩
    rw [doubleAllLen__ensures_call]
    -- both lengths are `xs.size`; `Conv.numEq (ofNat n) (ofNat n)` is `true` (`numEq_ofNat_self`)
    simp (disch := first | decide | omega) [doubleAllLen__ensuresDef, ts_sym, hxs]

/-- `@requires lo <= hi && x === x` / `@ensures lo <= result && result <= hi` holds for
`clampChecked`: the precondition makes `x`, `lo`, `hi` non-NaN, and on non-NaN doubles
`¬(x < lo)` gives `lo <= x` and `¬(hi < x)` gives `x <= hi`. -/
theorem clampChecked_spec_holds : clampChecked_spec := by
  intro I vs w _ _ hreq r w' hrun
  match vs with
  | .cons (.num x) (.cons (.num lo) (.cons (.num hi) .nil)) =>
    rw [clampChecked__requires_call] at hreq
    cases hlh : lo.le hi <;> simp [clampChecked__requiresDef, ts_sym, F64.gt_eq_lt, F64.ge_eq_le, hlh] at hreq
    obtain ⟨hlo, hhi⟩ := F64.ne_nan_of_le hlh
    rw [clampChecked_call] at hrun
    cases h1 : x.lt lo
    · cases h2 : hi.lt x
      · -- `lo <= x <= hi`: the result is `x`
        simp [clampCheckedDef, ts_sym, F64.gt_eq_lt, F64.ge_eq_le, h1, h2] at hrun
        obtain ⟨rfl, rfl⟩ := hrun
        refine ⟨_, rfl, ?_⟩
        rw [clampChecked__ensures_call]
        simp [clampChecked__ensuresDef, ts_sym, F64.gt_eq_lt, F64.ge_eq_le, F64.le_of_not_lt hreq hlo h1,
          F64.le_of_not_lt hhi hreq h2]
      · -- `hi < x`: the result is `hi`
        simp [clampCheckedDef, ts_sym, F64.gt_eq_lt, F64.ge_eq_le, h1, h2] at hrun
        obtain ⟨rfl, rfl⟩ := hrun
        refine ⟨_, rfl, ?_⟩
        rw [clampChecked__ensures_call]
        simp [clampChecked__ensuresDef, ts_sym, F64.gt_eq_lt, F64.ge_eq_le, hlh, F64.le_refl_of_ne_nan hhi]
    · -- `x < lo`: the result is `lo`
      simp [clampCheckedDef, ts_sym, F64.gt_eq_lt, F64.ge_eq_le, h1] at hrun
      obtain ⟨rfl, rfl⟩ := hrun
      refine ⟨_, rfl, ?_⟩
      rw [clampChecked__ensures_call]
      simp [clampChecked__ensuresDef, ts_sym, F64.gt_eq_lt, F64.ge_eq_le, hlh, F64.le_refl_of_ne_nan hlo]
